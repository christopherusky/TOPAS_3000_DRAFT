{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/traffic_event/traffic_event_roadworks-v1.0.json",
  "$ref": "#/$defs/RoadworksEvent",
  "$defs": {
    "RoadworksEvent": {
      "additionalProperties": false,
      "dependentRequired": {
        "externalSituationVersion": [
          "externalSituationId"
        ]
      },
      "description": "Roadworks traffic event payload.",
      "properties": {
        "eventId": {
          "description": "Unique identifier of this event.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "ObjectId",
          "type": "string"
        },
        "roadworksType": {
          "$ref": "#/$defs/RoadworksType",
          "description": "Classification of the roadworks."
        },
        "status": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/EventStatus"
        },
        "publicDescription": {
          "type": "string",
          "description": "Public-facing summary for journey planners."
        },
        "locationDescription": {
          "type": "string",
          "description": "Free-text location description."
        },
        "location": {
          "$ref": "../common/common-v1.0.json#/$defs/Point",
          "description": "WGS84 point location."
        },
        "severity": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/SeverityType",
          "description": "Event severity."
        },
        "phase": {
          "type": "string",
          "description": "Event phase (unconstrained)."
        },
        "lanesAffected": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/LanesAffectedType",
          "description": "Lane closure pattern."
        },
        "lanesRestricted": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of closed/restricted lanes."
        },
        "lanesOperational": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of operational lanes."
        },
        "diversionRoute": {
          "type": "string",
          "description": "Diversion route description."
        },
        "diversionInForce": {
          "type": "boolean",
          "description": "Whether diversion is active."
        },
        "reportedBy": {
          "type": "string",
          "description": "Who reported the event."
        },
        "confirmedBy": {
          "type": "string",
          "description": "Who confirmed."
        },
        "modifiedBy": {
          "type": "string",
          "description": "Who last modified."
        },
        "plannedStart": {
          "type": "string",
          "format": "date-time",
          "description": "Planned start time."
        },
        "plannedEnd": {
          "type": "string",
          "format": "date-time",
          "description": "Planned end time."
        },
        "actualStart": {
          "type": "string",
          "format": "date-time",
          "description": "Actual start time."
        },
        "actualEnd": {
          "type": "string",
          "format": "date-time",
          "description": "Actual end time."
        },
        "contractor": {
          "type": "string",
          "description": "Contractor name."
        },
        "trafficSignals": {
          "type": "boolean",
          "description": "Whether temporary traffic signals are in use."
        },
        "contraflow": {
          "type": "boolean",
          "description": "Whether contraflow is in operation."
        },
        "confirmedDate": {
          "type": "string",
          "format": "date-time",
          "description": "When the roadworks were confirmed."
        },
        "externalCountryCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Cross-ref country code (an XML NMTOKEN: no whitespace)."
        },
        "externalSystemCode": {
          "type": "string",
          "description": "Cross-ref system code."
        },
        "externalSituationId": {
          "type": "string",
          "description": "Cross-ref situation identifier."
        },
        "externalSituationVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Cross-ref situation version. Requires external_situation_id."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions."
        }
      },
      "required": [
        "eventId",
        "roadworksType",
        "status"
      ],
      "type": "object",
      "title": "UTMC Traffic Event Roadworks"
    },
    "RoadworksType": {
      "description": "Classification of roadworks (7 values from XSD).",
      "enum": [
        "centralReservation",
        "general",
        "overhead",
        "surface",
        "verge",
        "waterMainWork",
        "other"
      ],
      "type": "string"
    }
  }
}
