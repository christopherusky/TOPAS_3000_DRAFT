{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/traffic_event/traffic_event_event-v1.0.json",
  "$ref": "#/$defs/PlannedEvent",
  "$defs": {
    "PlannedEvent": {
      "additionalProperties": false,
      "dependentRequired": {
        "externalSituationVersion": [
          "externalSituationId"
        ]
      },
      "description": "Planned event traffic event payload.",
      "properties": {
        "eventId": {
          "description": "Unique identifier of this event.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "ObjectId",
          "type": "string"
        },
        "plannedEventType": {
          "$ref": "#/$defs/PlannedEventType",
          "description": "Classification of the event."
        },
        "status": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/EventStatus"
        },
        "publicDescription": {
          "type": "string",
          "description": "Public-facing summary for journey planners."
        },
        "locationDescription": {
          "type": "string",
          "description": "Free-text location description."
        },
        "location": {
          "$ref": "../common/common-v1.0.json#/$defs/Point",
          "description": "WGS84 point location."
        },
        "severity": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/SeverityType",
          "description": "Event severity."
        },
        "phase": {
          "type": "string",
          "description": "Event phase (unconstrained)."
        },
        "lanesAffected": {
          "$ref": "traffic_event_common-v1.0.json#/$defs/LanesAffectedType",
          "description": "Lane closure pattern."
        },
        "lanesRestricted": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of closed/restricted lanes."
        },
        "lanesOperational": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of operational lanes."
        },
        "diversionRoute": {
          "type": "string",
          "description": "Diversion route description."
        },
        "diversionInForce": {
          "type": "boolean",
          "description": "Whether diversion is active."
        },
        "reportedBy": {
          "type": "string",
          "description": "Who reported the event."
        },
        "confirmedBy": {
          "type": "string",
          "description": "Who confirmed."
        },
        "modifiedBy": {
          "type": "string",
          "description": "Who last modified."
        },
        "plannedStart": {
          "type": "string",
          "format": "date-time",
          "description": "Planned start time."
        },
        "plannedEnd": {
          "type": "string",
          "format": "date-time",
          "description": "Planned end time."
        },
        "actualStart": {
          "type": "string",
          "format": "date-time",
          "description": "Actual start time."
        },
        "actualEnd": {
          "type": "string",
          "format": "date-time",
          "description": "Actual end time."
        },
        "organiser": {
          "type": "string",
          "description": "Event organiser."
        },
        "venueName": {
          "type": "string",
          "description": "Venue name."
        },
        "externalCountryCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Cross-ref country code (an XML NMTOKEN: no whitespace)."
        },
        "externalSystemCode": {
          "type": "string",
          "description": "Cross-ref system code."
        },
        "externalSituationId": {
          "type": "string",
          "description": "Cross-ref situation identifier."
        },
        "externalSituationVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Cross-ref situation version. Requires external_situation_id."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions."
        }
      },
      "required": [
        "eventId",
        "plannedEventType",
        "status"
      ],
      "type": "object",
      "title": "UTMC Traffic Event Planned Event"
    },
    "PlannedEventType": {
      "description": "Classification of planned event (32 values from the UTMC specification).\n\nThe XSD carries only a catalogue reference, so the value set is not in it.",
      "enum": [
        "ballGame",
        "boxing",
        "athletics",
        "cycleRace",
        "demonstration",
        "exhibition",
        "fair",
        "festival",
        "football",
        "funfair",
        "golf",
        "internationalSports",
        "marathon",
        "march",
        "market",
        "match",
        "parade",
        "procession",
        "race",
        "rugby",
        "show",
        "showJumping",
        "sportsEvent",
        "sportsMeeting",
        "stateOccasion",
        "strike",
        "tennis",
        "tournament",
        "tradeFair",
        "waterSports",
        "winterSports",
        "other"
      ],
      "type": "string"
    }
  }
}
