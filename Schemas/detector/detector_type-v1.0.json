{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/detector/detector_type-v1.0.json",
  "$ref": "#/$defs/DetectorType",
  "$defs": {
    "DetectorType": {
      "additionalProperties": false,
      "description": "Detector type definitions.",
      "properties": {
        "typeId": {
          "description": "Identifier of this detector type.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "title": "TypeId",
          "type": "string"
        },
        "description": {
          "description": "Human-readable description of the detector kind.",
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes, e.g. deployment details."
        },
        "specificationLink": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "description": "URL to an external specification document for this detector type."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions. Open-content object."
        }
      },
      "required": [
        "typeId",
        "description"
      ],
      "type": "object",
      "title": "UTMC Detector Type"
    }
  }
}
