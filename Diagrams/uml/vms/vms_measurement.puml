@startuml
title UTMC VMS Measurement
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class VmsDynamic {
  +vmsId: ObjectId
  +timestamp: datetime
   quality: Quality
   currentMessage: string
   messageLines: list<string>
   graphicUrl: uri
   brightnessPercent: number
   messageSetTime: datetime
   messageExpiryTime: datetime
   status: VmsStatus
   extensions: object
}

enum VmsStatus {
  off
  on
  blank
  displaying
  fault
  unknown
}

class Quality <<../common/common>> #EEEEEE

VmsDynamic ..> Quality : quality
VmsDynamic --> VmsStatus : status

@enduml
