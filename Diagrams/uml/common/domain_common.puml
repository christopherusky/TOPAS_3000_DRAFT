@startuml
title UTMC Common Domain
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 4961*3508

' ── common ──
class Coordinates {
  +latitude: number
  +longitude: number
}

class DateTypeDefinition {
  +dayTypeId: integer
  +date: date
  +abnormal: boolean
   reason: string
   extensions: object
}

class DayTypeDefinition {
  +dayTypeId: integer
  +description: string
   shortName: string
   preDefined: boolean
   extensions: object
}

class GeoJsonLineString {
   type: "LineString"
  +coordinates: list<array>
}

class GeoJsonPoint {
   type: "Point"
  +coordinates: list<any>
}

class Point {
  +coordinates: Coordinates
   altitudeMeters: number
}

class Quality {
  +qualityId: QualityId
  +sourceName: string
   sourceType: string
   participantId: ParticipantId
   lastUpdated: datetime
   extensions: object
}

class SubsystemDefinition {
  +typeId: TypeId
  +description: string
   notes: string
   specificationLink: uri
   extensions: object
}

enum CommandResponseStatus {
  success
  failed
  timedOut
  invalid
  notSupported
  pending
}

Point --> Coordinates : coordinates

@enduml
