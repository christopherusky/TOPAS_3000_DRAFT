@startuml
title UTMC Detector Command
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class CalibrateDetectorCommand {
  +detectorId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "calibrate"
   extensions: object
}

class ResetDetectorCommand {
  +detectorId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "reset"
   extensions: object
}

class SetThresholdDetectorCommand {
  +detectorId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "setThreshold"
  +thresholdUp: integer
  +thresholdDown: integer
   extensions: object
}

class DetectorCommand <<union>> {
  discriminator: kind
}

DetectorCommand <|-- ResetDetectorCommand
DetectorCommand <|-- CalibrateDetectorCommand
DetectorCommand <|-- SetThresholdDetectorCommand

@enduml
