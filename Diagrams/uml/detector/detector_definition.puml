@startuml
title UTMC Detector Definition
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class DetectorDefinition {
  +detectorId: ObjectId
  +typeId: TypeId
  +creationDate: datetime
   location: Point
   transportLinkId: ObjectId
   linkDistanceMetres: number
   networkLinkId: ObjectId
   networkPathId: ObjectId
   shortDescription: string
   longDescription: string
   participantId: ParticipantId
   originatingParticipantId: ParticipantId
   originatingObjectId: ObjectId
   extensions: object
}

class Point <<../common/common>> #EEEEEE

DetectorDefinition ..> Point : location

@enduml
