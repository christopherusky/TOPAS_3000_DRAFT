@startuml
title UTMC Strategy Domain
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 4961*3508

' ── strategy_command ──
class StrategyTrigger {
  +strategyId: string
  +commandCorrelationId: integer
  +requestTime: datetime
   serviceRequester: string
  +triggerState: TriggerStateEnum
   extensions: object
}

enum TriggerStateEnum {
  enabled
  disabled
}

' ── strategy_command_response ──
class StrategyCommandResponse {
  +strategyId: string
  +commandCorrelationId: integer
   serviceRequester: string
  +status: CommandResponseStatus
  +responseTime: datetime
   code: string
   errorCode: TriggerUpdateErrorEnum
   message: string
   extensions: object
}

enum TriggerUpdateErrorEnum {
  accessDenied
  notAuthenticated
  strategyIdDoesNotExist
  other
}

' ── strategy_definition ──
class StrategyDefinition {
  +strategyId: string
  +strategyName: string
   strategyDescription: string
   location: GeoJsonPoint
   extensions: object
}

' ── strategy_status ──
class StrategyStatus {
  +strategyId: string
  +strategyStatus: StrategyStatusEnum
   statusMessage: string
   errorMessage: string
  +strategyChangeStateTime: datetime
   extensions: object
}

enum StrategyStatusEnum {
  active
  inactive
}

' ── strategy_sync_complete ──
class SyncComplete {
  +syncCorrelationId: integer
   syncId: string
  +status: SyncStatus
  +objectCount: integer
  +completedTime: datetime
   message: string
   extensions: object
}

enum SyncStatus {
  success
  rejected
  failed
}

' ── strategy_sync_request ──
class SyncRequest {
  +syncCorrelationId: integer
  +requestTime: datetime
   categories: list<SyncCategoryEnum>
   objectIds: list<ObjectId>
   subArea: string
   typeId: TypeId
   activeOnly: boolean
   since: datetime
   extensions: object
}

enum SyncCategoryEnum {
  definition
  configuration
  measurement
  fault
  type
  status
}

' ── External types ──
class CommandResponseStatus <<../common/common>> #EEEEEE
class GeoJsonPoint <<../common/common>> #EEEEEE

StrategyTrigger --> TriggerStateEnum : triggerState
StrategyCommandResponse ..> CommandResponseStatus : status
StrategyCommandResponse --> TriggerUpdateErrorEnum : errorCode
StrategyDefinition ..> GeoJsonPoint : location
StrategyStatus --> StrategyStatusEnum : strategyStatus
SyncComplete --> SyncStatus : status
SyncRequest --> SyncCategoryEnum : categories

@enduml
