@startuml
title UTMC Transport Link Configuration
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class TransportLinkANPRConfiguration {
  +transportLinkId: ObjectId
  +configurationDate: datetime
   lengthMetres: number
   fullLengthMetres: number
   numberOfLanes: integer
   maximumSpeedKph: number
   capacityVehiclesPerHour: number
   extensions: object
  +kind: "anpr"
}

class TransportLinkGPSConfiguration {
  +transportLinkId: ObjectId
  +configurationDate: datetime
   lengthMetres: number
   fullLengthMetres: number
   numberOfLanes: integer
   maximumSpeedKph: number
   capacityVehiclesPerHour: number
   extensions: object
  +kind: "gps"
}

class TransportLinkSCOOTConfiguration {
  +transportLinkId: ObjectId
  +configurationDate: datetime
   lengthMetres: number
   fullLengthMetres: number
   numberOfLanes: integer
   maximumSpeedKph: number
   capacityVehiclesPerHour: number
   extensions: object
  +kind: "scoot"
}

class TransportLinkConfiguration <<union>> {
  discriminator: kind
}

TransportLinkConfiguration <|-- TransportLinkSCOOTConfiguration
TransportLinkConfiguration <|-- TransportLinkGPSConfiguration
TransportLinkConfiguration <|-- TransportLinkANPRConfiguration

@enduml
