@startuml
title UTMC Transport Link Type
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class LinkStatusType {
  +kind: "linkStatus"
  +typeId: TypeId
  +description: string
   notes: string
   extensions: object
}

class TransportLinkType {
  +kind: "transportLink"
  +typeId: TypeId
  +description: string
   notes: string
   specificationLink: uri
   extensions: object
}

class TransportLinkTypeUnion <<union>> {
  discriminator: kind
}

TransportLinkTypeUnion <|-- TransportLinkType
TransportLinkTypeUnion <|-- LinkStatusType

@enduml
