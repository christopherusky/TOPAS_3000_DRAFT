@startuml
title UTMC Transport link Sync Request
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class SyncRequest {
  +syncCorrelationId: integer
  +requestTime: datetime
   categories: list<SyncCategoryEnum>
   objectIds: list<ObjectId>
   subArea: string
   typeId: TypeId
   activeOnly: boolean
   since: datetime
   extensions: object
}

enum SyncCategoryEnum {
  definition
  configuration
  measurement
  fault
  type
  status
}

SyncRequest --> SyncCategoryEnum : categories

@enduml
