@startuml
title UTMC Transport Link Command
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class RecalibrateTransportLinkCommand {
  +transportLinkId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "recalibrate"
   extensions: object
}

class RequestTransportLinkStatusCommand {
  +transportLinkId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "requestStatus"
   extensions: object
}

class SetStocCommand {
  +transportLinkId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "setStoc"
  +stocValue: string
   extensions: object
}

class TransportLinkCommand <<union>> {
  discriminator: kind
}

TransportLinkCommand <|-- SetStocCommand
TransportLinkCommand <|-- RecalibrateTransportLinkCommand
TransportLinkCommand <|-- RequestTransportLinkStatusCommand

@enduml
