@startuml
title UTMC Traffic Event Domain
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 4961*3508

' ── traffic_event_accident ──
class AccidentEvent {
  +eventId: ObjectId
  +accidentType: AccidentType
  +status: EventStatus
   publicDescription: string
   locationDescription: string
   location: Point
   severity: SeverityType
   phase: string
   lanesAffected: LanesAffectedType
   lanesRestricted: integer
   lanesOperational: integer
   diversionRoute: string
   diversionInForce: boolean
   reportedBy: string
   confirmedBy: string
   modifiedBy: string
   accidentTime: datetime
   endTime: datetime
   vehicleCount: integer
   lightConditions: string
   roadConditions: string
   weatherConditions: string
   statisticDate: datetime
   externalCountryCode: string
   externalSystemCode: string
   externalSituationId: string
   externalSituationVersion: integer
   extensions: object
}

enum AccidentType {
  accident
  busAccident
  collision
  investigationWork
  chemicalSpillage
  fuelSpillage
  hazardousMaterials
  heavyLorry
  jackKnifedArticulatedLorry
  jackKnifedCaravan
  jackKnifedTrailer
  multiVehicle
  oilSpillage
  overturnedHeavyLorry
  overturnedTrailer
  overturnedVehicle
  secondaryAccident
  seriousAccident
  shedLoad
  other
}

' ── traffic_event_common ──
enum EventStatus {
  active
  planned
  suspended
  cleared
}

enum LanesAffectedType {
  I
  T
  II
  IT
  TI
  TT
  III
  IIT
  ITI
  ITT
  TII
  TIT
  TTI
  TTT
  IIII
  IIIT
  IITT
  ITTT
  TIII
  TTTT
  allOpen
}

enum SeverityType {
  unknown
  low
  medium
  high
}

' ── traffic_event_event ──
class PlannedEvent {
  +eventId: ObjectId
  +plannedEventType: PlannedEventType
  +status: EventStatus
   publicDescription: string
   locationDescription: string
   location: Point
   severity: SeverityType
   phase: string
   lanesAffected: LanesAffectedType
   lanesRestricted: integer
   lanesOperational: integer
   diversionRoute: string
   diversionInForce: boolean
   reportedBy: string
   confirmedBy: string
   modifiedBy: string
   plannedStart: datetime
   plannedEnd: datetime
   actualStart: datetime
   actualEnd: datetime
   organiser: string
   venueName: string
   externalCountryCode: string
   externalSystemCode: string
   externalSituationId: string
   externalSituationVersion: integer
   extensions: object
}

enum PlannedEventType {
  ballGame
  boxing
  athletics
  cycleRace
  demonstration
  exhibition
  fair
  festival
  football
  funfair
  golf
  internationalSports
  marathon
  march
  market
  match
  parade
  procession
  race
  rugby
  show
  showJumping
  sportsEvent
  sportsMeeting
  stateOccasion
  strike
  tennis
  tournament
  tradeFair
  waterSports
  winterSports
  other
}

