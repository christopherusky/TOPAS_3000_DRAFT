' ── traffic_event_roadworks ──
class RoadworksEvent {
  +eventId: ObjectId
  +roadworksType: RoadworksType
  +status: EventStatus
   publicDescription: string
   locationDescription: string
   location: Point
   severity: SeverityType
   phase: string
   lanesAffected: LanesAffectedType
   lanesRestricted: integer
   lanesOperational: integer
   diversionRoute: string
   diversionInForce: boolean
   reportedBy: string
   confirmedBy: string
   modifiedBy: string
   plannedStart: datetime
   plannedEnd: datetime
   actualStart: datetime
   actualEnd: datetime
   contractor: string
   trafficSignals: boolean
   contraflow: boolean
   confirmedDate: datetime
   externalCountryCode: string
   externalSystemCode: string
   externalSituationId: string
   externalSituationVersion: integer
   extensions: object
}

enum RoadworksType {
  centralReservation
  general
  overhead
  surface
  verge
  waterMainWork
  other
}

' ── traffic_event_sync_complete ──
class SyncComplete {
  +syncCorrelationId: integer
   syncId: string
  +status: SyncStatus
  +objectCount: integer
  +completedTime: datetime
   message: string
   extensions: object
}

enum SyncStatus {
  success
  rejected
  failed
}

' ── traffic_event_sync_request ──
class SyncRequest {
  +syncCorrelationId: integer
  +requestTime: datetime
   categories: list<SyncCategoryEnum>
   objectIds: list<ObjectId>
   subArea: string
   typeId: TypeId
   activeOnly: boolean
   since: datetime
   extensions: object
}

enum SyncCategoryEnum {
  definition
  configuration
  measurement
  fault
  type
  status
}

' ── External types ──
class EventStatus <<traffic_event_common>> #EEEEEE
class LanesAffectedType <<traffic_event_common>> #EEEEEE
class Point <<../common/common>> #EEEEEE
class SeverityType <<traffic_event_common>> #EEEEEE

AccidentEvent --> AccidentType : accidentType
AccidentEvent ..> EventStatus : status
AccidentEvent ..> Point : location
AccidentEvent ..> SeverityType : severity
AccidentEvent ..> LanesAffectedType : lanesAffected
PlannedEvent --> PlannedEventType : plannedEventType
PlannedEvent ..> EventStatus : status
PlannedEvent ..> Point : location
PlannedEvent ..> SeverityType : severity
PlannedEvent ..> LanesAffectedType : lanesAffected
IncidentEvent --> IncidentType : incidentType
IncidentEvent ..> EventStatus : status
IncidentEvent ..> Point : location
IncidentEvent ..> SeverityType : severity
IncidentEvent ..> LanesAffectedType : lanesAffected
RoadworksEvent --> RoadworksType : roadworksType
RoadworksEvent ..> EventStatus : status
RoadworksEvent ..> Point : location
RoadworksEvent ..> SeverityType : severity
RoadworksEvent ..> LanesAffectedType : lanesAffected
SyncComplete --> SyncStatus : status
SyncRequest --> SyncCategoryEnum : categories

@enduml
