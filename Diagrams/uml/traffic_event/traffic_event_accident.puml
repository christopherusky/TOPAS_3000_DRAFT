@startuml
title UTMC Traffic Event Accident
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class AccidentEvent {
  +eventId: ObjectId
  +accidentType: AccidentType
  +status: EventStatus
   publicDescription: string
   locationDescription: string
   location: Point
   severity: SeverityType
   phase: string
   lanesAffected: LanesAffectedType
   lanesRestricted: integer
   lanesOperational: integer
   diversionRoute: string
   diversionInForce: boolean
   reportedBy: string
   confirmedBy: string
   modifiedBy: string
   accidentTime: datetime
   endTime: datetime
   vehicleCount: integer
   lightConditions: string
   roadConditions: string
   weatherConditions: string
   statisticDate: datetime
   externalCountryCode: string
   externalSystemCode: string
   externalSituationId: string
   externalSituationVersion: integer
   extensions: object
}

enum AccidentType {
  accident
  busAccident
  collision
  investigationWork
  chemicalSpillage
  fuelSpillage
  hazardousMaterials
  heavyLorry
  jackKnifedArticulatedLorry
  jackKnifedCaravan
  jackKnifedTrailer
  multiVehicle
  oilSpillage
  overturnedHeavyLorry
  overturnedTrailer
  overturnedVehicle
  secondaryAccident
  seriousAccident
  shedLoad
  other
}

class EventStatus <<traffic_event_common>> #EEEEEE
class LanesAffectedType <<traffic_event_common>> #EEEEEE
class Point <<../common/common>> #EEEEEE
class SeverityType <<traffic_event_common>> #EEEEEE

AccidentEvent --> AccidentType : accidentType
AccidentEvent ..> EventStatus : status
AccidentEvent ..> Point : location
AccidentEvent ..> SeverityType : severity
AccidentEvent ..> LanesAffectedType : lanesAffected

@enduml
