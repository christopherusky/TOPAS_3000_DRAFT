@startuml
title UTMC Transport Route Configuration
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class TransportRouteConfiguration {
  +transportRouteId: ObjectId
  +configurationDate: datetime
   routeName: string
   routeStart: string
   routeVia: string
   routeEnd: string
   routeLengthMeters: number
   extensions: object
}

class TransportRouteSegmentConfiguration {
  +transportRouteId: ObjectId
  +configurationDate: datetime
  +routeSegmentId: integer
  +transportLinkId: ObjectId
   extensions: object
}

@enduml
