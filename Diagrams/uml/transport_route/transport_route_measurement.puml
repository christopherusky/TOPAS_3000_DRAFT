@startuml
title UTMC Transport Route Measurement
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class TransportRouteDynamic {
  +transportRouteId: ObjectId
  +timestamp: datetime
   quality: Quality
   currentJourneyTimeSeconds: number
   estimatedSpeedKph: number
   routeStatus: TransportRouteStatus
   extensions: object
}

enum TransportRouteStatus {
  inRange
  outOfRange
}

class Quality <<../common/common>> #EEEEEE

TransportRouteDynamic ..> Quality : quality
TransportRouteDynamic --> TransportRouteStatus : routeStatus

@enduml
