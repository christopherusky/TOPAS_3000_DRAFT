@startuml
title UTMC Transport Route Command
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class RequestTransportRouteStatusCommand {
  +transportRouteId: ObjectId
  +commandCorrelationId: integer
  +requestTime: datetime
  +kind: "requestStatus"
   extensions: object
}

class TransportRouteCommand <<union>> {
  discriminator: kind
}

TransportRouteCommand <|-- RequestTransportRouteStatusCommand

@enduml
