@startuml
title UTMC Transport Route Command Response
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 3508*2480

class TransportRouteCommandResponse {
  +transportRouteId: ObjectId
  +commandCorrelationId: integer
  +status: CommandResponseStatus
  +responseTime: datetime
   code: string
   message: string
   extensions: object
}

class CommandResponseStatus <<../common/common>> #EEEEEE

TransportRouteCommandResponse ..> CommandResponseStatus : status

@enduml
