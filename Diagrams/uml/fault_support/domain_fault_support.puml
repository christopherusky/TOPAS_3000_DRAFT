@startuml
title UTMC Fault Support Domain
!pragma layout smetana
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #555555
}
scale max 4961*3508

' ── fault_support ──
class FaultTypeDefinition {
  +faultTypeId: TypeId
  +description: string
   severity: integer
   subsystemTypeId: TypeId
   code: string
   category: FaultCategory
   messageTemplate: string
   parameterNames: list<string>
   extensions: object
}

enum AcknowledgementState {
  notAcknowledged
  acknowledged
  deferred
  recordedForAction
}

enum FaultCategory {
  hardware
  communications
  signalTimings
  environmental
  other
}

enum FaultStatus {
  active
  cleared
}

FaultTypeDefinition --> FaultCategory : category

@enduml
