{
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/strategy/strategy_command-v1.0.json",
  "$ref": "#/$defs/StrategyTrigger",
  "$defs": {
    "StrategyTrigger": {
      "additionalProperties": false,
      "description": "Strategy trigger command payloads.",
      "properties": {
        "strategyId": {
          "description": "Identifier of the strategy to trigger.",
          "minLength": 1,
          "type": "string"
        },
        "commandCorrelationId": {
          "description": "Caller-assigned identifier correlating a command request with its response. Not an identifier of the command itself. Named to avoid collision with the AMQP 1.0 correlation-id message property.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requestTime": {
          "description": "When the command was issued.",
          "format": "date-time",
          "type": "string"
        },
        "serviceRequester": {
          "type": "string",
          "minLength": 1,
          "description": "Audit label naming the requesting system. Sender-supplied, so it is never used for authorisation or idempotency."
        },
        "triggerState": {
          "$ref": "#/$defs/TriggerStateEnum",
          "description": "Desired trigger state (enabled/disabled)."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions."
        }
      },
      "required": [
        "strategyId",
        "commandCorrelationId",
        "requestTime",
        "triggerState"
      ],
      "type": "object",
      "title": "UTMC Strategy Command"
    },
    "TriggerStateEnum": {
      "description": "Desired state when triggering a strategy.",
      "enum": [
        "enabled",
        "disabled"
      ],
      "type": "string"
    }
  }
}
