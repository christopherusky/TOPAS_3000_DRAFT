{
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/vms/vms_history-v1.0.json",
  "$ref": "#/$defs/VmsHistoryEntry",
  "$defs": {
    "VmsHistoryEntry": {
      "additionalProperties": false,
      "description": "Variable message sign history entries.",
      "properties": {
        "vmsId": {
          "description": "Identifier of the VMS this log entry is about.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "ObjectId",
          "type": "string"
        },
        "logId": {
          "description": "Unique identifier of this log entry.",
          "minimum": 0,
          "type": "integer"
        },
        "logDate": {
          "description": "When the log entry was recorded.",
          "format": "date-time",
          "type": "string"
        },
        "logEntry": {
          "description": "Equipment log data (free-form text).",
          "type": "string"
        },
        "logUser": {
          "type": "string",
          "description": "User who created the log entry."
        },
        "eventType": {
          "type": "string",
          "description": "Category of the history event."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions."
        }
      },
      "required": [
        "vmsId",
        "logId",
        "logDate",
        "logEntry"
      ],
      "type": "object",
      "title": "UTMC VMS History"
    }
  }
}
