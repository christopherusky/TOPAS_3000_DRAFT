{
  "$id": "https://schemas.example.invalid/topas3000a/v1.0/transport_route/transport_route_fault-v1.0.json",
  "$ref": "#/$defs/TransportRouteFault",
  "$defs": {
    "TransportRouteFault": {
      "additionalProperties": false,
      "description": "Transport route fault reports.",
      "properties": {
        "transportRouteId": {
          "description": "Identifier of the route this fault is about.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "ObjectId",
          "type": "string"
        },
        "faultId": {
          "description": "Unique identifier of this fault report.",
          "minimum": 0,
          "type": "integer"
        },
        "faultTypeId": {
          "description": "Reference to a FaultTypeDefinition entry.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "title": "TypeId",
          "type": "string"
        },
        "supplierFaultNumber": {
          "type": "string",
          "description": "Fault identifier allocated by the supplier or configuration manager for maintenance purposes, if required."
        },
        "subsystemTypeId": {
          "type": "string",
          "description": "Reference to a SubsystemDefinition entry: the subsystem the fault arose in.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "title": "TypeId"
        },
        "equipmentFault": {
          "type": "boolean",
          "description": "Whether this is an equipment fault. The fault type's catalogue category classifies the type; this flag classifies this fault."
        },
        "communicationsFault": {
          "type": "boolean",
          "description": "Whether this is a communications fault. See equipmentFault for how it relates to the catalogue category."
        },
        "creationDate": {
          "description": "When the fault was first raised.",
          "format": "date-time",
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "When last modified."
        },
        "clearedDate": {
          "type": "string",
          "format": "date-time",
          "description": "When cleared."
        },
        "description": {
          "type": "string",
          "description": "Free-text description."
        },
        "acknowledgementState": {
          "$ref": "../fault_support/fault_support-v1.0.json#/$defs/AcknowledgementState",
          "description": "Acknowledgement state."
        },
        "acknowledgementDate": {
          "type": "string",
          "format": "date-time",
          "description": "When acknowledged."
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "description": "Fault severity."
        },
        "status": {
          "$ref": "../fault_support/fault_support-v1.0.json#/$defs/FaultStatus",
          "description": "Active or cleared."
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Values for the positional placeholders in the referenced FaultTypeDefinition's messageTemplate, in order. Rendered as text so a value carries whatever form the fault reports it in."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Vendor or local extensions."
        }
      },
      "required": [
        "transportRouteId",
        "faultId",
        "faultTypeId",
        "creationDate"
      ],
      "type": "object",
      "title": "UTMC Transport Route Fault"
    }
  }
}
