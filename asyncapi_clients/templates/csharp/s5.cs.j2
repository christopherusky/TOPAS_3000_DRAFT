using System;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;

using Amqp;
using Amqp.Framing;
using Amqp.Types;

/// <summary>
/// Scenario S5 — Subscribe to {{ channels.traffic_signal_measurement }} (DATEX-II 2017 profile).
///
/// Demonstrates: continuous telemetry from the most operationally
/// important UTC domain. Same envelope shape as S1 but a
/// different domain; the snippet pulls out the headline fields
/// (signal id, mode, sub-mode, current plan id) so an operator can
/// eyeball state at a glance.
///
/// Tip: a typed SDK is not yet generated for C#. Deserialize the
/// JSON into a record/POCO of your choosing —
/// <c>JsonSerializer.Deserialize&lt;T&gt;</c> is the usual bridge
/// once the SDK ships.
/// </summary>
public class S5
{
    private const string Channel = "{{ channels.traffic_signal_measurement }}";

    public static async Task Main(string[] args)
    {
        string url = Environment.GetEnvironmentVariable("TOPAS_AMQP_URL")
            ?? "{{ server_uri }}".Replace("{host}", "localhost").Replace("{port}", "5671");
        int maxMessages = int.Parse(
            Environment.GetEnvironmentVariable("TOPAS_MAX_MESSAGES") ?? "5");

        var address = new Address(url);
        var connection = await Connection.Factory.CreateAsync(address);
        var session = new Session(connection);
        // See S1 for why the source needs the `topic` capability.
        var source = new Source
        {
            Address = Channel,
            Capabilities = new Symbol[] { new Symbol("topic") },
        };
        var receiver = new ReceiverLink(session, "s5-receiver", source, null);
        // Readiness handshake: the harness waits for this before
        // starting the publisher. Every publisher sends a fixed burst and
        // exits, so a message published before this link is attached is
        // discarded by the broker with no consumer to route it to.
        Console.Error.WriteLine("[ready]");

        try
        {
            for (int received = 0; received < maxMessages; received++)
            {
                Message msg = await receiver.ReceiveAsync(TimeSpan.FromSeconds(5));
                if (msg == null)
                {
                    Console.Error.WriteLine("[S5] Receive() timed out — broker idle? aborting.");
                    return;
                }

                string body = BodyAsString(msg);
                using JsonDocument doc = JsonDocument.Parse(body);
                JsonElement state = doc.RootElement;

                string signalId = TextOrNa(state, "trafficSignalId");
                string mode = TextOrNa(state, "trafficSignalMode");
                string subMode = TextOrNa(state, "trafficSignalSubMode");
                string plan = "n/a";
                if (state.TryGetProperty("planLine", out JsonElement planLine)
                    && planLine.ValueKind == JsonValueKind.Object)
                {
                    plan = TextOrNa(planLine, "planNumber");
                }

                Console.WriteLine(
                    $"[{received + 1}] signal={signalId} mode={mode} sub={subMode} plan={plan}");
                receiver.Accept(msg);
            }
        }
        finally
        {
            await receiver.CloseAsync();
            await session.CloseAsync();
            await connection.CloseAsync();
        }
    }

    private static string TextOrNa(JsonElement node, string field)
    {
        if (!node.TryGetProperty(field, out JsonElement v)
            || v.ValueKind == JsonValueKind.Null
            || v.ValueKind == JsonValueKind.Undefined)
        {
            return "n/a";
        }
        return v.ValueKind == JsonValueKind.String ? v.GetString() : v.ToString();
    }

    private static string BodyAsString(Message msg)
    {
        object body = msg.Body;
        return body switch
        {
            string s => s,
            byte[] bytes => Encoding.UTF8.GetString(bytes),
            null => string.Empty,
            _ => body.ToString() ?? string.Empty,
        };
    }
}
