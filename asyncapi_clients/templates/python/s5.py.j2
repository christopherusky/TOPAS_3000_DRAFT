"""Scenario S5 — Subscribe to {{ channels.traffic_signal_measurement }} (DATEX-II 2017 profile).

Demonstrates: continuous telemetry from the most operationally
important UTC domain. Uses the typed SDK class
`TrafficSignalDynamicState` (DATEX-II-derived 2017 profile,
to validate each payload before printing the headline
fields (mode, sub-mode, current plan).
"""
import json
import os
import sys

from proton.handlers import MessagingHandler
from proton.reactor import Container

from asyncapi_clients.output.python.sdk.traffic_signal.traffic_signal_measurement_v1_0 import (
    TrafficSignalDynamicState,
)


CHANNEL = "{{ channels.traffic_signal_measurement }}"
SERVER = os.environ.get(
    "TOPAS_AMQP_URL",
    "{{ server_uri }}".format(host="localhost", port="5671"),
)
MAX_MESSAGES = int(os.environ.get("TOPAS_MAX_MESSAGES", "5"))


class TrafficSignalReader(MessagingHandler):
    def __init__(self, url: str, channel: str) -> None:
        super().__init__()
        self.url = url
        self.channel = channel
        self.received = 0

    def on_start(self, event):
        conn = event.container.connect(self.url)
        event.container.create_receiver(conn, self.channel)

    def on_link_opened(self, event):
        # Readiness handshake: the harness waits for this before
        # starting the publisher. Every publisher sends a fixed burst and
        # exits, so anything published before this link is attached is
        # discarded by the broker and the subscriber then waits for messages
        # that no longer exist. on_link_opened fires when the peer confirms
        # the attach, which is the earliest point it is safe to publish.
        if event.receiver is None:
            return
        self._links_open = getattr(self, "_links_open", 0) + 1
        if self._links_open == 1:
            print("[ready]", file=sys.stderr, flush=True)

    def on_message(self, event):
        state = TrafficSignalDynamicState.model_validate_json(event.message.body)
        plan = (
            f"plan={state.planLine.planNumber}" if state.planLine else "plan=n/a"
        )
        print(
            f"[{self.received + 1}] signal={state.trafficSignalId} "
            f"mode={state.trafficSignalMode.value} "
            f"sub={state.trafficSignalSubMode.value if state.trafficSignalSubMode else 'n/a'} "
            f"{plan}",
            flush=True,
        )
        self.received += 1
        if self.received >= MAX_MESSAGES:
            event.connection.close()


def main() -> int:
    Container(TrafficSignalReader(SERVER, CHANNEL)).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
