<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_quantised_traffic_signal">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_data_object_traffic_signal-v1.0.xsd"/>    <xsd:include schemaLocation="utmc_quantised-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   properties of UTMC Traffic Signal Prediction and Profile  Objects.                       <ol>                            <li>Traffic Signal Prediction</li>                            <li>Traffic Signal Profile</li>                        </ol>                    </p>                    <p>Each Prediction object assesses a one or more Prediction data values that will be in effect at a specific date and time band.</p>                    <p>Each Profile  object summarises data values as one or more Profile  data values that summarise  a specific date and time band. </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_quantised_traffic_signal-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_data_object_traffic_signal-v1.0.xsd</Requires>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_quantised-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing   UTMC  Traffic Signal Prediction and Profile Objects.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ======================================================================= -->    <xsd:group name="TrafficSignalQuantisedDataGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal Prediction Data .</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:group ref="TrafficSignalDynamicGroup"/>        </xsd:sequence>    </xsd:group>    <!-- ===Prediction =========================================================== -->    <xsd:element name="TrafficSignalPrediction" type="TrafficSignalPredictionStructure" substitutionGroup="AbstractPrediction">        <xsd:annotation>            <xsd:documentation>Traffic Signal Prediction.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="TrafficSignalPredictionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractPredictionStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalPredictionGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TrafficSignalPredictionGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="predictionData" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Prediction data</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalPredictionData" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Prediction data========================================================= -->    <xsd:element name="TrafficSignalPredictionData" substitutionGroup="AbstractPredictionData">        <xsd:annotation>            <xsd:documentation>Traffic Signal Prediction Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalPredictionDataStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="PredictionIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a Prediction. Normally given by context; only needs to be present in standalone use. </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="QuantisedDataGroup"/>                            <xsd:element name="DataObjectRef" type="TrafficSignalIdType">                                <xsd:annotation>                                    <xsd:documentation>Reference to a Data Object</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TrafficSignalQuantisedDataGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalPredictionDataStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal Prediction Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractPredictionDataStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalQuantisedDataGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Profile=========================================================== -->    <xsd:element name="TrafficSignalProfile" type="TrafficSignalProfileStructure" substitutionGroup="AbstractProfile">        <xsd:annotation>            <xsd:documentation>Traffic Signal Profile.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="TrafficSignalProfileStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal Profile.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractProfileStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalProfileGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TrafficSignalProfileGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal Profile.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="profileData" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Profile data</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalProfileData" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Profile Data  </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Profile data========================================================= -->    <xsd:element name="TrafficSignalProfileData" substitutionGroup="AbstractProfileData">        <xsd:annotation>            <xsd:documentation>Traffic Signal Profile Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalProfileDataStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="ProfileIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a Profile. Normally given by context. only needs to be present in standalone use. </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="QuantisedDataGroup">                                <xsd:annotation>                                    <xsd:documentation>Elements for Prediction and Profile data.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:element name="DataObjectRef" type="TrafficSignalIdType">                                <xsd:annotation>                                    <xsd:documentation>Reference to a Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TrafficSignalQuantisedDataGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalProfileDataStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal Profile Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractProfileDataStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalQuantisedDataGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType></xsd:schema>