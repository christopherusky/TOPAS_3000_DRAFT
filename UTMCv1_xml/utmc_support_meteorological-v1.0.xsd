<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_meteorological">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_typeID-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project and UTMC XML working Group. </Contributor>				<Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>				<Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>				<Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>				<Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>				<Contributor>UTMC: mark.bodger at siemens.com; </Contributor>				<Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>				<Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>				<Contributor>UTMC: brendan mason, tenet </Contributor>				<Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>				<Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>				<Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>				<Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>				<Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>				<Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>				<Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>				<Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>				<Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>				<Contributor>Freeflow: rob shepherd at acis.com</Contributor>				<Contributor>Freeflow: ian routledge at acis.com</Contributor>				<Contributor>TO be COMPLETED  </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the common wetaher type definitiuons used by the   UTMC Meteorological device Data Object and other components. These may include:                    <ol>							<li>Precipitation Definition,  </li> 							<li>Visibility  Definition, d </li>							<li>Road Condition.</li>							</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_support_meteorological-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_typeID-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing the UTMC Meteorological Definition objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===Object ID=============================================================== -->	<!-- ============================================================ -->	<xsd:element name="RoadConditionTypeRef" type="RoadConditionTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to  Road Condition Type Definition.1 = Dry,2 = Wet,3 = Deep Water,4 = Frost,5 = Ice,6 = Black Ice,7 = Snow.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="RoadConditionTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier of Road Condition Type  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="RoadConditionTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Type of allowed Road Condition</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Dry"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Wet"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Deep Water"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Frost"/>			<xsd:enumeration value="5"/>			<xsd:enumeration value="Ice"/>			<xsd:enumeration value="6"/>			<xsd:enumeration value="Black Ice"/>			<xsd:enumeration value="7"/>			<xsd:enumeration value="Snow"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="RoadConditionTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Road Condition Type  Definition. Used on Meteorological Object.1 = Dry,2 = Wet,3 = Deep Water,4 = Frost,5 = Ice,6 = Black Ice,7 = Snow.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="RoadConditionTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="VisibilityTypeRef" type="VisibilityTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Visibility Type Definition.1 = Sunny - Sunshine for most of the day, usually more than 80% of possible daytime sun.2= Sunny periods    - More sunshine than cloud, the sun shining for periods of an hour or more at a time.3 = Sunny Intervals/Spells  -  Intermittent sunshine during the day, usually less than 50% of possible daytime sun.4 = Bright - Generally cloudy, but the cloud thin enough for weak shadows. There may be a few glimpses of the sun, but usually adding up to less than 1 hour.5 = Cloudy/Overcast - Cloud nearly or completely covering the sky, with no shadows.6 = Dull/Misty - Similar to cloudy/overcast but with poorer visibility, usually between 1500 and 5000 metres.7 = Hazy - Used when horizontal visibility is reduced by smoke particles or other pollutants with visibility between 2000 metres and 10km. It can be either sunny or cloudy when hazy. 8 = Foggy - Used when horizontal visibility is below 1000 metres.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="VisibilityTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier of  Road Condition Type  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="VisibilityTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Allowed values for  Road Condition</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Sunny"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Sunny periods"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Sunny Intervals/Spells"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Bright"/>			<xsd:enumeration value="5"/>			<xsd:enumeration value="Cloudy/Overcast"/>			<xsd:enumeration value="6"/>			<xsd:enumeration value="Dull/Misty"/>			<xsd:enumeration value="7"/>			<xsd:enumeration value="Hazy"/>			<xsd:enumeration value="8"/>			<xsd:enumeration value="Foggy"/>			<xsd:enumeration value="9"/>			<xsd:enumeration value="Other"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="VisibilityTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Visibility Type  Definition. Used on Meteorological Object. 1 = Sunny - Sunshine for most of the day, usually more than 80% of possible daytime sun.2 = Sunny periods   - More sunshine than cloud, the sun shining for periods of an hour or more at a time.3 = Sunny Intervals/Spells  -  Intermittent sunshine during the day, usually less than 50% of possible daytime sun.4 = Bright - Generally cloudy, but the cloud thin enough for weak shadows. There may be a few glimpses of the sun, but usually adding up to less than 1 hour.5 = Cloudy/Overcast - Cloud nearly or completely covering the sky, with no shadows.6 = Dull/Misty - Similar to cloudy/overcast but with poorer visibility, usually between 1500 and 5000 metres.7 = Hazy - Used when horizontal visibility is reduced by smoke particles or other pollutants with visibility between 2000 metres and 10km. It can be either sunny or cloudy when hazy. 8 = Foggy - Used when horizontal visibility is below 1000 metres.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="VisibilityTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="PrecipitationTypeRef" type="PrecipitationTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Precipitation Type Definition.0 = D - Dry,1 = DZ - Drizzle,2 = R - Persistent rain,3 = SH - Showers,4 = SL - Sleet,5 = SN - Snow,6 = SLSH - Sleet showers,7 = SNSH - Snow showers,8 = TS - Thunderstorms,9 = H - Hail</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="PrecipitationTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier of Precipitation  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="PrecipitationTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Allowed values for Precipitation</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="0"/>			<xsd:enumeration value="D = Dry"/>			<xsd:enumeration value="1"/>			<xsd:enumeration value="DZ = Drizzle"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="R = Persistent rain"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="SH = Showers"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="SL = Sleet"/>			<xsd:enumeration value="5"/>			<xsd:enumeration value="SN = Snow"/>			<xsd:enumeration value="6"/>			<xsd:enumeration value="SLSH = Sleet showers"/>			<xsd:enumeration value="7"/>			<xsd:enumeration value="SNSH = Snow showers"/>			<xsd:enumeration value="8"/>			<xsd:enumeration value="TS = Thunderstorms"/>			<xsd:enumeration value="9"/>			<xsd:enumeration value="H = Hail"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="PrecipitationTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Precipitation Type  Definition. Used on Meteorological Object. 0 = D - Dry,1 = DZ - Drizzle,2 = R - Persistent rain,3 = SH - Showers,4 = SL - Sleet,5 = SN - Snow,6 = SLSH - Sleet showers,7 = SNSH - Snow showers,8 = TS - Thunderstorms,9 = H - Hail</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="PrecipitationTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Quality==================================================== --></xsd:schema>