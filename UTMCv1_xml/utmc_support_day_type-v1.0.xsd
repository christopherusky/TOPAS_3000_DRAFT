<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2005 rel. 3 U (http://www.altova.com) by Nick Knowles (Kizoom) --><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_day_type">	<xsd:include schemaLocation="utmc_network_base-v1.0.xsd"/>	<!-- ===Dependencies ======================================= -->	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>. 					<p>This subschema describes the   UTMC Day Type Definition    used to specify allowed values of Day Types.. This object supports the definition of normal and specifc day types that can be accessed by other componentssuch as Car_Park_Opening_Times , XXX_Profiles and XXX_quantiseds.  A series of predefined day type are providedfor normal days of the week. The object allows specific daytypes to be defined to accomodate special days such as Race Days and special dates such as Easter Bank Holidays ( 28/04/2005). 					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_support_day_type-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>none</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.							<ul>							<li>UTMC Data Obejct specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specifcation: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema of   Day Type Definition   used to specify allowed values of Day types</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:element name="DayTypeRef" type="DayTypeIdType">		<xsd:annotation>			<xsd:documentation>Reference to  Identifier of a day type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="DayTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a day type.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer">			<xsd:minInclusive value="1"/>			<xsd:maxInclusive value="100"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:simpleType name="DayTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Predefined values for Identifier of a day type.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:string">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Monday"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Tuesday"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Wednesday"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Tiursday"/>			<xsd:enumeration value="5"/>			<xsd:enumeration value="Friday"/>			<xsd:enumeration value="6"/>			<xsd:enumeration value="Saturday"/>			<xsd:enumeration value="7 "/>			<xsd:enumeration value="Sunday"/>		</xsd:restriction>	</xsd:simpleType>	<!-- ======================================================================= -->	<xsd:element name="DayTypeDefinition" type="DayTypeDefinitionStructure">		<xsd:annotation>			<xsd:documentation>Day type Definition. Includes predefined Day Types:1 = Monday,2 = Tuesday,3 = Wednesday,4 = Thursday,5 = Friday,6 = Saturday,7 = Sunday,</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DayTypeDefinitionStructure">		<xsd:annotation>			<xsd:documentation>This object supports the definition of normal and specifc day types that can be accessed by other components such as Car_Park_Opening_Times , XXX_Profiles and XXX_quantiseds.  A series of predefined day type are provided for normal days of the week. Special day types can be defined to accomodate special days such as Race Days and special dates (through the relationship with </xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="DistributedManagementGroup"/>			<xsd:element name="TypeId" type="DayTypeIdType">				<xsd:annotation>					<xsd:documentation>Identifier for DayTypeIDList of Predefined Day Types:1 = Monday,2 = Tuesday,3 = Wednesday,4 = Thursday,5 = Friday,6 = Saturday,7 = Sunday,The maximum value shall be 100</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="TypeDescription" type="xsd:string">				<xsd:annotation>					<xsd:documentation>Name, e.g. Monday.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ShortName" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Short name, e.g. Mon.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="PreDefined" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whetehr day Predefined or added.  are 1-7 for Monday to friday.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="DateTypeDefinition" type="DateTypeDefinitionStructure">		<xsd:annotation>			<xsd:documentation>Date  type Definition. Includes predefined Day Types:1 = Monday,2 = Tuesday,3 = Wednesday,4 = Thursday,5 = Friday,6 = Saturday,7 = Sunday,</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DateTypeDefinitionStructure">		<xsd:annotation>			<xsd:documentation>A specific date and its mapping to a day category.Use to accomodate special dates such as Easter Bank Holidays (e.g. 28/04/2005).</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="DistributedManagementGroup"/>			<xsd:element ref="DayTypeRef"/>			<xsd:element name="Date" type="xsd:date">				<xsd:annotation>					<xsd:documentation>Date being defined</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Abnormal" type="xsd:boolean">				<xsd:annotation>					<xsd:documentation>Whether date is abnormal date?</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Reason" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reason for abnormal date</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:complexType></xsd:schema>