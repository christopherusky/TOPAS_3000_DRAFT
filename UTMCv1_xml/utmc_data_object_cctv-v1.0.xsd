<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_cctv">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_device-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project and UTMC XML working Group. </Contributor>				<Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>				<Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>				<Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>				<Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>				<Contributor>UTMC: mark.bodger at siemens.com; </Contributor>				<Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>				<Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>				<Contributor>UTMC: brendan mason, tenet </Contributor>				<Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>				<Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>				<Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>				<Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>				<Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>				<Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>				<Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>				<Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>				<Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>				<Contributor>Freeflow: rob shepherd at acis.com</Contributor>				<Contributor>Freeflow: ian routledge at acis.com</Contributor>				<Contributor>TO be COMPLETED  </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Date>					<Created>2009-06-10</Created>					<!-- And ANPR VRN element -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Cctv device Data Object and its components. These may include:                    <ol>							<li>Definition, describing the fixed properties of an object and its location on the network.</li>							<ul>								<li>Cctv Definition</li>							</ul>							<li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>							<ul>								<li>Cctv Configuration</li>							</ul>							<li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>							<ul>								<li>Cctv Dynamic</li>							</ul>							<li>Device History, describing the device history which may be issued to the device.</li>							<ul>								<li>Cctv Device History</li>							</ul>							<li>Fault, describing the device  faults,</li>							<ul>								<li>Cctv Fault</li>							</ul>							<li>Command, describing the commands which may be issued to the device.</li>							<ul>								<li>Cctv Command</li>							</ul>							<li>Types, describing the allowed values for types associated with Cctv data object.</li>							<ul>								<li>Cctv Quality Type Definition</li>								<li>Cctv Fault Type Definition</li>								<li>Cctv Vehicle Type Definition</li>							</ul>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_cctv-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing the UTMC Cctv Device Object.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===Object ID=============================================================== -->	<xsd:simpleType name="CctvIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Cctv Camera.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="CctvRef" type="CctvIdType" substitutionGroup="DeviceRef">		<xsd:annotation>			<xsd:documentation>Reference to a Cctv Camera. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvCameraFullRefStructure">		<xsd:annotation>			<xsd:documentation>Type for full reference to a Cctv Camera.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="ObjectFullRefStructure">				<xsd:sequence>					<xsd:element ref="CctvRef"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<!-- ===Data Object =========================================================== -->	<xsd:element name="Cctv" substitutionGroup="AbstractDeviceObject">		<xsd:annotation>			<xsd:documentation>Cc TV Data Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="CctvStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:sequence>								<xsd:element ref="ParticipantRef" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>									</xsd:annotation>								</xsd:element>							</xsd:sequence>							<xsd:sequence>								<xsd:element name="SystemCodeNumber" type="CctvIdType">									<xsd:annotation>										<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>									</xsd:annotation>								</xsd:element>								<xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>									</xsd:annotation>								</xsd:element>								<xsd:element name="OriginatingObjectRef" type="CctvIdType" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>									</xsd:annotation>								</xsd:element>							</xsd:sequence>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="CctvGroup"/>							<xsd:group ref="CctvDeviceGroup">								<xsd:annotation>									<xsd:documentation>Cctv Device elements</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="CctvStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Cc TV.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDeviceStructure">				<xsd:sequence>					<xsd:group ref="CctvGroup"/>					<xsd:group ref="CctvDeviceGroup">						<xsd:annotation>							<xsd:documentation>Cctv Device elements</xsd:documentation>						</xsd:annotation>					</xsd:group>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cctv.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="definitions" minOccurs="0">				<xsd:annotation>					<xsd:documentation>CC TV defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvDefinition" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="configurations" minOccurs="0">				<xsd:annotation>					<xsd:documentation>CC TV configurations.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvConfiguration" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="dynamics" minOccurs="0">				<xsd:annotation>					<xsd:documentation>CC TV dynamic values.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvAnprDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="CctvAnprVrnDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="CctvBroadcastDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="CctvFlowDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="CctvImageDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="CctvQueueDynamic" minOccurs="0" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Object Definition=========================================================== -->	<xsd:element name="CctvDefinition" substitutionGroup="AbstractDeviceDefinition">		<xsd:annotation>			<xsd:documentation>Cc TV  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="CctvDefinitionStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element name="ObjectTypeRef" type="CctvTypeIdType">								<xsd:annotation>									<xsd:documentation>Type of Data Object.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element name="QualityRef" type="CctvQualityIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Quality statement of Data Object.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="BaseDefinitionGroup"/>							<xsd:group ref="DefinitionDescriptionGroup">								<xsd:annotation>									<xsd:documentation>UTMC Object textual description elements.</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:group ref="PointOnPathGroup" minOccurs="0"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="OffsetObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="CctvDefinitionStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDeviceDefinitionStructure">				<xsd:sequence>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<!-- ===Object Configuration===================================================== -->	<xsd:element name="CctvConfiguration" substitutionGroup="AbstractConfiguration">		<xsd:annotation>			<xsd:documentation>Cc TV Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="CctvConfigurationStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="AbstractConfigurationGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="CctvConfigurationGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="CctvConfigurationStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  UTMC Cc TV Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractConfigurationStructure">				<xsd:sequence>					<xsd:group ref="CctvConfigurationGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvConfigurationGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV  Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SerialNumber" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Serial Number of Camera.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="CameraDetails" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of the installation.</xsd:documentation>				</xsd:annotation>				<xsd:simpleType>					<xsd:restriction base="xsd:string"/>				</xsd:simpleType>			</xsd:element>			<xsd:element name="Fixed" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether the camera is fixed or or can pan/tilt zoom.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="CameraHeight" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Height (m) of camera above ground level.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="CameraSubSiteRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to Camera Subsite.</xsd:documentation>				</xsd:annotation>				<xsd:simpleType>					<xsd:restriction base="xsd:string">						<xsd:maxLength value="32"/>					</xsd:restriction>				</xsd:simpleType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Object Dynamic============================================================ -->	<xsd:simpleType name="ImageTypeEnum">		<xsd:annotation>			<xsd:documentation>Enumeration of Cc TV  Status types</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:string">			<xsd:enumeration value="jpeg"/>			<xsd:enumeration value="png"/>			<xsd:enumeration value="bmp"/>			<xsd:enumeration value="gif"/>			<xsd:enumeration value="tiff"/>			<xsd:enumeration value="other"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="CctvDynamic" type="CctvDynamicStructure" abstract="true" substitutionGroup="AbstractDynamic">		<xsd:annotation>			<xsd:documentation>Cc TV Object  Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvDynamicStructure" abstract="true">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV  Camera Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:restriction base="AbstractDynamicStructure">				<xsd:sequence>					<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">						<xsd:annotation>							<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:group ref="AbstractDynamicGroup"/>				</xsd:sequence>			</xsd:restriction>		</xsd:complexContent>	</xsd:complexType>	<!-- =============================================================== -->	<xsd:element name="CctvImageDynamic" type="CctvImageDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>Cc TV Object  Dynamic Image. RENAMED from UML: Cctv Dynamic</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvImageDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV  Camera Dynamic Image.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:group ref="CctvImageDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvImageDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV Image  Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Preset" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Camera preset number {what is it??] </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ImageType" type="ImageTypeEnum">				<xsd:annotation>					<xsd:documentation>Type of image: jpeg, png, etc</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:choice>				<xsd:element name="Image" type="xsd:hexBinary" minOccurs="0">					<xsd:annotation>						<xsd:documentation>Image content in Hex Binary</xsd:documentation>					</xsd:annotation>				</xsd:element>				<xsd:element name="ImageUrl" type="xsd:anyURI" minOccurs="0">					<xsd:annotation>						<xsd:documentation>URI of image file. freeflow extension.</xsd:documentation>					</xsd:annotation>				</xsd:element>			</xsd:choice>		</xsd:sequence>	</xsd:group>	<!-- =============================================================== -->	<xsd:element name="CctvAnprDynamic" type="CctvAnprDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>CCTV ANPR Camera.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvAnprDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV   Dynamic ANPR Camera.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:group ref="CctvAnprDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvAnprDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV ANPR Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CountPeriod" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Interval  over which  count has been made. Duration.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VehicleRegistrationMarksCount" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Number of Vehicle Registration Marks Counted in period.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- =============================================================== -->	<xsd:simpleType name="VrnInstanceIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier for inbstacne of Vehicle Recognition from  Cctv Camera</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:simpleType name="VehicleDirectionEnum">		<xsd:annotation>			<xsd:documentation>Identifier of  Cc TV Data Object Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:string">			<xsd:enumeration value="towards"/>			<xsd:enumeration value="away"/>			<xsd:enumeration value="a"/>			<xsd:enumeration value="t"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:simpleType name="LaneIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier of Lane </xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:simpleType name="VrnTagType">		<xsd:annotation>			<xsd:documentation>Type for identifier for inbstacne of Vehicle Recognition from  Cctv Camera</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:element name="CctvAnprVrnDynamic" type="CctvAnprVrnDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>CCTV ANPR Vehicle Recognition Camera.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvAnprVrnDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV   Dynamic VRN ANPR Camera.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:group ref="CctvAnprVrnDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvAnprVrnDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV ANPRVehicle Recognition   Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SerialNumber" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Serial Number of Camera.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LaneRef" type="LaneIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifies the lane the vehicle was seen travelling.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LaneDirectionRef" type="LaneDirectionTypeIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Indicates the direction of travel for the lane, reference to Direction_TypeID.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VrnInstanceId" type="VrnInstanceIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Unique id for the VRN instance.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="CctvAnprVrnTagGroup"/>			<xsd:group ref="CctvAnprVrnMeasurementGroup"/>			<xsd:group ref="CctvAnprVrnVehicleGroup"/>		</xsd:sequence>	</xsd:group>	<xsd:group name="CctvAnprVrnTagGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to ANPR Vehicle Measurement.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Vrn" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Vehicle Registration Mark.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VrnConfidence" type="Percentage" minOccurs="0">				<xsd:annotation>					<xsd:documentation>   Confidence in accuracy of VRN as a percentage.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Tag" type="VrnTagType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Hashed Vehicle Registration Mark (integer).</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="TagConfidence" type="Percentage" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Confidence in accuracy of Tag as a percentage.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Country" type="IsoCountry" minOccurs="0">				<xsd:annotation>					<xsd:documentation>ISO 3166-1 three character country code.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="CctvAnprVrnMeasurementGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to ANPR Vehicle Measurement.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="VehicleDirection" type="VehicleDirectionEnum" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifies if the vehicle was travelling towards or away from the camera (towards /T , Away / A).</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Speed" type="Speed" minOccurs="0">				<xsd:annotation>					<xsd:documentation>   Speed of vehicle in kph</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SpeedError" type="Speed" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Estimated speed error in kph at 95% confidence interval</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="PeriodInView" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Period of time a vehicle was in view of the camera in ms.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="TimeStampError" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Estimated worst case timestamp error in ms</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="CctvAnprVrnVehicleGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Vehicle Description.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="VehicleClassification" type="Euro6Classification" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Classification of the vehicle in Euro 6.1 Motor Cycle 2 Car or Light Van3 Car + Trailer4 Rigid, Heavy Van or Minibus5 Articulated HGV’s6 Bus and Coach			</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VehicleMake" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Make of vehicle (Manufacturer)</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VehicleModel" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Model of vehicle</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VehicleColour" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation> Colour of Vehict</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- =============================================================== -->	<xsd:element name="CctvBroadcastDynamic" type="CctvBroadcastDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>Cc TV Object  Dynamic Broadcast. </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvBroadcastDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV   Dynamic Broadcast.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:group ref="CctvBroadcastDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvBroadcastDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV  Dynamic broadcast  .</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Broadcast" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>On off indication as to whether image can be shown to public.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- =============================================================== -->	<xsd:element name="CctvQueueDynamic" type="CctvQueueDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>Cc TV Object  Dynamic Queue. Freeflow Extension ?</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvQueueDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV   Dynamic Queue </xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:group ref="CctvQueueDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvQueueDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV Queue Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="QueueVehicleCount" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Number of Vehicle Registration Marks  counted  in Group.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="QueueVehicleTypeRef" type="CctvVehicleTypeIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Type of vehicle.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="QueueEstimatedSpeed" type="Speed" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Estimate speed of queue.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="QueueCountPeriod" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Interval  over which  count has been made. Duration in minutes.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- =============================================================== -->	<xsd:element name="CctvFlowDynamic" type="CctvFlowDynamicStructure" abstract="false" substitutionGroup="CctvDynamic">		<xsd:annotation>			<xsd:documentation>Cc TV Object  Dynamic Flow.. Freeflow extension.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="CctvFlowDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Cc TV   Dynamic Flow.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="CctvDynamicStructure">				<xsd:sequence>					<xsd:sequence>						<xsd:group ref="CctvFlowDynamicGroup"/>					</xsd:sequence>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="CctvFlowDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Cc TV  Traffic Flow  Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CountPeriod" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Interval  over which  count has been made. Duration in minutes.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="CctvVehicleTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to a CCTV Vehicle Type Definition. Freeflow extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="VehicleCount" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Number of Vehicles counted. </xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<!-- ======================================================================= -->	<xsd:group name="CctvDeviceGroup">		<xsd:annotation>			<xsd:documentation>Device related elements</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="history" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device History</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvHistory" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Log entry describing an event relating to CCTV equipment.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="faults" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device Faults</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvFault" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Cc TV Fault</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="commands" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device commands</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvCommand" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>A command to CCTV equipment.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Fault===================================================== -->	<xsd:element name="CctvFault" substitutionGroup="AbstractDeviceFault">		<xsd:annotation>			<xsd:documentation>Cc TV Fault.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractDeviceFaultStructure">					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="FaultTypeRef" type="CctvFaultTypeIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Type of fault.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractDeviceFaultGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ====Command========================================================== -->	<xsd:element name="CctvCommand" substitutionGroup="AbstractDeviceCommand">		<xsd:annotation>			<xsd:documentation>Cc TV Command.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractDeviceCommandStructure">					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="DeviceCommandRequestGroup"/>						<xsd:group ref="DeviceCommandResponseGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ====Device History===================================================== -->	<xsd:simpleType name="CctvLogIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Cctv  Device History.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="LogIdType"/>	</xsd:simpleType>	<xsd:element name="CctvHistory" substitutionGroup="AbstractDeviceHistory">		<xsd:annotation>			<xsd:documentation>Cctv Device History.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractDeviceHistoryStructure">					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="CctvIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="LogId" type="CctvLogIdType">							<xsd:annotation>								<xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractDeviceHistoryGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<!-- ====Static===================================================== -->	<xsd:element name="CctvStatic" substitutionGroup="AbstractStatic">		<xsd:annotation>			<xsd:documentation>Cc TV Data Object Static Data</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:extension base="AbstractSystemObjectStructure">					<xsd:sequence>						<xsd:group ref="CctvStaticGroup"/>					</xsd:sequence>				</xsd:extension>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:group name="CctvStaticGroup">		<xsd:annotation>			<xsd:documentation>Static Value Elements specific to Cc TV.  </xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="types" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Types of Cc TV.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:group ref="DeviceTypeDefinitionsGroup"/>						<xsd:group ref="CctvTypeDefinitionsGroup"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="qualityStatements" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Quality Statements. </xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvQuality" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Cc TV Quality Statements</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="faultTypes" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device Faults.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="CctvFaultTypeDefinition" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Cc TV Fault</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="CctvTypeDefinitionsGroup">		<xsd:annotation>			<xsd:documentation>Type definition Elements specific to Cc tv.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="CctvTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="LaneDirectionTypeDefinition"/>		</xsd:sequence>	</xsd:group>	<!-- ===Object Type=========================================================== -->	<xsd:element name="CctvTypeRef" type="CctvTypeIdType" substitutionGroup="DeviceTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a CCTV Type Definition.1 = Colour CCD camera,2 = B/W CCD camera,3 = Colour CCTV tube camera,4 = B/W CCTV tube camera,5 = ANPR camera,999 = Other.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="CctvTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Identifier of  Cc TV Data Object Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Colour CCD"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Black and White CCD"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Colour CCTVTube"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Black and White CCTV Tube"/>			<xsd:enumeration value="5"/>			<xsd:enumeration value="ANPR"/>			<xsd:enumeration value="999"/>			<xsd:enumeration value="Other"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:simpleType name="CctvTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of  Cc TV Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="CctvTypeDefinition" substitutionGroup="DataObjectTypeDefinition">		<xsd:annotation>			<xsd:documentation>Cc TV Camera  Type Definition.1 = Colour CCD camera,2 = B/W CCD camera,3 = Colour CCTV tube camera,4 = B/W CCTV tube camera,5 = ANPR camera,999 = Other,</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="CctvTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="CctvVehicleTypeRef" type="CctvVehicleTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a CCTV Vehicle Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="CctvVehicleTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of  of Cc TV  Vehicle Type Definition.  Freeflow Extension</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="CctvVehicleTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation> Cctv Vehicle Type  Definition.   Freeflow Extension</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="CctvVehicleTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Quality==================================================== -->	<xsd:simpleType name="CctvQualityIdType">		<xsd:annotation>			<xsd:documentation>Type for Quality Id for Cctv Camera.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="QualityIdType"/>	</xsd:simpleType>	<xsd:element name="CctvQuality" substitutionGroup="AbstractQuality">		<xsd:annotation>			<xsd:documentation>Cc TV Quality. </xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractQualityStructure">					<xsd:sequence>						<xsd:element name="QualityId" type="CctvQualityIdType">							<xsd:annotation>								<xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractQualityGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Fault Type===================================================== -->	<xsd:simpleType name="CctvFaultTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for identifiers for Fault type  Definition for Cctv Camera</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="FaultTypeIdType"/>	</xsd:simpleType>	<xsd:element name="CctvFaultTypeDefinition" substitutionGroup="AbstractFaultTypeDefinition">		<xsd:annotation>			<xsd:documentation>Cc TV Fault Type  Definition.  </xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractFaultTypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="FaultTypeId" type="CctvFaultTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier of Fault Type.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractFaultTypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="LaneDirectionTypeRef" type="LaneDirectionTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Lane Direction Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="LaneDirectionTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of  of Cc TV  Lane Direction  Definition.  ANPR  Extension</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="LaneDirectionTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation> Lane Direction Type  Definition.  ANPR   Extension</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="LaneDirectionTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element></xsd:schema>