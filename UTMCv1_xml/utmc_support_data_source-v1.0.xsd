<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_data_source">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_typeID-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes an ancillary support object used by all UTMC Data Objects.                    <ol>							<li>UTMC  Type Definition Type ( UTMC "TypeID") used to specify allowed values of Data Source. Each Data Object specifes a data source that indicates the supplier. of data.                            <ul>									<li>1   QMISS</li>									<li>2   MIDAS</li>									<li>3   NTCC</li>									<li>901 RCC (1)</li>									<li>902 RCC (2)</li>									<li>903 RCC (3)</li>									<li>904 RCC (4)</li>									<li>905 RCC (5)</li>									<li>906 RCC (6)</li>								</ul>							</li>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_support_data_source-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_typeID-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Obejct specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specifcation: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing  Data Source Type Definition,  used to specify allowed values of Data sources for UTMC Data Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ====Data Source============================================================= -->	<xsd:simpleType name="DataSourceIdEnum">		<xsd:annotation>			<xsd:documentation>Allowed values for data source type identfiers</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="QMISS"/>			<xsd:enumeration value="Midas"/>			<xsd:enumeration value="NTCC"/>			<xsd:enumeration value="901"/>			<xsd:enumeration value="902"/>			<xsd:enumeration value="903"/>			<xsd:enumeration value="904"/>			<xsd:enumeration value="905"/>			<xsd:enumeration value="906"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="DataSourceTypeDefinition" substitutionGroup="OtherTypeDefinition">		<xsd:annotation>			<xsd:documentation>Data Source  Type Definition. May be used to identify a data source, which may be either a physical (i.e.specifc server) or logical (i.e.   a network or group of servers)   data source,1 = QMISS,2 = MIDAS,3 = NTCC,901 = RCC (1),902 = RCC (2),903 = RCC (3),904 = RCC (4),905 = RCC (5),906 = RCC (6).</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="DataSourceTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= --></xsd:schema>