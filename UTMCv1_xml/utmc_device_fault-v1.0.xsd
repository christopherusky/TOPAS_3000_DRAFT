<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_device_fault">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_subsystem-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the  common properties of Fault Objects that can be associated with  UTMC  Device Data  Objects , and the associated types                    <ol>							<li>Device Fault Objects, used in:                            <ul>									<li>Access Control Fault</li>									<li>Air Quality Fault</li>									<li>Car Park Fault</li>									<li>Cctv Fault</li>									<li>Detector Fault</li>									<li>Meteorological Fault</li>									<li>Traffic Signal Fault</li>									<li>Transport Route Fault</li>									<li>Transport Link Fault</li>									<li>Variable Message Sign Fault</li>								</ul>							</li>							<li>Abstract Fault Type Definition, used in:                        <ul>									<li>Access Control Fault Type Definition</li>									<li>Air Quality Fault Type Definition</li>									<li>Car Park Fault Type Definition</li>									<li>Cctv Fault Type Definition</li>									<li>Detector Fault Type Definition</li>									<li>Meteorological Fault Type Definition</li>									<li>Traffic Signal Fault Type Definition</li>									<li>Transport Route Fault Type Definition</li>									<li>Transport Link Fault Type Definition</li>									<li>Variable Message Sign Fault Type Definition</li>								</ul>							</li>							<li>Type Objects                            <ul>									<li>Acknowledgement State Type Definition</li>								</ul>							</li>						</ol>					</p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_device_fault-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_subsystem-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<ul>						<li>Derived from the UTMC specification and SIRI standards.<ul>								<li>ts004.003annexdapr07.xls</li>								<li>ts004-004a-annexd-sep08.pdf</li>							</ul>						</li>					</ul>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing common elements of Command Faults for UTMC Device Data Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ====Fault============================================================ -->	<xsd:element name="FaultRef" type="FaultIdType">		<xsd:annotation>			<xsd:documentation>Reference to a Fault, unique within System and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="FaultIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Fault, unique within Object Type and system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="AbstractDeviceFault" type="AbstractDeviceFaultStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Device Fault. </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDeviceFaultStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Device Fault.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FaultTypeRef" type="FaultTypeIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Type of fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractDeviceFaultGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="AbstractDeviceFaultGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Fault.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CreationDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date Fault was created. This is the primary identifier for the fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which object was last updatld. Freeflow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ClearedDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>When fault was cleared.  If cleared is deemed historic.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Description" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="DeviceFaultIdentificationGroup"/>			<xsd:group ref="DeviceFaultClassificationGroup"/>			<xsd:group ref="DeviceAcknowledgmentGroup">				<xsd:annotation>					<xsd:documentation>Elements Specific to Device Acknowledgment. Acknowledgement state indicates how an operator has responded to fault information. This will allow operators to confirm that a fault has been explicitly dealt with, ignored , deferred etc.                                                                                    </xsd:documentation>				</xsd:annotation>			</xsd:group>		</xsd:sequence>	</xsd:group>	<xsd:group name="DeviceFaultIdentificationGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Fault Identification .</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:element name="FaultId" type="FaultIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Unique identifier for the fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SupplierFaultNumber" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Fault identifier allocated by the supplier/configuration manager for maintenance purposes if required.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="SubSystemTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<xsd:group name="DeviceFaultClassificationGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Fault Classifcation.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="EquipmentFault" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether it is an equipment fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="CommunicationsFault" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether it is a communications fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FaultSeverity" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Severity of the fault.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="DeviceAcknowledgmentGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Fault Acknowledgment.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="AcknowledgmentDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>When fault was acknowledged.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="AcknowledgementStateTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ====Fault Type============================================================= -->	<xsd:element name="FaultTypeRef" type="FaultTypeIdType">		<xsd:annotation>			<xsd:documentation>Reference to a Fault type. 0 = No fault,   999 -: Unknown type                     </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="FaultTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of an Fault, unique  within Object Type and system</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:element name="AbstractFaultTypeDefinition" type="AbstractFaultTypeDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Device Fault Type Definition. 0 = No fault,   999 -: Unknown type </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractFaultTypeDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Device Fault Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="FaultTypeId" type="FaultTypeIdType">				<xsd:annotation>					<xsd:documentation>Identifier of Fault Type.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractFaultTypeDefinitionGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="AbstractFaultTypeDefinitionGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Abstract Fault Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="DistributedManagementGroup"/>			<xsd:element name="FaultDescription" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of the fault type.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FaultSeverity" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Severity of the fault type. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:element ref="SubSystemTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ====Ack_state type=========================================================== -->	<xsd:element name="AcknowledgementStateTypeRef" type="AcknowledgementStateTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to an Fault Acknowledgement State Type Definition. Unique within System and type. 0 = not acknowledged,    1 = acknowledged,   2 = deferred,   3 = recorded for action.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="AcknowledgementStateTypeIdType">		<xsd:annotation>			<xsd:documentation>Type fo Identifier of Fault Acknowledgement State   type Definition. Values are as follows:  0 = not acknowledged,   1 = acknowledged,   2 = deferred,   3 = recorded for action.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="AcknowledgementStateTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Enumeration of Fault Acknowledgement State  allowed values.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Discrete command information"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Combined command information"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="AcknowledgementStateTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Fault Acknowledgment State  Type Definition.  Used in Fault Object for all devices.0 = Not acknowledged,   1 = Acknowledged,   2 = Deferred,   3 = Recorded for action.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="AcknowledgementStateTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Acknowledgement State type.  </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= --></xsd:schema>