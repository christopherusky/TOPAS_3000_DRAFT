<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1"            xmlns:xsd="http://www.w3.org/2001/XMLSchema"            xmlns:siri="http://www.siri.org.uk/siri"            targetNamespace="http://localhost/services/utmc/v1"            elementFormDefault="qualified"            attributeFormDefault="unqualified"            version="1.0"            id="utmc_data_object_car_park" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"            xsi:schemaLocation="http://www.siri.org.uk/siri ">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_device-v1.0.xsd"/>    <xsd:include schemaLocation="utmc_support_day_type-v1.0.xsd"/>    <xsd:include schemaLocation="utmc_data_object_detector-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project and UTMC XML working Group.</Contributor>                <Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>                <Contributor>UTMC and UML: Tim Wright, Tim.Wright at ipl.com;</Contributor>                <Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>                <Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;</Contributor>                <Contributor>UTMC: mark.bodger at siemens.com;</Contributor>                <Contributor>UTMC: alison.h.jones at siemens.com;</Contributor>                <Contributor>UTMC: josef.kaltwasser at heuboe.de;</Contributor>                <Contributor>UTMC: brendan mason, tenet</Contributor>                <Contributor>UTMC: mandi patel at streetmanagement.org.uk;</Contributor>                <Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>                <Contributor>UTMC: ian.skeoch at peek-traffic.co.uk;</Contributor>                <Contributor>UTMC: martin.siczkowski at acis-cam.uk.com;</Contributor>                <Contributor>UTMC: richard thurbin, richard at cloudamber.com;</Contributor>                <Contributor>UTMC: ivan.wells at highways.gsi.gov.uk;</Contributor>                <Contributor>Freeflow: dan fitzgerald at Kizoom.com</Contributor>                <Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>                <Contributor>Freeflow: rajesh K; krishnamoorthy, at imperial.ac.uk</Contributor>                <Contributor>Freeflow: rob shepherd at acis.com</Contributor>                <Contributor>Freeflow: ian routledge at acis.com</Contributor>                <Contributor>TO be COMPLETED</Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0 FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/                </Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used                        to exchange data objects between UTMC databases and other services.</p>.                    <p>This subschema describes the UTMC Car Park device Data Object and its components. These may                        include:                        <ol>                            <li>Definition, describing the fixed properties of an object and its location on the                                network.                            </li>                            <ul>                                <li>Car Park Definition</li>                            </ul>                            <li>Configuration Objects, describing configurable properties of objects, with a time of                                last change.                            </li>                            <ul>                                <li>Car Park Configuration</li>                            </ul>                            <li>Dynamic Objects, describing volatile properties of Data Objects, with a time of last                                change.                            </li>                            <ul>                                <li>Car Park Dynamic</li>                            </ul>                            <li>Device History, describing the device history which may be issued to the device.</li>                            <ul>                                <li>Car Park Device History</li>                            </ul>                            <li>Fault, describing the device faults,</li>                            <ul>                                <li>Car Park Fault</li>                            </ul>                            <li>Command, describing the commands which may be issued to the device.</li>                            <ul>                                <li>Car Park Command</li>                            </ul>                            <li>Types, describing the allowed values for types associated with Car Park data object.                            </li>                            <ul>                                <li>Car Park Quality Type Definition</li>                                <li>Car Park Fault Type Definition</li>                            </ul>                        </ol>                    </p>                    <p>The</p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_car_park-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD</Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                    <Copyright>Freeflow, UTMC 2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                        <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf -</li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,                        Public transport, Bus services, Coach services, Bus stops and stations,                        Business and industry, Transport,                        Roads and road transport                    </Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema. Subschema describing the UTMC Car Park Device Object.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ===Object ID=============================================================== -->    <xsd:element name="CarParkRef" type="CarParkIdType" substitutionGroup="DeviceRef">        <xsd:annotation>            <xsd:documentation>Simple reference to a Car Park. Unique within participant system and type.            </xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="CarParkIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of a Car Park.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="ObjectIdType"/>    </xsd:simpleType>    <xsd:complexType name="CarParkFullRefStructure">        <xsd:annotation>            <xsd:documentation>Type for full reference to a Car Park.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="ObjectFullRefStructure">                <xsd:sequence>                    <xsd:element ref="CarParkRef"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Data Object=========================================================== -->    <xsd:element name="CarPark" substitutionGroup="AbstractDeviceObject">        <xsd:annotation>            <xsd:documentation>Car Park Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="CarParkStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:sequence>                                <xsd:element ref="ParticipantRef" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Unique Identifier of a system providing data. If absent,                                            given by context. Participant identifiers should be chosen to be unique                                            across all systems so that together with SystemCodeNumber there is a unique                                            reference to each UTMC data object.                                        </xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                            <xsd:sequence>                                <xsd:element name="SystemCodeNumber" type="CarParkIdType">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of data object, unique within system and type.                                        </xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Reference to the unique Identifier of system from which                                            object originated.                                        </xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingObjectRef" type="CarParkIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of object on originating system. Unique within                                            originating system and object type.                                        </xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="CarParkGroup"/>                            <xsd:group ref="CarParkDeviceGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="CarParkStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceStructure">                <xsd:sequence>                    <xsd:group ref="CarParkGroup"/>                    <xsd:group ref="CarParkDeviceGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="definitions" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Car park defiinition. Normally there will be only one, but there may be more if                        historic values are included.                    </xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Data Definition.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="configurations" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Car Park configurations.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkCapacityConfiguration" minOccurs="0" maxOccurs="unbounded"/>                        <xsd:element ref="CarParkDetectorConfiguration" minOccurs="0" maxOccurs="unbounded"/>                        <xsd:element ref="CarParkOpeningTimesConfiguration" minOccurs="0" maxOccurs="unbounded"/>                        <xsd:element ref="CarParkTariffConfiguration" minOccurs="0" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="dynamics" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Car Park dynamic values.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkDynamic" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Definition=========================================================== -->    <xsd:element name="CarParkDefinition" substitutionGroup="AbstractDeviceDefinition">        <xsd:annotation>            <xsd:documentation>Car Park Data Object</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="CarParkDefinitionStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of Data Object. Unique within System and type. Only                                        needs to be specified if not given by context.                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="ObjectTypeRef" type="CarParkTypeIdType">                                <xsd:annotation>                                    <xsd:documentation>Type of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="QualityRef" type="CarParkQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Quality statement of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="BaseDefinitionGroup"/>                            <xsd:group ref="DefinitionDescriptionGroup">                                <xsd:annotation>                                    <xsd:documentation>UTMC Object textual description elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:group ref="PointOnPathGroup" minOccurs="0"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="OffsetObjectGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="CarParkDefinitionGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="CarParkDefinitionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceDefinitionStructure">                <xsd:sequence>                    <xsd:group ref="CarParkDefinitionGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkDefinitionGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Definition.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="CarParkBasicData" minOccurs="0"/>            <xsd:element name="accessLocations" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Definitions of entrances</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkAccessLocation" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Access Locations/Entrance</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="zones" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Network Zones in which the car park lies.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkZoneListEntry" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ====================================================== -->    <xsd:element name="CarParkBasicData" type="CarParkBasicDataStructure" abstract="false"                 substitutionGroup="AbstractListEntry">        <xsd:annotation>            <xsd:documentation>Car Park Access Locations/Entrance</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkBasicDataStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Access Location.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractListEntryStructure">                <xsd:sequence>                    <xsd:group ref="CarParkBasicDataGroup">                        <xsd:annotation>                            <xsd:documentation>Elements specific to Car Park Access Location.</xsd:documentation>                        </xsd:annotation>                    </xsd:group>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkBasicDataGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Basic Definition.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="OwnerOperator" type="xsd:normalizedString" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Name of owner or operator</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="CarParkUserType" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Public representation of car park type e.g.pay on foot.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NumberOfEntrances" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Number of entrances.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NumberOfExits" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Number of exits.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="ToiletsAvailable" type="xsd:boolean" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Toilets available.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="DisableDataToiletsAvailable" type="xsd:boolean" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Toilets for the Disabled available.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Details  ============================================================ -->    <xsd:element name="CarParkZoneListEntry" substitutionGroup="AbstractListEntry">        <xsd:annotation>            <xsd:documentation>Car Park Zone List instance - an entry in the list of car parks which contribute to the                state of the sign.            </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="CarParkZoneListEntryStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element ref="ParticipantRef" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a system providing data. If absent, given by                                        context. Participant identifiers should be chosen to be unique across all                                        systems so that together with SystemCodeNumber there is a unique reference to                                        each UTMC data object.                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Reference to Data Object. Unique within Participant system and                                        type. Onlyneeds to be specified if not given by Context                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractListEntryGroup"/>                        </xsd:sequence>                        <xsd:group ref="CarParkZoneListEntryGroup"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="CarParkZoneListEntryStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Variable Message Sign Car Park List.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractListEntryStructure">                <xsd:group ref="CarParkZoneListEntryGroup"/>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkZoneListEntryGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Variable Message Sign Car Park List</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="NetworkZoneRef"/>        </xsd:sequence>    </xsd:group>    <!-- ====================================================== -->    <xsd:element name="CarParkAccessLocation" abstract="false" substitutionGroup="AbstractListEntry">        <xsd:annotation>            <xsd:documentation>Car Park Access Locations/Entrance</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="CarParkAccessLocationStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element ref="ParticipantRef" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a system providing data. If absent, given by                                        context. Participant identifiers should be chosen to be unique across all                                        systems so that together with SystemCodeNumber there is a unique reference to                                        each UTMC data object.                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Reference toCar Park . Unique within Participant system and type.                                        Only needs to be specified if not given by Context                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractListEntryGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="CarParkAccessLocationGroup">                                <xsd:annotation>                                    <xsd:documentation>Elements specific to Car Park Access Location.                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="CarParkAccessLocationStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Access Location.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractListEntryStructure">                <xsd:sequence>                    <xsd:group ref="CarParkAccessLocationGroup">                        <xsd:annotation>                            <xsd:documentation>Elements specific to Car Park Access Location.</xsd:documentation>                        </xsd:annotation>                    </xsd:group>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkAccessLocationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Access Locations.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="EntryOrExit" type="CarParkEntranceEnum">                <xsd:annotation>                    <xsd:documentation>Entry or Exit.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="EntranceLocation" type="PointStructure" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Location indicating start of link.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NetworkPathRef" type="NetworkPathIdType" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Reference to a network Path.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element ref="TransportLinkRef" minOccurs="0"/>        </xsd:sequence>    </xsd:group>    <xsd:simpleType name="CarParkEntranceEnum">        <xsd:annotation>            <xsd:documentation>Enumeration of Car Park Access Locations.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="xsd:string">            <xsd:enumeration value="E"/>            <xsd:enumeration value="Entry"/>            <xsd:enumeration value="X"/>            <xsd:enumeration value="Exit"/>        </xsd:restriction>    </xsd:simpleType>    <!-- ===Object Configuration===================================================== -->    <xsd:element name="CarParkConfiguration" type="CarParkConfigurationStructure" abstract="true"                 substitutionGroup="AbstractConfiguration">        <xsd:annotation>            <xsd:documentation>Abstract Car Park Tariff Configuration Object</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Capacity Configuration</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:restriction base="AbstractConfigurationStructure">                <xsd:sequence>                    <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                        <xsd:annotation>                            <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.                            </xsd:documentation>                        </xsd:annotation>                    </xsd:element>                    <xsd:group ref="AbstractConfigurationGroup"/>                </xsd:sequence>            </xsd:restriction>        </xsd:complexContent>    </xsd:complexType>    <!-- ======================================================================= -->    <xsd:element name="CarParkCapacityConfiguration" type="CarParkCapacityConfigurationStructure"                 substitutionGroup="CarParkConfiguration">        <xsd:annotation>            <xsd:documentation>Car Park Object Capacity Configuration.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkCapacityConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Capacity Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="CarParkConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="CarParkCapacityConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkCapacityConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Capacity Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="CarParkCapacity" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Total number of spaces.                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="DisabledCapacity" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Number of disabled spaces.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:group ref="CarParkCapacityThresholdsGroup"/>        </xsd:sequence>    </xsd:group>    <xsd:group name="CarParkCapacityThresholdsGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Capacity Threshold.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="AlmostFullIncreasing" type="NumberOfVehicles" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Value above which car park is almost full. Abbreviated to AFI.                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="AlmostFullDecreasing" type="NumberOfVehicles" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Value below which car park has spaces. Abbreviated to AFD. Must be less than                        AFI                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="FullIncreasing" type="NumberOfVehicles" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Value above which car park is full. Abbreviated to FI. Must be greater than                        AFI.                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="FullDecreasing" type="NumberOfVehicles" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Value below which car park becomes almost full from full. Abbreviated to FD. Must                        be less than FI and more than AFI                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="EntranceFull" type="NumberOfVehicles" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Value above which car park is full at its entrance.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ======================================================================= -->    <xsd:element name="CarParkTariffConfiguration" type="CarParkTariffConfigurationStructure"                 substitutionGroup="CarParkConfiguration">        <xsd:annotation>            <xsd:documentation>Car Park Object Tariff Configuration.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkTariffConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Tariff Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="CarParkConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="CarParkTariffConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkTariffConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Tariff Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="DayTypeRef" minOccurs="0"/>            <xsd:element name="TimePeriod" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>A range of times.                    </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="Cost" type="Amount" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Rate for this period in national currency.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ======================================================================= -->    <xsd:element name="CarParkOpeningTimesConfiguration" type="CarParkOpeningTimesConfigurationStructure"                 substitutionGroup="CarParkConfiguration">        <xsd:annotation>            <xsd:documentation>Car Park Object Opening Times Configuration.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkOpeningTimesConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Opening Times Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="CarParkConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="CarParkOpeningTimesConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkOpeningTimesConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Opening Times Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="DayTypeRef" minOccurs="0"/>            <xsd:element name="OpeningTime" type="xsd:time" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>A time of day car park opens.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="ClosingTime" type="xsd:time" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>A time of day car park closes.                    </xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ======================================================================= -->    <xsd:element name="CarParkDetectorConfiguration" type="CarParkDetectorConfigurationStructure"                 substitutionGroup="CarParkConfiguration">        <xsd:annotation>            <xsd:documentation>Car Park Detector Configuration.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="CarParkDetectorConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Detector Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="CarParkConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="CarParkDetectorConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkDetectorConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Detector Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="DetectorRef" minOccurs="0"/>        </xsd:sequence>    </xsd:group>    <!-- ===Object Dynamic============================================================ -->    <xsd:element name="CarParkDynamic" abstract="false" substitutionGroup="AbstractDynamic">        <xsd:annotation>            <xsd:documentation>Car Park Object Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="CarParkDynamicStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by                                        context.                                    </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractDynamicGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="CarParkDynamicGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="CarParkDynamicStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Car Park Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDynamicStructure">                <xsd:sequence>                    <xsd:group ref="CarParkDynamicGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="CarParkDynamicGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="CarParkStateTypeRef" minOccurs="0"/>            <xsd:element name="Occupancy" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Number of occupied spaces.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="OccupancyPercentage" type="Percentage" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>occupancy*100/Capacity.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="FillRate" type="VehiclesPerMinute" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Rate in vehicles per minute.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="ExitRate" type="VehiclesPerMinute" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Rate in vehicles per minute.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="QueueTime" type="xsd:duration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Time (minutes) to wait to gain entrance</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element ref="OccupancyTrendTypeRef" minOccurs="0"/>        </xsd:sequence>    </xsd:group>    <!-- ===Device===================================================== -->    <xsd:group name="CarParkDeviceGroup">        <xsd:annotation>            <xsd:documentation>Device related elements.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="history" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device History.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkHistory" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Device History</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faults" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkFault" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="commands" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device commands.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkCommand" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Command</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Fault===================================================== -->    <xsd:element name="CarParkFault" substitutionGroup="AbstractDeviceFault">        <xsd:annotation>            <xsd:documentation>Car Park Fault.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceFaultStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique within System and type. Only needs                                    to be specified if not given by context.                                </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="FaultTypeRef" type="CarParkFaultTypeIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Type of fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceFaultGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Command========================================================== -->    <xsd:element name="CarParkCommand" substitutionGroup="AbstractDeviceCommand">        <xsd:annotation>            <xsd:documentation>Car Park Command.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceCommandStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique within System and type. Only needs                                    to be specified if not given by context.                                </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="DeviceCommandRequestGroup"/>                        <xsd:group ref="DeviceCommandResponseGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Device History===================================================== -->    <xsd:simpleType name="CarParkLogIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Car Park Device History.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="LogIdType"/>    </xsd:simpleType>    <xsd:element name="CarParkHistory" substitutionGroup="AbstractDeviceHistory">        <xsd:annotation>            <xsd:documentation>Car Park Device History.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceHistoryStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="CarParkIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by                                    context.                                </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="LogId" type="CarParkLogIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceHistoryGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ========================================================== -->    <!-- ====Static===================================================== -->    <xsd:element name="CarParkStatic" substitutionGroup="AbstractStatic">        <xsd:annotation>            <xsd:documentation>Car Park Data Object Static.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:extension base="AbstractSystemObjectStructure">                    <xsd:sequence>                        <xsd:group ref="CarParkStaticGroup"/>                    </xsd:sequence>                </xsd:extension>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:group name="CarParkStaticGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Car Park Static.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="types" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Types of Car Park.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="DeviceTypeDefinitionsGroup"/>                        <xsd:group ref="CarParkTypeDefinitionsGroup"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="qualityStatements" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality Statements.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkQuality" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Quality Statements.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faultTypes" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="CarParkFaultTypeDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Car Park Fault Type Definition.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="CarParkTypeDefinitionsGroup">        <xsd:annotation>            <xsd:documentation>Type definition Elements specific to Car Park</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="CarParkTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="CarParkStateTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="OccupancyTrendTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="OccupancyStatusTypeDefinition" minOccurs="0" maxOccurs="unbounded">                <xsd:annotation>                    <xsd:documentation>Queue Severity Type.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Type=========================================================== -->    <xsd:element name="CarParkTypeRef" type="CarParkTypeIdType" substitutionGroup="DeviceTypeRef">        <xsd:annotation>            <xsd:documentation>Reference to a Car Park Type Definition.                1 = Intelligent (OTU),                2 = Intelligent (OTU) with Closed Bit,                3 = Unintelligent,                4 = Unintelligent with Closed Bit,                5 = BCD with Closed Bit,                6 = Pay and Display,                7 = Pay on Foot,                8 = Intelligent (Serial),                9 = Static (No real-time data),                999 = Other.            </xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="CarParkTypeIdType">        <xsd:annotation>            <xsd:documentation>Identifier of Car Park Type Definition.                1: Intelligent (OTU),                2: Intelligent (OTU) with Closed Bit,                3: Unintelligent,                4: Unintelligent with Closed Bit,                5: BCD with Closed Bit,                6: Pay and Display,                7: Pay on Foot,                8: Intelligent (Serial),                9: Static (No real-time data),                999: Other            </xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:simpleType name="CarParkTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Allowed values for Car Park Type Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="Intelligent (OTU)"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="Intelligent (OTU) with Closed Bit"/>            <xsd:enumeration value="3"/>            <xsd:enumeration value="Unintelligent"/>            <xsd:enumeration value="4"/>            <xsd:enumeration value="Unintelligent with Closed Bit"/>            <xsd:enumeration value="5"/>            <xsd:enumeration value="BCD with Closed Bit"/>            <xsd:enumeration value="6"/>            <xsd:enumeration value="Pay and Display"/>            <xsd:enumeration value="7"/>            <xsd:enumeration value="PayOnFoot"/>            <xsd:enumeration value="8"/>            <xsd:enumeration value="Intelligent (Serial)"/>            <xsd:enumeration value="9"/>            <xsd:enumeration value="Static (No real-time data)"/>            <xsd:enumeration value="etc"/>        </xsd:restriction>    </xsd:simpleType>    <xsd:element name="CarParkTypeDefinition" substitutionGroup="DataObjectTypeDefinition">        <xsd:annotation>            <xsd:documentation>Car Park Type Definition.                1 = Intelligent (OTU),                2 = Intelligent (OTU) with Closed Bit,                3 = Unintelligent,                4 = Unintelligent with Closed Bit,                5 = BCD with Closed Bit,                6 = Pay and Display,                7 = Pay on Foot,                8 = Intelligent (Serial),                9 = Static (No real-time data),                999 = Other            </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="CarParkTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Car Park type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ======================================================================= -->    <xsd:element name="CarParkStateTypeRef" type="CarParkStateTypeIdType" substitutionGroup="DataValueTypeRef">        <xsd:annotation>            <xsd:documentation>Reference to a Car Park State Type Definition.                1 = Faulty,                2 = Spaces,                3 = Almost Full,                4 = Full,                5 = Closed,                6 = Open,                999 = Other.            </xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="CarParkStateTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Car Park State Type Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:simpleType name="CarParkStateTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Allowed values for of Car Park Status types Definitions.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="Faulty"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="Spaces"/>            <xsd:enumeration value="3"/>            <xsd:enumeration value="AlmostFull"/>            <xsd:enumeration value="4"/>            <xsd:enumeration value="Full"/>            <xsd:enumeration value="5"/>            <xsd:enumeration value="Closed"/>            <xsd:enumeration value="6"/>            <xsd:enumeration value="Open"/>            <xsd:enumeration value="999"/>            <xsd:enumeration value="Other"/>        </xsd:restriction>    </xsd:simpleType>    <xsd:element name="CarParkStateTypeDefinition" substitutionGroup="ValueTypeDefinition">        <xsd:annotation>            <xsd:documentation>Car Park State Type Definition. Used on Car Park.                1 = Faulty,                2 = Spaces,                3 = Almost Full,                4 = Full,                5 = Closed,                6 = Open,                999 = Other.            </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="CarParkStateTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Car Park State type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ========================================================== -->    <xsd:element name="OccupancyTrendTypeRef" type="OccupancyTrendTypeIdType" substitutionGroup="DataValueTypeRef">        <xsd:annotation>            <xsd:documentation>Reference to a Car Park Occupancy Trend Type Definition.                1 = Down/Decreasing,                2 = Stay/Static,                3 = Up/Increasing,                999 = Other.            </xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="OccupancyTrendTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Car Park Trend.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:simpleType name="OccupancyTrendTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Allowed values for of Car Park Trend types.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="Down/Decreasing"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="Stay/Static"/>            <xsd:enumeration value="3"/>            <xsd:enumeration value="Up/Increasing"/>            <xsd:enumeration value="999"/>            <xsd:enumeration value="Other"/>        </xsd:restriction>    </xsd:simpleType>    <xsd:element name="OccupancyTrendTypeDefinition" substitutionGroup="ValueTypeDefinition">        <xsd:annotation>            <xsd:documentation>Car Park Occupancy Trend Type Definition. Used on Car Park.                1 = Down/Decreasing,                2 = Stay/Static,                3 = Up/Increasing,                999 = Other.            </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="OccupancyTrendTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Car Park Occupancy Trend Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ===Quality==================================================== -->    <xsd:simpleType name="CarParkQualityIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Car Park Quality.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="QualityIdType"/>    </xsd:simpleType>    <xsd:element name="CarParkQuality" substitutionGroup="AbstractQuality">        <xsd:annotation>            <xsd:documentation>Car Park Quality.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractQualityStructure">                    <xsd:sequence>                        <xsd:element name="QualityId" type="CarParkQualityIdType">                            <xsd:annotation>                                <xsd:documentation>identifier of quality Statement. Unique within object type and                                    system.                                </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractQualityGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ===Fault Type===================================================== -->    <xsd:simpleType name="CarParkFaultTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for identifier of Fault Type Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="FaultTypeIdType"/>    </xsd:simpleType>    <xsd:element name="CarParkFaultTypeDefinition" substitutionGroup="AbstractFaultTypeDefinition">        <xsd:annotation>            <xsd:documentation>Car Park Fault Type Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractFaultTypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="FaultTypeId" type="CarParkFaultTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Fault Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractFaultTypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element></xsd:schema>