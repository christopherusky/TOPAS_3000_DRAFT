<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_access_control">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_device-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project and UTMC XML working Group. </Contributor>                <Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>                <Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>                <Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>                <Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>                <Contributor>UTMC: mark.bodger at siemens.com; </Contributor>                <Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>                <Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>                <Contributor>UTMC: brendan mason, tenet </Contributor>                <Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>                <Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>                <Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>                <Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>                <Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>                <Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>                <Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>                <Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>                <Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>                <Contributor>Freeflow: rob shepherd at acis.com</Contributor>                <Contributor>Freeflow: ian routledge at acis.com</Contributor>                <Contributor>TO be COMPLETED  </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Access Control device Data Object and its components. These may include:                    <ol>                            <li>Definition, describing the fixed properties of an object and its location on the network.</li>                            <ul>                                <li>Access Control Definition</li>                            </ul>                            <li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>                            <ul>                                <li>Access Control Configuration</li>                            </ul>                            <li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>                            <ul>                                <li>Access Control Dynamic</li>                            </ul>                            <li>Device History, describing the device history which may be issued to the device.</li>                            <ul>                                <li>Access Control Device History</li>                            </ul>                            <li>Fault, describing the device  faults,</li>                            <ul>                                <li>Access Control Fault</li>                            </ul>                            <li>Command, describing the commands which may be issued to the device.</li>                            <ul>                                <li>Access Control Command</li>                            </ul>                            <li>Types, describing the allowed values for types associated with Access Controls.</li>                            <ul>                                <li>Access Control Type Definition</li>                                <li>Access Control State Type Definition</li>                                <li>Access Control Quality Type Definition</li>                                <li>Access Control Fault  Type Definition</li>                            </ul>                        </ol>                    </p>                    <p>The </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_access_control-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires> >                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing the UTMC Access Control Device Object.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ===Object ID=============================================================== -->    <xsd:simpleType name="AccessControlIdType">        <xsd:annotation>            <xsd:documentation>Type for identifier of for Access Control</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="ObjectIdType"/>    </xsd:simpleType>    <xsd:element name="AccessControlRef" type="AccessControlIdType" substitutionGroup="DeviceRef">        <xsd:annotation>            <xsd:documentation>Simple reference to a Access Control  </xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="AccessControlFullRefStructure">        <xsd:annotation>            <xsd:documentation>Type for full reference to a Access Control. </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="ObjectFullRefStructure">                <xsd:sequence>                    <xsd:element ref="AccessControlRef"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Data Object=========================================================== -->    <xsd:element name="AccessControl" substitutionGroup="AbstractDeviceObject">        <xsd:annotation>            <xsd:documentation>Access Control Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AccessControlStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:sequence>                                <xsd:element ref="ParticipantRef" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                            <xsd:sequence>                                <xsd:element name="SystemCodeNumber" type="AccessControlIdType">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingObjectRef" type="AccessControlIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AccessControlGroup"/>                            <xsd:group ref="AccessControlDeviceGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AccessControlStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Access Control.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceStructure">                <xsd:sequence>                    <xsd:group ref="AccessControlGroup"/>                    <xsd:group ref="AccessControlDeviceGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AccessControlGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Access Control.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="definitions" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Access Control defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlDefinition" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="configurations" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Access Control configurations.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlConfiguration" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="dynamics" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Access Control dynamic values.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlDynamic" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Definition=========================================================== -->    <xsd:element name="AccessControlDefinition" substitutionGroup="AbstractDeviceDefinition">        <xsd:annotation>            <xsd:documentation>Access Control Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AccessControlDefinitionStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="ObjectTypeRef" type="AccessControlTypeIdType">                                <xsd:annotation>                                    <xsd:documentation>Type of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="QualityRef" type="AccessControlQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Quality statement of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="BaseDefinitionGroup"/>                            <xsd:group ref="DefinitionDescriptionGroup">                                <xsd:annotation>                                    <xsd:documentation>UTMC Object textual description elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:group ref="PointOnPathGroup" minOccurs="0"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="OffsetObjectGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AccessControlDefinitionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Access Control.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceDefinitionStructure">                <xsd:sequence>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Object Configuration===================================================== -->    <xsd:element name="AccessControlConfiguration" abstract="false" substitutionGroup="AbstractConfiguration">        <xsd:annotation>            <xsd:documentation>Access Control Object  Dynamic Values.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AccessControlConfigurationStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractConfigurationGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AccessControlConfigurationGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AccessControlConfigurationStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for  Access Control Capacity Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="AccessControlConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AccessControlConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Access Control Capacity Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="DefaultStateTypeRef" type="AccessControlStateTypeIdType" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>State that the Access Control sits in by default.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Dynamic============================================================ -->    <xsd:element name="AccessControlDynamic" abstract="false" substitutionGroup="AbstractDynamic">        <xsd:annotation>            <xsd:documentation>Access Control Object  Dynamic Values.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AccessControlDynamicStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractDynamicGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AccessControlDynamicGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AccessControlDynamicStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for  UTMC Access Control   Dynamic Values.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDynamicStructure">                <xsd:sequence>                    <xsd:group ref="AccessControlDynamicGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AccessControlDynamicGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Access Control Dynamic Values.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="Active" type="xsd:boolean" default="true" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Whether  the access_control is active (default is true).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element ref="AccessControlStateTypeRef" minOccurs="0"/>            <xsd:element name="Flow" type="VehiclesPerInterval" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Flow through the control point. Vehicle count in the prescribed interval.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="FlowInterval" type="xsd:duration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Interval for flow measurement.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Device===================================================== -->    <xsd:group name="AccessControlDeviceGroup">        <xsd:annotation>            <xsd:documentation>Device related elements.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="history" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device History.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlHistory" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Access Control Device History</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faults" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlFault" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Access Control Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="commands" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device commands.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlCommand" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Access Control Command</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Fault===================================================== -->    <xsd:element name="AccessControlFault" substitutionGroup="AbstractDeviceFault">        <xsd:annotation>            <xsd:documentation>Access Control Fault.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceFaultStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="FaultTypeRef" type="AccessControlFaultTypeIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Type of fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceFaultGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Command========================================================== -->    <xsd:element name="AccessControlCommand" substitutionGroup="AbstractDeviceCommand">        <xsd:annotation>            <xsd:documentation>Access Control Command.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceCommandStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="DeviceCommandRequestGroup"/>                        <xsd:group ref="DeviceCommandResponseGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Device History===================================================== -->    <xsd:simpleType name="AccessControlLogIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Access Control Device History.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="LogIdType"/>    </xsd:simpleType>    <xsd:element name="AccessControlHistory" substitutionGroup="AbstractDeviceHistory">        <xsd:annotation>            <xsd:documentation>Access Control Device History.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceHistoryStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AccessControlIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="LogId" type="AccessControlLogIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceHistoryGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ========================================================== -->    <!-- ====Static===================================================== -->    <xsd:element name="AccessControlStatic" substitutionGroup="AbstractStatic">        <xsd:annotation>            <xsd:documentation>Access Control Data Object Static Data.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:extension base="AbstractSystemObjectStructure">                    <xsd:sequence>                        <xsd:group ref="AccessControlStaticGroup"/>                    </xsd:sequence>                </xsd:extension>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:group name="AccessControlStaticGroup">        <xsd:annotation>            <xsd:documentation>Static Elements specific to Access Control.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="types" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Types of Access Control.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="DeviceTypeDefinitionsGroup"/>                        <xsd:group ref="AccessControlTypeDefinitionsGroup"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="qualityStatements" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality Statements. </xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlQuality" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Access Control Quality Statements</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faultTypes" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AccessControlFaultTypeDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Access Control Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="AccessControlTypeDefinitionsGroup">        <xsd:annotation>            <xsd:documentation>Type definition Elements specific to Access Control .</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="AccessControlTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="AccessControlStateTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>        </xsd:sequence>    </xsd:group>    <!-- ===Object Type=========================================================== -->    <xsd:element name="AccessControlTypeRef" type="AccessControlTypeIdType" substitutionGroup="DeviceTypeRef">        <xsd:annotation>            <xsd:documentation>Reference to an Access Control Type definition  1 = Bollard,2 = Barrier,3 = Gate,4 = Sign,999 = Other.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="AccessControlTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Enumeration of allowed Access Control  Types.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="Bollard"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="Barrier"/>            <xsd:enumeration value="3"/>            <xsd:enumeration value="Gate"/>            <xsd:enumeration value="4"/>            <xsd:enumeration value="Sign"/>            <xsd:enumeration value="5"/>            <xsd:enumeration value="Other"/>        </xsd:restriction>    </xsd:simpleType>    <xsd:simpleType name="AccessControlTypeIdType">        <xsd:annotation>            <xsd:documentation>Identifier of allowed Access Control Type Definition. 1 = Bollard2 = Barrier3 = Gate4 = Sign999 = Other</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:element name="AccessControlTypeDefinition" substitutionGroup="DataObjectTypeDefinition">        <xsd:annotation>            <xsd:documentation>Access Control Type Definition. 1 = Bollard,2 = Barrier,3 = Gate,4 = Sign,999 = Other.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="AccessControlTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Access Control State type.  </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- =====States=========================================================== -->    <xsd:element name="AccessControlStateTypeRef" type="AccessControlStateTypeIdType" substitutionGroup="DataValueTypeRef">        <xsd:annotation>            <xsd:documentation>identifier of Access Control State Type Definition. 1 = Access Enabled,2 = Access Disabled,999 = Other.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="AccessControlStateTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Access Control  State types.1 = Access Enabled2 = Access Disabled999 = Other</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:simpleType name="AccessControlStateTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Enumeration of Access Control  State types.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="Access Enabled"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="Access Disabled"/>            <xsd:enumeration value="Other"/>        </xsd:restriction>    </xsd:simpleType>    <xsd:element name="AccessControlStateTypeDefinition" substitutionGroup="ValueTypeDefinition">        <xsd:annotation>            <xsd:documentation>Access Control State Type Definition. 1 = Access Enabled,2 = Access Disabled,999 = Other.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="AccessControlStateTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Access Control State type.  </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ===Quality==================================================== -->    <xsd:simpleType name="AccessControlQualityIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of