<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2005 rel. 3 U (http://www.altova.com) by Nick Knowles (Kizoom) --><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_device_history">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_network_base-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_utility-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>. 					<p>This subschema describes the  common properties of Device History Objects that can be associated with  UTMC  Device Data  Objects ,					<ul>							<li>Device History  Objects</li>							<ul>								<li>Access Control History</li>								<li>Air Quality History</li>								<li>Car Park History</li>								<li>Cctv History</li>								<li>Detector History</li>								<li>Meteorological History</li>								<li>Traffic Signal History</li>								<li>Transport Route History</li>								<li>Transport Link History</li>								<li>Variable Message Sign History</li>							</ul>						</ul>					</p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_device_fault-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_network_base-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility-v1.0.xsd</Requires>					</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<ul>						<li>Derived from the UTMC specification and SIRI standards.<ul>								<li>ts004.003annexdapr07.xls</li>								<li>ts004-004a-annexd-sep08.pdf</li>							</ul>						</li>					</ul>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing common elements of Device Hostory elements for UTMC Device Data Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:element name="LogRef" type="LogIdType" abstract="false">		<xsd:annotation>			<xsd:documentation>Reference to a Log entry.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="LogIdType">		<xsd:annotation>			<xsd:documentation>Data Type for unique  Identifier of an Object within Object Type.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<!-- ======================================================================= -->	<xsd:element name="AbstractDeviceHistory" type="AbstractDeviceHistoryStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Device History</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDeviceHistoryStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Device History.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LogId" type="LogIdType">				<xsd:annotation>					<xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractDeviceHistoryGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="AbstractDeviceHistoryGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Abstract Device History.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="LogDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date/time at which the log entry was made. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LogEntry" type="xsd:string">				<xsd:annotation>					<xsd:documentation>Equipment log data.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LogUser" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>User who created log entry.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= --></xsd:schema>