<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_quality">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_typeID-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes an ancillary Quality support objects used by all UTMC Data Objects.                    <ol>							<li>UTMC  Abstract Quality   used to specify   common values of a Quality Statement. Each Data Object has a set of Quality types which may be associated with it.                             <ol>									<li>Device Quality Objects                                    <ul>											<li>Access Control Quality</li>											<li>Air Quality Quality</li>											<li>Car Park Quality</li>											<li>Cctv Quality</li>											<li>Detector Quality</li>											<li>Meteorological Quality</li>											<li>Traffic Signal Quality</li>											<li>Transport Route Quality</li>											<li>Transport Link Quality</li>											<li>Variable Message Sign</li>										</ul>									</li>									<li>Traffic Event Quality Objects                                     <ul>											<li>Accident Quality</li>											<li>Event Quality</li>											<li>Incident Quality</li>											<li>Roadworks Quality</li>										</ul>									</li>								</ol>							</li>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_support_quality-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_typeID-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specifcation: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing  Quality  Definition,  used to specify allowed values of of Quality Statements</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ====Quality============================================================ -->	<xsd:element name="QualityRef" type="QualityIdType" abstract="true">		<xsd:annotation>			<xsd:documentation>Reference to a Quality element System and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="QualityIdType">		<xsd:annotation>			<xsd:documentation>Type for abstract identifier of Quality </xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:element name="AbstractQuality" type="AbstractQualityStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Data Object Quality Statement.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:group name="AbstractQualityGroup">		<xsd:annotation>			<xsd:documentation>Elements for Data Object Quality Statement.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="DistributedManagementGroup"/>			<xsd:element name="SourceName" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Source of the data.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:element name="SourceType" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of teh source tupe.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="GraphicPresentationGroup"/>		</xsd:sequence>	</xsd:group>	<xsd:complexType name="AbstractQualityStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract  Data Object Quality Statement.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="QualityId" type="QualityIdType">				<xsd:annotation>					<xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractQualityGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<!-- ======================================================================= --></xsd:schema>