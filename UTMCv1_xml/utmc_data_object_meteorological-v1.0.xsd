<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_meteorological">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_device-v1.0.xsd"/>    <xsd:include schemaLocation="utmc_support_meteorological-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project and UTMC XML working Group. </Contributor>                <Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>                <Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>                <Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>                <Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>                <Contributor>UTMC: mark.bodger at siemens.com; </Contributor>                <Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>                <Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>                <Contributor>UTMC: brendan mason, tenet </Contributor>                <Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>                <Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>                <Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>                <Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>                <Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>                <Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>                <Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>                <Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>                <Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>                <Contributor>Freeflow: rob shepherd at acis.com</Contributor>                <Contributor>Freeflow: ian routledge at acis.com</Contributor>                <Contributor>TO be COMPLETED  </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Meteorological device Data Object and its components. These may include:                    <ol>                            <li>Definition, describing the fixed properties of an object and its location on the network.</li>                            <ul>                                <li>Meteorological Definition</li>                            </ul>                            <li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>                            <ul>                                <li>Meteorological Configuration</li>                            </ul>                            <li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>                            <ul>                                <li>Meteorological Dynamic</li>                            </ul>                            <li>Device History, describing the device history which may be issued to the device.</li>                            <ul>                                <li>Meteorological Device History</li>                            </ul>                            <li>Fault, describing the device  faults,</li>                            <ul>                                <li>Meteorological Fault</li>                            </ul>                            <li>Command, describing the commands which may be issued to the device.</li>                            <ul>                                <li>Meteorological Command</li>                            </ul>                            <li>Types, describing the allowed values for types associated with Meteorological data object.</li>                            <ul>                                <li>Meteorological Quality Type Definition</li>                                <li>Meteorological Fault Type Definition</li>                            </ul>                        </ol>                    </p>                    <p>The </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_meteorological-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_meteorological-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing the UTMC Meteorological Device Object.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ===Object ID=============================================================== -->    <xsd:element name="MeteorologicalRef" type="MeteorologicalIdType" substitutionGroup="DeviceRef">        <xsd:annotation>            <xsd:documentation>Reference to a Meteorological Data Object. Unique within Participant system and type.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="MeteorologicalIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of  Meteorological Object.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="ObjectIdType"/>    </xsd:simpleType>    <xsd:complexType name="MeteorologicalFullRefStructure">        <xsd:annotation>            <xsd:documentation>Type for full reference to a Meteorological Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="ObjectFullRefStructure">                <xsd:sequence>                    <xsd:element ref="MeteorologicalRef"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Object Type=========================================================== -->    <xsd:element name="Meteorological" substitutionGroup="AbstractDeviceObject">        <xsd:annotation>            <xsd:documentation>Meteorological Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="MeteorologicalStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:sequence>                                <xsd:element ref="ParticipantRef" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                            <xsd:sequence>                                <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingObjectRef" type="MeteorologicalIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="MeteorologicalGroup"/>                            <xsd:group ref="MeteorologicalDeviceGroup">                                <xsd:annotation>                                    <xsd:documentation>Meteorological Device elements</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="MeteorologicalStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Meteorological Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceStructure">                <xsd:sequence>                    <xsd:group ref="MeteorologicalGroup"/>                    <xsd:group ref="MeteorologicalDeviceGroup">                        <xsd:annotation>                            <xsd:documentation>Meteorological Device elements</xsd:documentation>                        </xsd:annotation>                    </xsd:group>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="MeteorologicalGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="definitions" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Route defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalDefinition" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="dynamics" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Meteorological dynamic values.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalDynamic" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Definition===================================================== -->    <xsd:element name="MeteorologicalDefinition" substitutionGroup="AbstractDeviceDefinition">        <xsd:annotation>            <xsd:documentation>Meteorological Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="MeteorologicalDefinitionStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="ObjectTypeRef" type="MeteorologicalTypeIdType">                                <xsd:annotation>                                    <xsd:documentation>Type of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="QualityRef" type="MeteorologicalQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Quality statement of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="BaseDefinitionGroup"/>                            <xsd:group ref="DefinitionDescriptionGroup">                                <xsd:annotation>                                    <xsd:documentation>UTMC Object textual description elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:group ref="PointOnPathGroup" minOccurs="0"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="OffsetObjectGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="MeteorologicalDefinitionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Meteorological Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceDefinitionStructure">                <xsd:sequence>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Object Configuration===================================================== -->    <!-- ===Object Dynamic============================================================ -->    <xsd:element name="MeteorologicalDynamic" abstract="false" substitutionGroup="AbstractDynamic">        <xsd:annotation>            <xsd:documentation>Meteorological  Dynamic  </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="MeteorologicalDynamicStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractDynamicGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="MeteorologicalDynamicGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="MeteorologicalDynamicStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for   Meteorological   Dynamic  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDynamicStructure">                <xsd:sequence>                    <xsd:group ref="MeteorologicalDynamicGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ======================================================================= -->    <xsd:group name="MeteorologicalDynamicGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic  </xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="Forecast" type="xsd:boolean" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Whether the data is forecast or actual. false  is actual, true is forecast.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="AreaOfEffect" type="xsd:decimal" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>General area in kilometers radius from device center.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:group ref="MeteorologicalRoadGroup"/>            <xsd:group ref="MeteorologicaVisibilityGroup"/>            <xsd:group ref="MeteorologicalPrecipitationGroup"/>            <xsd:group ref="MeteorologicalTemperatureGroup"/>            <xsd:element name="Humidity" type="Humidity" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Current humidity level. Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="Pressure" type="Pressure" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Atmospheric pressure (mB). ;Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:group ref="MeteorologicalWindGroup"/>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicalRoadGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic Road related Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="RoadConditionTypeRef" minOccurs="0"/>            <xsd:element name="RoadTemperature" type="Temperature" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Current road temperature (degrees C).</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicalWindGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic Wind related Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="WindSpeed" type="Speed" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Average wind speed (kph). ;Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="MaximumWindSpeed" type="Speed" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Maximum expected wind speed (kph). Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="WindDirection" type="AbsoluteBearingType" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Degrees from device Northing. ;Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicalTemperatureGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic Temperature related Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="AirTemperature" type="Temperature" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Current air temperature (degrees C). Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="MinimumTemperature" type="Temperature" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Minimum expected temperature (degrees C). ;Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="MaximumTemperature" type="Temperature" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Maximum expected temperature (degrees C). Atmospheric conditions.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicalPrecipitationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic Precipitation related Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="PrecipitationTypeRef" minOccurs="0"/>            <xsd:element name="PrecipitationIntensity" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Indication of precipitation intensity. ;Higher the value the more intense the precipitation is.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicaVisibilityGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Meteorological Dynamic Visibility related Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="VisibilityTypeRef" minOccurs="0"/>            <xsd:element name="VisibilityDistance" type="Distance" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Visibility distance (metres).</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ======================================================================= -->    <xsd:group name="MeteorologicalDeviceGroup">        <xsd:annotation>            <xsd:documentation>Metereological Device related elements</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="history" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device History.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalHistory" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Meteorological Device History.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faults" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalFault" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Meteorological Fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="commands" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device commands.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalCommand" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Meteorological Command.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Fault===================================================== -->    <xsd:element name="MeteorologicalFault" substitutionGroup="AbstractDeviceFault">        <xsd:annotation>            <xsd:documentation>Meteorological Fault.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceFaultStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="FaultTypeRef" type="MeteorologicalFaultTypeIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Type of fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceFaultGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Command========================================================== -->    <xsd:element name="MeteorologicalCommand" substitutionGroup="AbstractDeviceCommand">        <xsd:annotation>            <xsd:documentation>Meteorological Command.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceCommandStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="DeviceCommandRequestGroup"/>                        <xsd:group ref="DeviceCommandResponseGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Device History===================================================== -->    <xsd:simpleType name="MeteorologicalLogIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Meteorological Device History.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="LogIdType"/>    </xsd:simpleType>    <xsd:element name="MeteorologicalHistory" substitutionGroup="AbstractDeviceHistory">        <xsd:annotation>            <xsd:documentation>Meteorological Device History.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceHistoryStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="MeteorologicalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="LogId" type="MeteorologicalLogIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceHistoryGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ======================================================================= -->    <!-- ====Static===================================================== -->    <xsd:element name="MeteorologicalStatic" substitutionGroup="AbstractStatic">        <xsd:annotation>            <xsd:documentation>Meteorological Data Object Static Data</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:extension base="AbstractSystemObjectStructure">                    <xsd:sequence>                        <xsd:group ref="MeteorologicalStaticGroup"/>                    </xsd:sequence>                </xsd:extension>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:group name="MeteorologicalStaticGroup">        <xsd:annotation>            <xsd:documentation>Static Elements specific to Meteorological.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="types" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Types of Meteorological.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="DeviceTypeDefinitionsGroup"/>                        <xsd:group ref="MeteorologicalTypeDefinitionsGroup"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="qualityStatements" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality Statements. </xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalQuality" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Meteorological Quality Statements</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faultTypes" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="MeteorologicalFaultTypeDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Meteorological Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="MeteorologicalTypeDefinitionsGroup">        <xsd:annotation>            <xsd:documentation>Type definition Elements specific to Meteorological</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="MeteorologicalTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="PrecipitationTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="RoadConditionTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>            <xsd:element ref="VisibilityTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>        </xsd:sequence>    </xsd:group>    <!-- ===Object Type=========================================================== -->    <xsd:element name="MeteorologicalTypeRef" type="MeteorologicalTypeIdType" substitutionGroup="DeviceTypeRef">        <xsd:annotation>            <xsd:documentation>Reference to  Meteorological Type1 =  Automated Station.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="MeteorologicalTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of allowed Meteorological Data Object Type.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:element name="MeteorologicalTypeDefinition" substitutionGroup="DataObjectTypeDefinition">        <xsd:annotation>            <xsd:documentation>Meteorological   Type  Definition. 1 =  Automated Station.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="MeteorologicalTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Object Type definition. </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="TypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ============================================================ -->    <!-- ===Quality==================================================== -->    <xsd:simpleType name="MeteorologicalQualityIdType">        <xsd:annotation>            <xsd:documentation>Unique identifier of Meteorological Quality Statement</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="QualityIdType"/>    </xsd:simpleType>    <xsd:element name="MeteorologicalQuality" abstract="true" substitutionGroup="AbstractQuality">        <xsd:annotation>            <xsd:documentation>Meteorological Quality.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractQualityStructure">                    <xsd:sequence>                        <xsd:element name="QualityId" type="MeteorologicalQualityIdType">                            <xsd:annotation>                                <xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractQualityGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ===Fault Type===================================================== -->    <xsd:simpleType name="MeteorologicalFaultTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for identifier of meteorological Fault Type  Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="FaultTypeIdType"/>    </xsd:simpleType>    <xsd:element name="MeteorologicalFaultTypeDefinition" substitutionGroup="AbstractFaultTypeDefinition">        <xsd:annotation>            <xsd:documentation>Meteorological Fault Type  Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractFaultTypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="FaultTypeId" type="MeteorologicalFaultTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Fault Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractFaultTypeDefinitionGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element></xsd:schema>