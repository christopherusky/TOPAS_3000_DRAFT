<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_traffic_event">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_data_object-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_network-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_utility_time-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   common abstract properties of UTMC Traffic Event Objects.                      <ol>							<li>Traffic Event Data Objects</li>							<ul>								<li>Accident</li>								<li>Event</li>								<li>Incident</li>								<li>Roadworks</li>							</ul>						</ol>					</p>					<p>A Traffic Event comprises one ore more TrafficEventElements, representing updates to the Traffic event.  Any values specified on each subsequent Traffic event.  element supercede the previous values  </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_traffic_event-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_data_object-v1.0.xsd</Requires> 					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility_time-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_network-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing common  components of UTMC Traffic Events.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===Data Object =========================================================== -->	<xsd:element name="TrafficEventRef" type="ObjectIdType" abstract="true" substitutionGroup="DataObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a traffic event.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="AbstractTrafficEvent" type="AbstractTrafficEventStructure" abstract="true" substitutionGroup="AbstractDataObject">		<xsd:annotation>			<xsd:documentation>Abstract  Traffic Event Data Object.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractTrafficEventStructure" abstract="true">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Abstract Traffic   </xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDataObjectStructure"/>		</xsd:complexContent>	</xsd:complexType>	<!-- ===Traffic Event Element=========================================================== -->	<xsd:element name="AbstractTrafficEventElement" type="AbstractTrafficEventElementStructure" abstract="true" substitutionGroup="AbstractDefinition">		<xsd:annotation>			<xsd:documentation>Abstract  Traffic Event Element , i.e. an update to a base event.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractTrafficEventElementStructure" abstract="true">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Abstract Event element, i.e. an update to a base event.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDefinitionStructure">				<xsd:sequence>					<xsd:group ref="TrafficEventLocationGroup" minOccurs="0"/>					<xsd:group ref="TrafficEventElementGroup"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="TrafficEventElementGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to traffic event element.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Name" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Human readable name traffic .for event</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="TrafficEventValidationGroup"/>			<xsd:group ref="TrafficEventClassificationGroup"/>			<xsd:group ref="TrafficEventEffectGroup"/>			<xsd:group ref="TrafficEventCrossReferenceGroup">				<xsd:annotation>					<xsd:documentation>Elements for cross-referencing of  traffic event element with identifers from another system. This allows round trip exchange. Freeflow Extension</xsd:documentation>				</xsd:annotation>			</xsd:group>		</xsd:sequence>	</xsd:group>	<xsd:group name="TrafficEventLocationGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to location of  traffic event. </xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="OffsetObjectGroup"/>			<xsd:element name="LocationDescription" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Text Description of the geospatial location of the traffic event.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="TrafficEventValidationGroup">		<xsd:annotation>			<xsd:documentation>Elements for source validation of  traffic event element.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ReportedBy" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Name of person who reported Incident </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ConfirmedBy" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Name of person who  confirmed Incident </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ModifiedBy" type="xsd:normalizedString" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Name of person who  updated incident.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="TrafficEventClassificationGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to classification of traffic event. </xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="SeverityTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to a Severity Type Definition. The considered severity (in terms of traffic flow) of the incident.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="PhaseTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to a Phase Type Definition. Indicates status of traffic event; The   phase can indicate the history of the event. The precise values are a matter for those implementing the system.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="TrafficEventEffectGroup">		<xsd:annotation>			<xsd:documentation>Elements for effects of  traffic event element.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="AffectedZoneRef" type="NetworkZoneIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Zone affected by Traffic event.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="LanesAffectedTypeRef" minOccurs="0"/>			<xsd:element name="DiversionRoute" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Indicates the route a diversion is to take.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="DiversionInForce" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Indicates if a diversion is in force around the traffic event.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="TrafficEventCrossReferenceGroup">		<xsd:annotation>			<xsd:documentation>Elements for cross-referencing of  traffic event element. Freeflow extension</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ExternalReference" minOccurs="0" maxOccurs="unbounded">				<xsd:annotation>					<xsd:documentation>Identifier of the message on an external system.  Allows identity to be retained through round trip.  Freeflow .</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:complexContent>						<xsd:restriction base="ExternalReferenceStructure">							<xsd:sequence>								<xsd:sequence>									<xsd:element ref="ParticipantRef" minOccurs="0">										<xsd:annotation>											<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>										</xsd:annotation>									</xsd:element>								</xsd:sequence>								<xsd:sequence>									<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">										<xsd:annotation>											<xsd:documentation>Reference to Data Object. Unique within Participant system and type. Onlyneeds to be specified if not given by Context</xsd:documentation>										</xsd:annotation>									</xsd:element>									<xsd:group ref="AbstractListEntryGroup"/>								</xsd:sequence>								<xsd:sequence>									<xsd:group ref="ExternalReferenceGroup"/>								</xsd:sequence>							</xsd:sequence>						</xsd:restriction>					</xsd:complexContent>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:complexType name="ExternalReferenceStructure">		<xsd:annotation>			<xsd:documentation>Type for external refernce to message.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractListEntryStructure">				<xsd:sequence>					<xsd:group ref="ExternalReferenceGroup"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="ExternalReferenceGroup">		<xsd:annotation>			<xsd:documentation>Elements for reference to incidents</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CountryCode" type="xsd:NMTOKEN" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of an external system. Freeflow extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SystemCode" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of   an external system within which MessageIdentifier will be  unique. Freeflow extension</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SituationIdentifier" type="xsd:string">				<xsd:annotation>					<xsd:documentation>Identifier of traffic event  used by external system to identify incident.  Freeflow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SituationVersion" type="xsd:NMTOKEN" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Subsidery version Identifier of traffic event  combined with Message Identifier.  Freeflow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="PlannedEventElement" type="PlannedEventElementStructure" abstract="true" substitutionGroup="AbstractTrafficEventElement">		<xsd:annotation>			<xsd:documentation>Abstract Planned  Traffic Event Data Object.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="PlannedEventElementStructure" abstract="true">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Abstract  Planned Event element, i.e. an update to a base event.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractTrafficEventElementStructure">				<xsd:sequence>					<xsd:group ref="PlannedEventElementGroup"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="PlannedEventElementGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Planned  Event Element.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Planned" type="OpenTimestampRangeStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Planned date of Traffic Event.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Actual" type="OpenTimestampRangeStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Actual date that Traffic Event takes place.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="TrafficEventTypeRef" type="TypeIdType" abstract="true" substitutionGroup="DataObjectTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Event Type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:group name="TrafficEventTypeDefinitionsGroup">		<xsd:annotation>			<xsd:documentation>Type Definitions for Traffic Events.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="DataSourceTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="LanesAffectedTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="PhaseTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="SeverityTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>		</xsd:sequence>	</xsd:group>	<!-- ===Severity =========================================================== -->	<xsd:element name="SeverityTypeRef" type="SeverityTypeIdType" abstract="false" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Severity Type Definition. Used on Traffic Events. 1  = Unknown,2  = Low,3  = Medium,4  = High,999 = Other.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="SeverityTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Allowed values for Severity types.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Unknown"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Low"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Medium"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="High"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:simpleType name="SeverityTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Severity types. 1  = Unknown,2  = Low,3  = Medium,4  = High,999 = Other.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="SeverityTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Severity Type Definition. Used on Traffic Events. 1  = Unknown,2  = Low,3  = Medium,4  = High,999 = Other.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="SeverityTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Severity Type definition.  </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- =====Phase=========================================================== -->	<xsd:element name="PhaseTypeRef" type="PhaseTypeIdType" abstract="false" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Phase Type Definition. Used in Traffic Event.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="PhaseTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Phase type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="PhaseTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Phase  Type Definition. Used on Traffic Events.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="PhaseTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Phase Type Definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Lanes affected================================================================ -->	<xsd:element name="LanesAffectedTypeRef" type="LanesAffectedTypeIdType" abstract="false" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Lanes Affected Type Definition. The lane details that are affected by the traffic event. e.g. inner outer, all lanes0  = this means the road is fully open1  = T  T means the lane is closed2  = I  I means the lane is open3  = I T    4  = T I    5  = T T    6  = I I    7  = I I I  8  = I I T  9  = T I I  10  = I T T 11  = T T I 12  = T T T 13  = I I I I   14  = T I I I   15  = I I I T   16  = T T I I   17  = I I T T   18  = T T T I   19  = I T T T   20  = T T T T</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="LanesAffectedTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Lanes Affected type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="LanesAffectedTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Lanes Affected  Type Definition. Used on Traffic Events.0  = this means the road is fully open1  = T  T means the lane is closed2  = I  I means the lane is open3  = I T    4  = T I    5  = T T    6  = I I    7  = I I I  8  = I I T  9  = T I I  10  = I T T 11  = T T I 12  = T T T 13  = I I I I   14  = T I I I   15  = I I I T   16  = T T I I   17  = I I T T   18  = T T T I   19  = I T T T   20  = T T T T</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="LanesAffectedTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element></xsd:schema>