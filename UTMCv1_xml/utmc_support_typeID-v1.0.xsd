<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_typeID">	<xsd:include schemaLocation="utmc_utility-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_network_base-v1.0.xsd"/>	<!-- ===Dependencies ======================================= -->	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Date>					<Created>2009-05-05</Created>					<!-- Add Image url for Freeflow -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the Abstract UTMC  Type Definition Type ( UTMC "TypeID") used to specify allowed values of UTMC type and Status elements, including                    <ol>							<li>Data Object Types - Allowed types of each Data Object</li>							<ul>								<li>Access Control Type Definition</li>								<li>AirQuality Type Definition</li>								<li>Car Park System Type Definition</li>								<li>CCTV Type Definition</li>								<li>Detector Type Definition</li>								<li>Meteorological Type Definition</li>								<li>Traffic Signal Type Definition</li>								<li>VMS Type Definition</li>								<li>Transport Link Type Definition</li>								<li>Transport Route Type  Definition</li>								<li>Roadworks Type Definition</li>								<li>Accident Type Definition</li>								<li>Event Type Definition</li>								<li>Incident Type Definition</li>								<li>Network Path Type Definition</li>								<li>Network Zone Type Definition</li>							</ul>							<li>Object Data  values for specific types</li>							<ul>								<li>Car Park State Type Definition</li>								<li>Car Park Trend Type Definition</li>								<li>(Car Park) Vehicle Type Definition</li>								<li>(Traffic Event) Lanes Affected Type Definition</li>								<li>(Meteorological) Precipitation Type Definition</li>								<li>Meteorological) Road Condition Type Definition</li>								<li>(Traffic Event) Severity Type Definition</li>								<li>Access Control State Type Definition</li>								<li>(Meteorological) Visibility Type Definition</li>							</ul>							<li>Other Object Definitions</li>							<ul>								<li>Command Format Type Definition</li>								<li>Data Source Type Definition</li>							</ul>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_utility-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_network_base-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specifcation: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema of Type Definition Type used to specify allowed values of elements.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<!-- ==Types============================================================= -->	<xsd:element name="TypeRef" type="TypeIdType" abstract="true">		<xsd:annotation>			<xsd:documentation>Reference to a Data Object Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="TypeIdType">		<xsd:annotation>			<xsd:documentation>Abstract  Type for identifier of Object Type Definition. Each concrete type Definition subtypes</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:simpleType name="TypeIdEnum">		<xsd:annotation>			<xsd:documentation>Abstract  Type for enum of Object Type Definition. Each concrete type Definition subtypes</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:string"/>	</xsd:simpleType>	<!-- ===================================================================== -->	<xsd:element name="DataSourceTypeRef" type="DataSourceTypeIdType" substitutionGroup="OtherObjectTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Data Source. Unique within UTMC.1 = QMISS,2 = MIDAS,3 = NTCC,901 = RCC (1),902 = RCC (2),903 = RCC (3),904 = RCC (4),905 = RCC (5),906 = RCC (6).</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="DataSourceTypeIdType">		<xsd:annotation>			<xsd:documentation>Unique Identifier of a data source type. </xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<!-- ======================================================================= -->	<xsd:element name="TypeDefinition" type="TypeDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Object Type Definition.1 = QMISS,2 = MIDAS,3 = NTCC,901 = RCC (1),902 = RCC (2),903 = RCC (3),904 = RCC (4),905 = RCC (5),906 = RCC (6).</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="TypeDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Object Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="TypeId" type="TypeIdType">				<xsd:annotation>					<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="TypeDefinitionGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="TypeDefinitionGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to  Abstract Object Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="DistributedManagementGroup"/>			<xsd:element name="TypeDescription" type="xsd:string">				<xsd:annotation>					<xsd:documentation>Description of definition type.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="TypeNotes" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Additional notes.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:group ref="GraphicPresentationGroup">				<xsd:annotation>					<xsd:documentation>Graphic presnetation attribnutes. Freeflow Extension.</xsd:documentation>				</xsd:annotation>			</xsd:group>			<xsd:element name="SpecificationLink" type="xsd:anyURI" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Url for specification of equipmen Type. Can be used to link external documentation / schemas to subtypes.to </xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="DataObjectTypeRef" type="TypeIdType" abstract="true" substitutionGroup="TypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Data Object Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="DataObjectTypeDefinition" type="TypeDefinitionStructure" abstract="true" substitutionGroup="TypeDefinition">		<xsd:annotation>			<xsd:documentation>Abstract Data Object Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:group name="GraphicPresentationGroup">		<xsd:annotation>			<xsd:documentation>Graphic presentation properties for object or Object state. Freeflow extension.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Colour" type="Colour" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Colour to use  to show objecs or object state. Freeflow Extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ImageLink" type="xsd:anyURI" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Url for Icon or other image associated with object or object state. Freeflow Extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===================================================================== -->	<xsd:element name="DataValueTypeRef" type="TypeIdType" abstract="true" substitutionGroup="TypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Data Value Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="ValueTypeDefinition" type="TypeDefinitionStructure" abstract="true" substitutionGroup="TypeDefinition">		<xsd:annotation>			<xsd:documentation>Abstract Data Object Value Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="OtherObjectTypeRef" type="TypeIdType" abstract="true" substitutionGroup="TypeRef">		<xsd:annotation>			<xsd:documentation>Reference to an OtherType Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="OtherTypeDefinition" type="TypeDefinitionStructure" abstract="true" substitutionGroup="TypeDefinition">		<xsd:annotation>			<xsd:documentation>Abstract Other Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= --></xsd:schema>