<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_object">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_location-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_network_base-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_utility-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>. 					<p>This subschema describes the   common abstract properties of UTMC   Objects. They are extended by specific concrete   objects, including the following 					<ol>							<li>Device Data Objects</li>							<ul>								<li>Access Control</li>								<li>Air Quality</li>								<li>Car Park</li>								<li>Cctv</li>								<li>Detector</li>								<li>Meteorological</li>								<li>Traffic Signal</li>								<li>Transport Route</li>								<li>Transport Link</li>								<li>Variable Message Sign</li>							</ul>							<li>Traffic Event Data Objects</li>							<ul>								<li>Accident</li>								<li>Event</li>								<li>Incident</li>								<li>Roadworks</li>							</ul>							<li>Network Elements</li>							<ul>								<li>Network Geometry</li>								<li>Network Link</li>								<li>Network Node</li>								<li>Network Turn</li>								<li>Network Path</li>								<li>Network Zone</li>							</ul>							<li>Prediction Objects</li>							<ul>								<li>Access Control Prediction</li>								<li>Air Quality Prediction</li>								<li>Car Park Prediction</li>								<li>Cctv Prediction</li>								<li>Detector Prediction</li>								<li>Traffic Signal Prediction</li>								<li>Transport Route Prediction</li>								<li>Transport Link Prediction</li>							</ul>							<li>Profile Objects</li>							<ul>								<li>Access Control Profile</li>								<li>Air Quality Profile</li>								<li>Car Park Profile</li>								<li>Cctv Profile</li>								<li>Detector Profile</li>								<li>Traffic Signal Profile</li>								<li>Transport Route Profile</li>								<li>Transport Link Profile</li>							</ul>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_object-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_location-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_network_quality-v1.0.xsd					</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility-v1.0.xsd					</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.							<ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing common abstract properties of UTMC  Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:group name="PayloadGroup">		<xsd:annotation>			<xsd:documentation>Payload part of   Service delivery.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="dataObjects" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Data Objects in response</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="AbstractDataObject" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="staticObjects" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Static Objects in response</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="AbstractStatic" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:group name="PointOnPathGroup">		<xsd:annotation>			<xsd:documentation>Elements that locate object as a Point on a  Network Path.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Point" type="PointStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Location indicating start of link. Currently only OS Grid values are used.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:choice>				<xsd:annotation>					<xsd:documentation>UTMC spec allows either</xsd:documentation>				</xsd:annotation>				<xsd:element ref="NetworkLinkRef" minOccurs="0"/>				<xsd:element ref="NetworkPathRef" minOccurs="0"/>			</xsd:choice>		</xsd:sequence>	</xsd:group>	<xsd:group name="OffsetObjectGroup">		<xsd:annotation>			<xsd:documentation>Elements  that locate object on a Transport Link.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="TransportLinkRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Simple reference to a Transport Link.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LinkDistance" type="Distance" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Distance along Link.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:complexType name="ObjectFullRefStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for fully qualified  reference to an Object allowing objects from different systems to be mixed</xsd:documentation>		</xsd:annotation>		<xsd:sequence/>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="AbstractSystemObject" type="AbstractSystemObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Support Data Object. Adds Date</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractSystemObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Object. residing on a UTMC system. Includes both Devices, Type Definitions  etc  and other element types. </xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="ParticipantRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>		<xsd:attribute name="version" type="xsd:string"/>	</xsd:complexType>	<!-- ===Data Objects============================================================ -->	<xsd:element name="AbstractDataObject" type="AbstractDataObjectStructure" abstract="true" substitutionGroup="AbstractSystemObject">		<xsd:annotation>			<xsd:documentation>Abstract Data Object.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="AbstractLinkObject" type="AbstractDataObjectStructure" abstract="true" substitutionGroup="AbstractDataObject">		<xsd:annotation>			<xsd:documentation>Abstract Link Object.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDataObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Data Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractSystemObjectStructure">				<xsd:sequence>					<xsd:element name="SystemCodeNumber" type="ObjectIdType">						<xsd:annotation>							<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>					<xsd:element name="OriginatingObjectRef" type="ObjectIdType" minOccurs="0">						<xsd:annotation>							<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type. Freeflow Extension.</xsd:documentation>						</xsd:annotation>					</xsd:element>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="AbstractSupportObject" type="AbstractSupportObjectStructure" abstract="true" substitutionGroup="AbstractDataObject">		<xsd:annotation>			<xsd:documentation>Abstract Support Data Object. Adds Date</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractSupportObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for Abstract Support Data Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDataObjectStructure">				<xsd:group ref="AbstractSupportObjectGroup">					<xsd:annotation>						<xsd:documentation>Elements  for Support Object. Freeflow Extension.</xsd:documentation>					</xsd:annotation>				</xsd:group>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="AbstractSupportObjectGroup">		<xsd:annotation>			<xsd:documentation>Elements  that locate object on a Transport Link.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="AbstractListEntry" type="AbstractListEntryStructure" abstract="true" substitutionGroup="AbstractSystemObject">		<xsd:annotation>			<xsd:documentation>Abstract Support Data Object. Adds Date</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractListEntryStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for Abstract Support Data Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractSystemObjectStructure">				<xsd:sequence>					<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">						<xsd:annotation>							<xsd:documentation>Reference to Data Object. Unique within Participant system and type. Onlyneeds to be specified if not given by Context</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:group ref="AbstractListEntryGroup"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="AbstractListEntryGroup">		<xsd:annotation>			<xsd:documentation>Elements for a List Entry</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which list entry was last updated. Freefkow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which list entry was i.e. became historic deleted. Freefkow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Static Objects============================================================== -->	<xsd:element name="AbstractStatic" type="AbstractSystemObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Static Object, Groups the ancillary metadata associated with an object type.</xsd:documentation>		</xsd:annotation>	</xsd:element></xsd:schema>