<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_quantised_transport_link">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_data_object_transport_link-v1.0.xsd"/>    <xsd:include schemaLocation="utmc_quantised-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   properties of UTMC Transport Link Prediction and Profile  Objects.                       <ol>                            <li>Transport Link Prediction</li>                            <li>Transport Link Profile</li>                        </ol>                    </p>                    <p>Each Prediction object assesses a one or more Prediction data values that will be in effect at a specific date and time band.</p>                    <p>Each Profile  object summarizes data values as one or more Profile  data values that summarize  a specific date and time band. </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_quantised_transport_link-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_data_object_transport_link-v1.0.xsd</Requires>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_quantised-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing   UTMC  Transport Link Prediction and Profile Objects.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ======================================================================= -->    <xsd:group name="TransportLinkQuantisedDataGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to transport Link Prediction Data. </xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:group ref="TransportLinkDynamicGroup"/>            <xsd:element name="Gps" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>GPS values for prediction or profile data. This is an Extended Freeflow </xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:group ref="TransportLinkGpsDynamicGroup"/>                </xsd:complexType>            </xsd:element>            <xsd:element name="Flow" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Flow values for prediction or profile data. This is an extended Freeflow representation.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:group ref="TransportLinkScootDynamicGroup"/>                </xsd:complexType>            </xsd:element>            <xsd:element name="Anpr" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>ANPR values for prediction or profile data.  This is an extended Freeflow representation.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:group ref="TransportLinkAnprDynamicGroup"/>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Prediction=========================================================== -->    <xsd:element name="TransportLinkPrediction" type="TransportLinkPredictionStructure" substitutionGroup="AbstractPrediction">        <xsd:annotation>            <xsd:documentation>Transport Link Prediction.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="TransportLinkPredictionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Transport Link Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractPredictionStructure">                <xsd:sequence>                    <xsd:group ref="TransportLinkPredictionGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TransportLinkPredictionGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Transport Link Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="predictionData" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Prediction data</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TransportLinkPredictionData" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Prediction data========================================================= -->    <xsd:element name="TransportLinkPredictionData" substitutionGroup="AbstractPredictionData">        <xsd:annotation>            <xsd:documentation>Transport Link Prediction Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TransportLinkPredictionDataStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="PredictionIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a Prediction. Normally given by context; only needs to be present in standalone use. </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="QuantisedDataGroup"/>                            <xsd:element name="DataObjectRef" type="TransportLinkIdType">                                <xsd:annotation>                                    <xsd:documentation>Reference to a Data Object</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TransportLinkQuantisedDataGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TransportLinkPredictionDataStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Transport Link Prediction Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractPredictionDataStructure">                <xsd:sequence>                    <xsd:group ref="TransportLinkQuantisedDataGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Profile=========================================================== -->    <xsd:element name="TransportLinkProfile" type="TransportLinkProfileStructure" substitutionGroup="AbstractProfile">        <xsd:annotation>            <xsd:documentation>Transport Link Prediction.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="TransportLinkProfileStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Transport Link Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractProfileStructure">                <xsd:sequence>                    <xsd:group ref="TransportLinkProfileGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TransportLinkProfileGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Transport Link Prediction.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="profileData" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Profile data</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TransportLinkProfileData" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Transport Link Profile Data.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Profile data========================================================= -->    <xsd:element name="TransportLinkProfileData" substitutionGroup="AbstractProfileData">        <xsd:annotation>            <xsd:documentation>Transport Link Prediction Data.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TransportLinkProfileDataStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="ProfileIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Unique Identifier of a Profile. Normally given by context. only needs to be present in standalone use. </xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="QuantisedDataGroup">                                <xsd:annotation>                                    <xsd:documentation>Elements for Prediction and Profile data.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:element name="DataObjectRef" type="TransportLinkIdType">                                <xsd:annotation>                                    <xsd:documentation>Reference to a Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TransportLinkQuantisedDataGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TransportLinkProfileDataStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Transport Link Prediction Data.  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractProfileDataStructure">                <xsd:sequence>                    <xsd:group ref="TransportLinkQuantisedDataGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType></xsd:schema>