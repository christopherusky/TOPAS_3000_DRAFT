d)2 = Suspect</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="FlowStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for detector Flow Status Type Definition. 0 = Normal1 = Suspect (only Total Flow Supplied)2 = Suspect</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="OccupancyStatusTypeRef" type="OccupancyStatusTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Detector Occupancy Status Type Definition.0 = Normal,1 = Suspect.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="OccupancyStatusTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Detector Occupancy Status Type Definition.0 = Normal1 = Suspect</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="OccupancyStatusTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Occupancy Status Type Definition. Used on Detector Object.0 = Normal,1 = Suspect.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="OccupancyStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Detector Occupancy Status Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="QueueSeverityTypeRef" type="QueueSeverityTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Detector Queue Severity Type Definition. 0 = Normal Traffic,1 = Dense Traffic,2 = Delayed Traffic,3 = Congested Traffic,4 = Stop and Go Traffic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="QueueSeverityTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Allowed values for  Detector Queue severity Types</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="0"/>			<xsd:enumeration value="Normal Traffic"/>			<xsd:enumeration value="1"/>			<xsd:enumeration value="Dense Traffic"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Delayed Traffic"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Congested Traffic"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Stop and Go Traffic"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:simpleType name="QueueSeverityTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier  of Detector Queue Severity Type Definition.0 = Normal Traffic1 = Dense Traffic2 = Delayed Traffic3 = Congested Traffic4 = Stop and Go Traffic</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="QueueSeverityTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Queue Severity Type Definition. Used on Detector Object. 0 = Normal Traffic,1 = Dense Traffic,2 = Delayed Traffic,3 = Congested Traffic4 = Stop and Go Traffic.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="QueueSeverityTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Detector Queue Severity Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Quality==================================================== -->	<xsd:simpleType name="DetectorQualityIdType">		<xsd:annotation>			<xsd:documentation>Type for identifier of Detector Quality Statement.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="QualityIdType"/>	</xsd:simpleType>	<xsd:element name="DetectorQuality" abstract="true" substitutionGroup="AbstractQuality">		<xsd:annotation>			<xsd:documentation>Detector Quality.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractQualityStructure">					<xsd:sequence>						<xsd:element name="QualityId" type="DetectorQualityIdType">							<xsd:annotation>								<xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractQualityGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Fault Type===================================================== -->	<xsd:simpleType name="DetectorFaultTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Fault Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="FaultTypeIdType"/>	</xsd:simpleType>	<xsd:element name="DetectorFaultTypeDefinition" substitutionGroup="AbstractFaultTypeDefinition">		<xsd:annotation>			<xsd:documentation>Detector Fault Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractFaultTypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="FaultTypeId" type="DetectorFaultTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier of Fault Type.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractFaultTypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element></xsd:schema>