xOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Detector Quality Statements</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="faultTypes" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device Faults.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="DetectorFaultTypeDefinition" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Detector Fault Type Definition.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="DetectorStaticTypeDefinitionsGroup">		<xsd:annotation>			<xsd:documentation>Type definition Elements specific to Detector.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="DetectorTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="FlowStatusTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="HeadwayStatusTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="OccupancyStatusTypeDefinition" minOccurs="0" maxOccurs="unbounded">				<xsd:annotation>					<xsd:documentation>Occupancy Status Type Definition. Used on Detector Object. 0 = Normal1 = Suspect</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="QueueSeverityTypeDefinition" minOccurs="0" maxOccurs="unbounded">				<xsd:annotation>					<xsd:documentation>Queue Severity Type Definition. Used on Detector Object. 0 = Normal Traffic1 = Dense Traffic2 = Delayed Traffic3 = Congested Traffic4 = Stop and Go Traffic</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="SpeedStatusTypeDefinition" minOccurs="0" maxOccurs="unbounded">				<xsd:annotation>					<xsd:documentation>Speed Status Type  Definition. Used on Detector Object. 0 = Normal1 = Suspect</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Object Type=========================================================== -->	<xsd:element name="DetectorTypeRef" type="DetectorTypeIdType" substitutionGroup="DeviceTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Detector Type Definition.1 = SCOOT Loops2 = Count3 = Occupancy4 = Speed5 = Queue6 = Bus7 = Headway8 = Multi-purpose9 = Traficon10 = MIDAS999 = Undefined</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="DetectorTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Detector   Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="DetectorTypeDefinition" substitutionGroup="DataObjectTypeDefinition">		<xsd:annotation>			<xsd:documentation>Detector   Type Definition. 1 = SCOOT Loops,2 = Count,3 = Occupancy,4 = Speed,5 = Queue,6 = Bus,7 = Headway,8 = Multi-purpose,9 = Traficon,10 = MIDAS,999 = Undefined.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="DetectorTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Detector Type Definition.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="SpeedStatusTypeRef" type="SpeedStatusTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Detector Speed Status Type Definition.0 = Normal1 = Suspect</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="SpeedStatusTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Detector Speed Status Type Definition.0 = Normal1 = Suspect</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="SpeedStatusTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Speed Status Type  Definition. Used on Detector Object. 0 = Normal,1 = Suspect.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="SpeedStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Detector Speed Status Type definition.  </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ============================================================ -->	<xsd:element name="HeadwayStatusTypeRef" type="HeadwayStatusTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to Detector Headway Status Type Definition.0 = Normal.1 = Suspect.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="HeadwayStatusTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Detector Headway Status Type  Definition.0 = Normal1 = Suspect</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="HeadwayStatusTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Headway Status Type  Definition. Used on Detector Object. 0 = Normal.1 = Suspect.</xsd:documentation>	