ype" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Type of fault.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractDeviceFaultGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ====Command========================================================== -->	<xsd:element name="DetectorCommand" substitutionGroup="AbstractDeviceCommand">		<xsd:annotation>			<xsd:documentation>Detector Command.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractDeviceCommandStructure">					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="DetectorIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="DeviceCommandRequestGroup"/>						<xsd:group ref="DeviceCommandResponseGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ====Device History===================================================== -->	<xsd:simpleType name="DetectorLogIdType">		<xsd:annotation>			<xsd:documentation>Type fro Identifier of Detector Device History</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="LogIdType"/>	</xsd:simpleType>	<xsd:element name="DetectorHistory" substitutionGroup="AbstractDeviceHistory">		<xsd:annotation>			<xsd:documentation>Detector Device History</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractDeviceHistoryStructure">					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="DetectorIdType" minO