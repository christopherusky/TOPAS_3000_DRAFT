<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_detector">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_device-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project and UTMC XML working Group. </Contributor>				<Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>				<Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>				<Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>				<Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>				<Contributor>UTMC: mark.bodger at siemens.com; </Contributor>				<Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>				<Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>				<Contributor>UTMC: brendan mason, tenet </Contributor>				<Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>				<Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>				<Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>				<Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>				<Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>				<Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>				<Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>				<Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>				<Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>				<Contributor>Freeflow: rob shepherd at acis.com</Contributor>				<Contributor>Freeflow: ian routledge at acis.com</Contributor>				<Contributor>TO be COMPLETED  </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Detector device Data Object and its components. These may include:                    <ol>							<li>Definition, describing the fixed properties of an object and its location on the network.</li>							<ul>								<li>Detector Definition</li>							</ul>							<li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>							<ul>								<li>Detector Configuration</li>							</ul>							<li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>							<ul>								<li>Detector Flow Dynamic</li>								<li>Detector Occupancy Dynamic</li>								<li>Detector Queue Dynamic</li>								<li>Detector Speed Dynamic</li>								<li>Detector Headway Dynamic</li>							</ul>							<li>Device History, describing the device history which may be issued to the device.</li>							<ul>								<li>Detector Device History</li>							</ul>							<li>Fault, describing the device  faults,</li>							<ul>								<li>Detector Fault</li>							</ul>							<li>Command, describing the commands which may be issued to the device.</li>							<ul>								<li>Detector Command</li>							</ul>							<li>Types, describing the allowed values for types associated with Detector data object.</li>							<ul>								<li>Detector Quality Type Definition</li>								<li>Detector Fault Type Definition</li>								<li>Detector Flow Status Dynamic</li>								<li>Detector Occupancy Status Type Definition</li>								<li>Detector Queue Severity Type Definition</li>								<li>Detector Speed Status Type Definition</li>								<li>Detector Headway Status Type Definition</li>							</ul>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_detector-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing the UTMC Detector Device Object.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===Object ID=============================================================== -->	<xsd:simpleType name="DetectorIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Detector.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="DetectorRef" type="DetectorIdType" substitutionGroup="DeviceRef">		<xsd:annotation>			<xsd:documentation>Reference to a Detector. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorFullRefStructure">		<xsd:annotation>			<xsd:documentation>Type for full reference to a Detector.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="ObjectFullRefStructure">				<xsd:sequence>					<xsd:element ref="DetectorRef"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<!-- ===Object Type=========================================================== -->	<xsd:element name="Detector" substitutionGroup="AbstractDeviceObject">		<xsd:annotation>			<xsd:documentation>Detector Data Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="DetectorStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:sequence>								<xsd:element ref="ParticipantRef" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>									</xsd:annotation>								</xsd:element>							</xsd:sequence>							<xsd:sequence>								<xsd:element name="SystemCodeNumber" type="DetectorIdType">									<xsd:annotation>										<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>									</xsd:annotation>								</xsd:element>								<xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>									</xsd:annotation>								</xsd:element>								<xsd:element name="OriginatingObjectRef" type="DetectorIdType" minOccurs="0">									<xsd:annotation>										<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>									</xsd:annotation>								</xsd:element>							</xsd:sequence>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="DetectorGroup"/>							<xsd:group ref="DetectorDeviceGroup">								<xsd:annotation>									<xsd:documentation>Device related elements.</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="DetectorStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Detector.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDeviceStructure">				<xsd:sequence>					<xsd:group ref="DetectorGroup"/>					<xsd:group ref="DetectorDeviceGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="definitions" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Detector defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="DetectorDefinition" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="configurations" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Detector configurations.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="DetectorConfiguration" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="dynamics" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Detectorsdynamic values.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="DetectorFlowDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="DetectorHeadwayDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="DetectorOccupancyDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="DetectorQueueDynamic" minOccurs="0" maxOccurs="unbounded"/>						<xsd:element ref="DetectorSpeedDynamic" minOccurs="0" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Object Definition===================================================== -->	<xsd:element name="DetectorDefinition" substitutionGroup="AbstractDeviceDefinition">		<xsd:annotation>			<xsd:documentation>Detector Data Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="DetectorDefinitionStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="DetectorIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element name="ObjectTypeRef" type="DetectorTypeIdType">								<xsd:annotation>									<xsd:documentation>Type of Data Object.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element name="QualityRef" type="DetectorQualityIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Quality statement of Data Object.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="BaseDefinitionGroup"/>							<xsd:group ref="DefinitionDescriptionGroup">								<xsd:annotation>									<xsd:documentation>UTMC Object textual description elements.</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:group ref="PointOnPathGroup" minOccurs="0"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="OffsetObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="DetectorDefinitionStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Detector Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDeviceDefinitionStructure">				<xsd:sequence>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<!-- ===Object Configuration===================================================== -->	<xsd:element name="DetectorConfiguration" substitutionGroup="AbstractConfiguration">		<xsd:annotation>			<xsd:documentation>Detector Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="DetectorConfigurationStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="DetectorIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="AbstractConfigurationGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="DetectorConfigurationGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="DetectorConfigurationStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractConfigurationStructure">				<xsd:sequence>					<xsd:group ref="DetectorConfigurationGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorConfigurationGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector  Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ThreshholdUp" type="DetectorThresholdStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation> Values above which average dynamic is considered "abnormal".</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ThreshholdDown" type="DetectorThresholdStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation> Values below which average dynamic values are considered "abnormal".</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:complexType name="DetectorThresholdStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector Configuration Threshold.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Flow" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in number of vehicles per measure interval </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Occupancy" type="LaneOccupancy" minOccurs="0">				<xsd:annotation>					<xsd:documentation> Percentage occupancy or road or lane covered by detector.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Speed" type="Speed" minOccurs="0">				<xsd:annotation>					<xsd:documentation>speed in kph</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Colour" type="Colour" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Colour to use to depict object's state if they are over this threshold.  Freeflow extension</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:complexType>	<!-- ===Object Dynamic============================================================ -->	<xsd:element name="DetectorDynamic" type="DetectorDynamicStructure" abstract="true" substitutionGroup="AbstractDynamic">		<xsd:annotation>			<xsd:documentation>Detector Object  Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector   Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:restriction base="AbstractDynamicStructure">				<xsd:sequence>					<xsd:element name="SystemCodeNumber" type="DetectorIdType" minOccurs="0">						<xsd:annotation>							<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:group ref="AbstractDynamicGroup"/>				</xsd:sequence>			</xsd:restriction>		</xsd:complexContent>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="DetectorFlowDynamic" type="DetectorFlowDynamicStructure" abstract="false" substitutionGroup="DetectorDynamic">		<xsd:annotation>			<xsd:documentation>Detector Flow Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorFlowDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector  Flow Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="DetectorDynamicStructure">				<xsd:sequence>					<xsd:sequence>						<xsd:group ref="DetectorFlowDynamicGroup"/>					</xsd:sequence>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorFlowDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector  Traffic Flow  Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="TotalFlow" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval minutes</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FlowInterval" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Period for flow data collection (in minutes)</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class1Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 1 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class2Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 2 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class3Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 3 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class4Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 4 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class5Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Interval for Class 5 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class6Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in  Flow Interval for Class 6 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class7Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 7 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Class8Count" type="NumberOfVehicles" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Flow in Flow Interval for Class 8 vehicles.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="FlowStatusTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="DetectorOccupancyDynamic" type="DetectorOccupancyDynamicStructure" abstract="false" substitutionGroup="DetectorDynamic">		<xsd:annotation>			<xsd:documentation>Detector Occupancy Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorOccupancyDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector  Occupancy Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="DetectorDynamicStructure">				<xsd:sequence>					<xsd:group ref="DetectorOccupancyDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorOccupancyDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector Occupancy Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Occupancy" type="Percentage" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Occupancy percentage in Occupancy Interval minutes.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="OccupancyInterval" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Period for  occupancy data collection.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="OccupancyStatusTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to Detector Occupancy Status Type Definition.0 = Normal1 = Suspect</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="DetectorQueueDynamic" type="DetectorQueueDynamicStructure" abstract="false" substitutionGroup="DetectorDynamic">		<xsd:annotation>			<xsd:documentation>Detector Queue Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorQueueDynamicStructure">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector   Queue Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="DetectorDynamicStructure">				<xsd:sequence>					<xsd:group ref="DetectorQueueDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorQueueDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector Queue Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="QueuePresent" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether there a Queue present , true / false.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="QueueSeverityTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="DetectorSpeedDynamic" type="DetectorSpeedDynamicStructure" abstract="false" substitutionGroup="DetectorDynamic">		<xsd:annotation>			<xsd:documentation>Detector  Speed Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorSpeedDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector Speed Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="DetectorDynamicStructure">				<xsd:sequence>					<xsd:group ref="DetectorSpeedDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorSpeedDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector Speed Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Speed" type="Speed" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Average speed in kph over Interval.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="SpeedInterval" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Period for  speed data collection.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="SpeedStatusTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to Detector Speed Status Type Definition.0 = Normal,1 = Suspect.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="DetectorHeadwayDynamic" type="DetectorHeadwayDynamicStructure" abstract="false" substitutionGroup="DetectorDynamic">		<xsd:annotation>			<xsd:documentation>Detector Headway Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="DetectorHeadwayDynamicStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for  Detector  Headway Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="DetectorDynamicStructure">				<xsd:sequence>					<xsd:group ref="DetectorHeadwayDynamicGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="DetectorHeadwayDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Detector Headway Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="Headway" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Average headway value in seconds between each vehicle.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HeadwayInterval" type="xsd:duration" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Period for headway data collection.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="HeadwayStatusTypeRef" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to Detector Headway Status  Type Definition. </xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:group name="DetectorDeviceGroup">		<xsd:annotation>			<xsd:documentation>Device related elements</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="history" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Device History.</xsd:documentation>				