<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_traffic_signal">    <xsd:include schemaLocation="utmc_device-v1.0.xsd"/>    <!-- ===Dependencies ======================================= -->    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project and UTMC XML working Group. </Contributor>                <Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>                <Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>                <Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>                <Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>                <Contributor>UTMC: mark.bodger at siemens.com; </Contributor>                <Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>                <Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>                <Contributor>UTMC: brendan mason, tenet </Contributor>                <Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>                <Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>                <Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>                <Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>                <Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>                <Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>                <Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>                <Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>                <Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>                <Contributor>Freeflow: rob shepherd at acis.com</Contributor>                <Contributor>Freeflow: ian routledge at acis.com</Contributor>                <Contributor>TO be COMPLETED  </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Traffic Signal device Data Object and its components. These may include:                    <ol>                            <li>Definition, describing the fixed properties of an object and its location on the network.</li>                            <ul>                                <li>Traffic Signal Definition</li>                            </ul>                            <li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>                            <ul>                                <li>Traffic Signal Configuration</li>                            </ul>                            <li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>                            <ul>                                <li>Traffic Signal Dynamic</li>                            </ul>                            <li>Device History, describing the device history which may be issued to the device.</li>                            <ul>                                <li>Traffic Signal Device History</li>                            </ul>                            <li>Fault, describing the device  faults,</li>                            <ul>                                <li>Traffic Signal Fault</li>                            </ul>                            <li>Command, describing the commands which may be issued to the device.</li>                            <ul>                                <li>Traffic Signal Command</li>                            </ul>                            <li>Types, describing the allowed values for types associated with Traffic Signal data object.</li>                            <ul>                                <li>Traffic Signal Quality Type Definition</li>                                <li>Traffic Signal Fault Type Definition</li>                            </ul>                        </ol>                    </p>                    <p>The </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_traffic_signal-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing the UTMC Traffic Signal Device Object.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ===Object ID=============================================================== -->    <xsd:simpleType name="TrafficSignalIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of TrafficSignal. Unique within system and type</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="ObjectIdType"/>    </xsd:simpleType>    <xsd:element name="TrafficSignalRef" type="TrafficSignalIdType" substitutionGroup="DeviceRef">        <xsd:annotation>            <xsd:documentation>Reference to a Traffic Signal. Unique within Participant system and type.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="TrafficSignalFullRefStructure">        <xsd:annotation>            <xsd:documentation>Type for full reference to a Traffic Signal.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="ObjectFullRefStructure">                <xsd:sequence>                    <xsd:element ref="TrafficSignalRef"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Object =========================================================== -->    <xsd:element name="TrafficSignal" substitutionGroup="AbstractDeviceObject">        <xsd:annotation>            <xsd:documentation>Traffic Signal Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:sequence>                                <xsd:element ref="ParticipantRef" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                            <xsd:sequence>                                <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingObjectRef" type="TrafficSignalIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TrafficSignalGroup"/>                            <xsd:group ref="TrafficSignalDeviceGroup">                                <xsd:annotation>                                    <xsd:documentation>Device related elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalGroup"/>                    <xsd:group ref="TrafficSignalDeviceGroup">                        <xsd:annotation>                            <xsd:documentation>Device related elements.</xsd:documentation>                        </xsd:annotation>                    </xsd:group>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TrafficSignalGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="definitions" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Traffic Signal defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalDefinition" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="configurations" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Traffic Signal  configurations.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalConfiguration" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="dynamics" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Traffic Signal  dynamic values.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalDynamic" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Definition ========================================================== -->    <xsd:element name="TrafficSignalDefinition" substitutionGroup="AbstractDeviceDefinition">        <xsd:annotation>            <xsd:documentation>Traffic Signal Data  Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalDefinitionStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="ObjectTypeRef" type="TrafficSignalTypeIdType">                                <xsd:annotation>                                    <xsd:documentation>Type of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="QualityRef" type="TrafficSignalQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Quality statement of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="BaseDefinitionGroup"/>                            <xsd:group ref="DefinitionDescriptionGroup">                                <xsd:annotation>                                    <xsd:documentation>UTMC Object textual description elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:group ref="PointOnPathGroup" minOccurs="0"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="OffsetObjectGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalDefinitionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Traffic Signal Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceDefinitionStructure">                <xsd:sequence>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Object Configuration===================================================== -->    <xsd:element name="TrafficSignalConfiguration" substitutionGroup="AbstractConfiguration">        <xsd:annotation>            <xsd:documentation>Traffic Signal Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalConfigurationStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractConfigurationGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TrafficSignalConfigurationGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalConfigurationStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for  Traffic Signal Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TrafficSignalConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal  Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="SubArea" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation> Group of signals to which this "object"belongs. </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="Supplier" type="xsd:normalizedString" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Name of the supplier.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="ControllerType" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation> Type/Make of "object" .</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="UserCodeNumber" minOccurs="0">                <xsd:annotation>                    <xsd:documentation> User's own reference. </xsd:documentation>                </xsd:annotation>                <xsd:simpleType>                    <xsd:restriction base="xsd:string">                        <xsd:maxLength value="32"/>                    </xsd:restriction>                </xsd:simpleType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Dynamic============================================================ -->    <xsd:element name="TrafficSignalDynamic" abstract="false" substitutionGroup="AbstractDynamic">        <xsd:annotation>            <xsd:documentation>Traffic Signal Object  Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TrafficSignalDynamicStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractDynamicGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="TrafficSignalDynamicGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="TrafficSignalDynamicStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for  Traffic Signal   Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDynamicStructure">                <xsd:sequence>                    <xsd:group ref="TrafficSignalDynamicGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="TrafficSignalDynamicGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal  Dynamic.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="ControlStrategy" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Mode of control, e.g. SCOOT.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="PlanNumber" type="PlanNumberType" minOccurs="0">                <xsd:annotation>                    <xsd:documentation> Currently active plan.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="StageSequence" type="xsd:integer" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>The order of stages in the plan. </xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="PlanTimings" type="xsd:string" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>The duration of each stage in the plan.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ======================================================================= -->    <xsd:simpleType name="PlanNumberType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Plan</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="xsd:integer"/>    </xsd:simpleType>    <!-- ======================================================================= -->    <!-- ==Device========================================================== -->    <xsd:group name="TrafficSignalDeviceGroup">        <xsd:annotation>            <xsd:documentation>Device related elements.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="history" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device History.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalHistory" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Device History</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faults" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalFault" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="commands" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device commands.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalCommand" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Command</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Fault===================================================== -->    <xsd:element name="TrafficSignalFault" substitutionGroup="AbstractDeviceFault">        <xsd:annotation>            <xsd:documentation>Traffic Signal Fault.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceFaultStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="FaultTypeRef" type="TrafficSignalFaultTypeIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Type of fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceFaultGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Command========================================================== -->    <xsd:element name="TrafficSignalCommand" substitutionGroup="AbstractDeviceCommand">        <xsd:annotation>            <xsd:documentation>Traffic Signal Command.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceCommandStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="DeviceCommandRequestGroup"/>                        <xsd:group ref="DeviceCommandResponseGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Device History===================================================== -->    <xsd:simpleType name="TrafficSignalDataLogIdType" final=" ">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Traffic Signal Device History.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="LogIdType"/>    </xsd:simpleType>    <xsd:element name="TrafficSignalHistory" substitutionGroup="AbstractDeviceHistory">        <xsd:annotation>            <xsd:documentation>Traffic Signal Device History.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceHistoryStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="TrafficSignalIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="LogId" type="TrafficSignalDataLogIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceHistoryGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Static===================================================== -->    <xsd:element name="TrafficSignalStatic" substitutionGroup="AbstractStatic">        <xsd:annotation>            <xsd:documentation>Traffic Signal Data Object Static Data</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:extension base="AbstractSystemObjectStructure">                    <xsd:sequence>                        <xsd:group ref="TrafficSignalStaticGroup"/>                    </xsd:sequence>                </xsd:extension>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:group name="TrafficSignalStaticGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Traffic Signal  Static Values</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="types" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Types of Traffic Signal.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="DeviceTypeDefinitionsGroup"/>                        <xsd:group ref="TrafficSignalTypeDefinitionsGroup"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="qualityStatements" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality Statements .</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalQuality" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Quality Statements</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faultTypes" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="TrafficSignalFaultTypeDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Traffic Signal Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="TrafficSignalTypeDefinitionsGroup">        <xsd:annotation>            <xsd:documentation>Type definition Elements specific to Traffic Signal</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="TrafficSignalTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>        </xsd:sequence>    </xsd:group>    <!-- ===Object Type=========================================================== -->    <xsd:element name="TrafficSignalTypeRef" type="TrafficSignalTypeIdType" substitutionGroup="DeviceTypeRef">        <xsd:annotation>            <xsd:documentation>Reference  to Traffic Signal Type. 1 = Intersection,2 = Pelican,3 = Puffin,4 = Toucan,5 = Pegasus,6 = Tram Crossing,7 = Wig Wag,999 = Other.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="TrafficSignalTypeIdType">        <xsd:annotation>            <xsd:documentation>identifier of  Traffic Signal Type  Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:element name="TrafficSignalTypeDefinition" substitutionGroup="DataObjectTypeDefinition">        <xsd:annotation>            <xsd:documentation>Traffic Signal Type  Definition. 1 = Intersection,2 = Pelican,3 = Puffin,4 = Toucan,5 = Pegasus,6 = Tram Crossing,7 = Wig Wag,999 = Other.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="TypeDefinitionStructure">                    <xsd:sequence>                        <xsd:element name="TypeId" type="TrafficSignalTypeIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier for Object Type definition. </xsd:documentation>      