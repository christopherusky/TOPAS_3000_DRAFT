<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_network_base">	<!-- ===Dependencies ======================================= -->	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>. 					<p>This subschema describes the identifiers of core data elements that are used in many different packages. They are described centrally here so that there is a strict linear dependency graph between packages.					 Declares					 <ul>							<li>ObjectId</li>							<li>NetworkObjectId</li>							<li>TransportLinkId</li>							<li>NetworkPathId</li>							<li>NetworkZoneId</li>						</ul>					</p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_network_base-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>none</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<ul>						<li>Derived from the UTMC specification and SIRI standards.<ul>								<li>ts004.003annexdapr07.xls</li>								<li>ts004-004a-annexd-sep08.pdf	</li>							</ul>						</li>					</ul>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Base Network subschema describing identifiers of core UTMC data objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===System identifiers===================================================== -->	<xsd:group name="DistributedManagementGroup">		<xsd:annotation>			<xsd:documentation>Elements supporting distrubuted use of data elements. T</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ParticipantRef" type="ParticipantIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Reference to unique Identifier of system providing Type Definition. Normall given by context This may or may not be the same as the Data Source.  his makes it possible to distinguish between Conflicting use of the same identifers by different systems.  Freeflow extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time of last change to data.This makes it possible to support exchange of historic data and  deltas.  Freeflow Extension to add to all object types.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and Time that data became historic. If blank element is current.  This makes it possible to support historic data sets.  Freeflow Extension to add to all object types. Equivalent to DeletedDate)</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===System identifiers===================================================== -->	<xsd:simpleType name="ParticipantIdType">		<xsd:annotation>			<xsd:documentation>Data Type for unique  Identifier of an System.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:NMTOKEN">			<xsd:maxLength value="32"/>			<xsd:minLength value="1"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="ParticipantRef" type="ParticipantIdType">		<xsd:annotation>			<xsd:documentation>Reference to unique Identifier of system providing Data Object data. This may or may not be the same as the Data Source</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="OriginatingParticipantRef" type="ParticipantIdType">		<xsd:annotation>			<xsd:documentation>Reference to the unique Identifier of  system from which object originated. Freeflow Extension.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ===Object ID=============================================================== -->	<xsd:simpleType name="ObjectIdType">		<xsd:annotation>			<xsd:documentation>Type for Unique Identifier of an Object. Unique within Object Type within System</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:NMTOKEN">			<xsd:maxLength value="32"/>			<xsd:minLength value="1"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="ObjectRef" type="ObjectIdType" abstract="true">		<xsd:annotation>			<xsd:documentation>Reference to an Object. Unique within system and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="DataObjectRef" type="ObjectIdType" abstract="true" substitutionGroup="ObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a Data Object, Unique within System and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="DeviceRef" type="ObjectIdType" abstract="true" substitutionGroup="DataObjectRef">		<xsd:annotation>			<xsd:documentation>Simple reference to a device. Unique within System and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:simpleType name="TransportLinkIdType">		<xsd:annotation>			<xsd:documentation>Type for unique identifier of a Transport Link. Unique for Links within system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="TransportLinkRef" type="TransportLinkIdType" abstract="false" substitutionGroup="DeviceRef">		<xsd:annotation>			<xsd:documentation>Reference to a Transport Link. Unique within system and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="NetworkObjectRef" type="ObjectIdType" abstract="true" substitutionGroup="ObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a network Object. Unique within Participant system and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="AbstractNetworkLinkRef" type="ObjectIdType" abstract="true" substitutionGroup="NetworkObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a network Link. Unique within Participant system and object type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:simpleType name="NetworkZoneIdType">		<xsd:annotation>			<xsd:documentation>Data Type for Identifier of an Network Zone. Unique for Network Zones within system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkZoneRef" type="NetworkZoneIdType" abstract="false" substitutionGroup="NetworkObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a Network Zone. Unique within Participant system.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ===================================================================== -->	<xsd:simpleType name="NetworkPathIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Type of an Network Path. Unique for Network Paths within system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkPathRef" type="NetworkPathIdType" abstract="false" substitutionGroup="AbstractNetworkLinkRef">		<xsd:annotation>			<xsd:documentation>Reference to a Network Path. Unique within Participant system.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ===================================================================== -->	<xsd:simpleType name="NetworkLinkIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Network Link. Unique for links within system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkLinkRef" type="NetworkLinkIdType" substitutionGroup="AbstractNetworkLinkRef">		<xsd:annotation>			<xsd:documentation>Reference to a network Link. Unique within Participant system.</xsd:documentation>		</xsd:annotation>	</xsd:element></xsd:schema>