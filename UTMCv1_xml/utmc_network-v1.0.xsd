<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_network">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_object-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_support_data_source-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC  Network Objects that describe the static transport network                    <ul>							<li>Network Elements</li>							<ul>								<li>Network Geometry</li>								<li>Network Link</li>								<li>Network Node</li>								<li>Network Turn</li>								<li>Network Path</li>								<li>Network Zone</li>							</ul>						</ul>					</p>					<p>A zone is an unordered sequence of links and defines any group of links that can be treated in association with each other. Some zones may be permanent and represent, for example, all those links that make up an electoral ward in the zone. Other zones may be transitory and represent, for example, a collection of links that may be affected by a accident. Each zone is uniquely identified and has an associated description, type (e.g. permanent, transitory etc.) and has a validity period as well as the  links that determine its coverage.</p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_network-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_object-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_data_source-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<ul>						<li>Derived from the UTMC specification and SIRI standards.<ul>								<li>ts004.003annexdapr07.xls</li>								<li>ts004-004a-annexd-sep08.pdf</li>							</ul>						</li>					</ul>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing Network Objects</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:element name="AbstractNetworkObject" type="AbstractNetworkObjectStructure" abstract="true" substitutionGroup="AbstractSupportObject">		<xsd:annotation>			<xsd:documentation>Abstract Network Object.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:complexType name="AbstractNetworkObjectStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Network Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractSupportObjectStructure">				<xsd:sequence>					<xsd:group ref="AbstractNetworkObjectGroup"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="AbstractNetworkObjectGroup">		<xsd:annotation>			<xsd:documentation>Elements found on Network Objects.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CreationDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Time created</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time deleted, ie date at which element became historic.  In UTMC spec DeletionData</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:element name="NetworkElementTypeRef" type="TypeIdType" abstract="true" substitutionGroup="DataObjectTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a type of Network Element.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ====Node============================================================= -->	<xsd:element name="NetworkNodeRef" type="NetworkNodeIdType" substitutionGroup="NetworkObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a Network Node Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="NetworkNodeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Network Node. Unique for nodes within system.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkNode" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Node  defines a point of connection between two or more network link objects. It is purely defined by a unique identifier (amongst nodes) and a reference to the geometry that represents its geographical location.  The validity period for the node is represented by a creation and deletion date. </xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkNodeStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkNodeIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkNodeIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkNodeGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkNodeStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for Network Node.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkNodeGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkNodeGroup">		<xsd:annotation>			<xsd:documentation>Elements specific to Network Node.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:group ref="NetworkGeometryUseGroup" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ====Link======================================================== -->	<xsd:element name="NetworkLink" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Link represents a one way connection between two network nodes. It is defined by a unique identifier (amongst links), the references to its source and destination node and a reference to the geometry that represents it geographical extent. The link length is also provided for convenience, though this can be derived from the geometry. The validity period for the link is represented by a creation and deletion date.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkLinkStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkLinkIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkLinkIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkLinkGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkLinkStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for Network Link</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkLinkGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkLinkGroup">		<xsd:annotation>			<xsd:documentation>Network Link elements</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="FromNodeRef" type="NetworkNodeIdType">				<xsd:annotation>					<xsd:documentation>From Node of Link.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ToNodeRef" type="NetworkNodeIdType">				<xsd:annotation>					<xsd:documentation>To Node of Link</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="NetworkGeometryUseGroup" minOccurs="0"/>			<xsd:element ref="FeatureRef" minOccurs="0"/>			<xsd:element name="paths" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Paths Associated with link. Derived from  NetworkPathList entries associated with Path. </xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkPathRef"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="zones" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Zones in which  link resides. Derived from Network Zone entries associated with Zone.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkZoneRef" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>			<xsd:element name="turns" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Turnsfrom or to linkin   Derived from Network Turn definitions associated with Link.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkTurnRef" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===ZONE============================================================== -->	<xsd:element name="NetworkZone" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Zone  is an unordered sequence of links and defines any group of links that can be treated in association with each other. Some zones may be permanent and represent, for example, all those links that make up an electoral ward in the zone. Other zones may be transitory and represent, for example, a collection of links that may be affected by a accident.Each zone is uniquely identified and has an associated description, type (e.g. permanent, transitory etc.) and has a validity period as well as the  links that determine its coverage.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkZoneStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkZoneIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkZoneIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkZoneGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkZoneStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for Network Zone</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkZoneGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkZoneGroup">		<xsd:annotation>			<xsd:documentation>Network Zone  elements</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ZoneDescription" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of Zone.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Permanent" type="xsd:boolean" default="true" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether zone is permanent. Default is true.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ObjectTypeRef" type="NetworkZoneTypeIdType">				<xsd:annotation>					<xsd:documentation>Reference to a  Network Zone Type Definition.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="NetworkGeometryUseGroup" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Network Geometry associated with an network element.</xsd:documentation>				</xsd:annotation>			</xsd:group>			<xsd:element name="links" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Zone Links associated with zone. Each List enyt specifies a links.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkZoneListEntry" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Network Zone List Entry.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- === Zone Type=========================================================== -->	<xsd:element name="NetworkZoneTypeRef" type="NetworkZoneTypeIdType" substitutionGroup="NetworkElementTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a  Network Zone.  Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="NetworkZoneTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Network Zone Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkZoneTypeDefinition" substitutionGroup="DataObjectTypeDefinition">		<xsd:annotation>			<xsd:documentation>Network Zone Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="NetworkZoneTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="NetworkZoneListEntry" abstract="false" substitutionGroup="AbstractListEntry">		<xsd:annotation>			<xsd:documentation>Network Zone List.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkZoneListEntryStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkZoneIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Reference to Data Object. Unique within Participant system and type. Onlyneeds to be specified if not given by Context</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="AbstractListEntryGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkZoneListEntryGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkZoneListEntryStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Network Zone List.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractListEntryStructure">				<xsd:sequence>					<xsd:group ref="NetworkZoneListEntryGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkZoneListEntryGroup">		<xsd:annotation>			<xsd:documentation>Network Zone list elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="NetworkLinkRef" maxOccurs="unbounded"/>		</xsd:sequence>	</xsd:group>	<!-- ====Path============================================================== -->	<xsd:element name="NetworkPath" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Path is an ordered collection of links. It is used in association with Transport Route Object to support instances such as Journey Time and Bus Service. Each network route is uniquely identified and has an ordered list of network links that determine its direction and extent.  The Network Path may be trimmed at both start an end for those paths which do not start or end at a node.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkPathStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkPathIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkPathIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkPathGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkPathStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for a Network Path .</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkPathGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkPathGroup">		<xsd:annotation>			<xsd:documentation>Network Path elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ObjectTypeRef" type="NetworkPathTypeIdType">				<xsd:annotation>					<xsd:documentation>Reference to a Network Path type.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Permanent" type="xsd:boolean" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether route is permanent.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="InitialTrim" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Distance in metres from the start node that the path actually starts.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FinalTrim" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Distance in metres from the endnode that the path actually ends.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="links" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Ordered list of links that make up path</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkPathListEntry" maxOccurs="unbounded">							<xsd:annotation>								<xsd:documentation>Network Path List Entry. A Link in an ordered sequence ofg links..</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="NetworkPathTypeRef" type="NetworkPathTypeIdType" substitutionGroup="NetworkElementTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a  network Path Type Definition.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="NetworkPathTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Network Path  Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkPathTypeDefinition" substitutionGroup="DataObjectTypeDefinition">		<xsd:annotation>			<xsd:documentation>Network Path Type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="NetworkPathTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="NetworkPathListEntry" abstract="false" substitutionGroup="AbstractListEntry">		<xsd:annotation>			<xsd:documentation>Network Path List.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkPathListEntryStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkPathIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Reference to Data Object. Unique within Participant system and type. Onlyneeds to be specified if not given by Context</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="AbstractListEntryGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkPathListEntryGroup">								<xsd:annotation>									<xsd:documentation>Network Path List Entry elements.</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkPathListEntryStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Network Geometry List Entry.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractListEntryStructure">				<xsd:sequence>					<xsd:group ref="NetworkPathListEntryGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkPathListEntryGroup">		<xsd:annotation>			<xsd:documentation>Network Geometry List Entry elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="OrderId" type="xsd:integer">				<xsd:annotation>					<xsd:documentation>Order of Link within Path.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="NetworkLinkRef"/>		</xsd:sequence>	</xsd:group>	<!-- ====Turn ============================================================ -->	<xsd:element name="NetworkTurnRef" type="NetworkTurnIdType" substitutionGroup="NetworkObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a Network Turn. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="NetworkTurnIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of a Network Turn.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkTurn" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Turn represents an allowed or disallowed movement between any two links via a node.  This is modelled by a unique identifier for the turn, a reference to the “from link” and a reference to the “to link” for the movement.  A flag attribute is used to indicate if this turn is allowed or disallowed. The validity period for the turn is represented by a creation and deletion date.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkTurnStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkTurnIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkTurnIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkTurnGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkTurnStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for Network Turn.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkTurnGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkTurnGroup">		<xsd:annotation>			<xsd:documentation>Network Turn elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="TurnDescription" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of Turn</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Allowed" type="xsd:boolean">				<xsd:annotation>					<xsd:documentation>Whether turn is allowed .</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="FromLinkRef" type="NetworkLinkIdType">				<xsd:annotation>					<xsd:documentation>Turn from link.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ToLinkRef" type="NetworkLinkIdType">				<xsd:annotation>					<xsd:documentation>Turn to link.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="NetworkGeometryUseGroup" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Network Geometry associated with an network element.</xsd:documentation>				</xsd:annotation>			</xsd:group>		</xsd:sequence>	</xsd:group>	<!-- === Geometry =========================================================== -->	<xsd:group name="NetworkGeometryUseGroup">		<xsd:annotation>			<xsd:documentation>Network Geometry elements</xsd:documentation>		</xsd:annotation>		<xsd:choice>			<xsd:element ref="NetworkGeometryRef"/>			<xsd:element ref="NetworkGeometry"/>		</xsd:choice>	</xsd:group>	<xsd:element name="NetworkGeometryRef" type="NetworkLinkIdType" substitutionGroup="NetworkObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a network Geometry. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="NetworkGeometryIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of an Network Geometry.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="NetworkGeometry" abstract="false" substitutionGroup="AbstractNetworkObject">		<xsd:annotation>			<xsd:documentation>A Network Geometry  is used to represent any geospatial context for a link or node. It consists of an ordered list of co-ordinate points. </xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkGeometryStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkGeometryIdType">								<xsd:annotation>									<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:element ref="OriginatingParticipantRef" minOccurs="0"/>							<xsd:element name="OriginatingObjectRef" type="NetworkGeometryIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="AbstractNetworkObjectGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkGeometryGroup">								<xsd:annotation>									<xsd:documentation>Network Geometry elements</xsd:documentation>								</xsd:annotation>							</xsd:group>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkGeometryStructure" abstract="false">		<xsd:annotation>			<xsd:documentation>Type for Network Geometry.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractNetworkObjectStructure">				<xsd:sequence>					<xsd:group ref="NetworkGeometryGroup">						<xsd:annotation>							<xsd:documentation>Network Geometry elements</xsd:documentation>						</xsd:annotation>					</xsd:group>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkGeometryGroup">		<xsd:annotation>			<xsd:documentation>Network Geometry.elements</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CoordinateCount" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Number of coordinates in list</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="geometryList">				<xsd:annotation>					<xsd:documentation>Ordered lists of Geometry Points</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="NetworkGeometryListEntry" maxOccurs="unbounded"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="NetworkGeometryListEntry" abstract="false" substitutionGroup="AbstractListEntry">		<xsd:annotation>			<xsd:documentation>Network Geometry List Entry. Can be used to associate one ore more points or features with an element.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="NetworkGeometryListEntryStructure">					<xsd:sequence>						<xsd:sequence>							<xsd:element ref="ParticipantRef" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifiers should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>								</xsd:annotation>							</xsd:element>						</xsd:sequence>						<xsd:sequence>							<xsd:element name="SystemCodeNumber" type="NetworkGeometryIdType" minOccurs="0">								<xsd:annotation>									<xsd:documentation>Reference to Data Object. Unique within Participant system and type. Onlyneeds to be specified if not given by Context</xsd:documentation>								</xsd:annotation>							</xsd:element>							<xsd:group ref="AbstractListEntryGroup"/>						</xsd:sequence>						<xsd:sequence>							<xsd:group ref="NetworkGeometryListEntryGroup"/>							<xsd:element ref="Extensions" minOccurs="0"/>						</xsd:sequence>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:complexType name="NetworkGeometryListEntryStructure" abstract="false">		<xsd:annotation>			<xsd:documentation xml:lang="en">Type for Network Geometry List Entry.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractListEntryStructure">				<xsd:sequence>					<xsd:group ref="NetworkGeometryListEntryGroup"/>					<xsd:element ref="Extensions" minOccurs="0"/>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="NetworkGeometryListEntryGroup">		<xsd:annotation>			<xsd:documentation>Network Geometry List Entry elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="OrderId" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Order of element within Geometry</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Point" type="PointStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Point in geometry.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="FeatureRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<!-- ====Static===================================================== -->	<xsd:element name="NetworkStatic" substitutionGroup="AbstractStatic">		<xsd:annotation>			<xsd:documentation>Network element Static Object</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:extension base="AbstractSystemObjectStructure">					<xsd:sequence>						<xsd:group ref="NetworkStaticGroup"/>					</xsd:sequence>				</xsd:extension>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<xsd:group name="NetworkStaticGroup">		<xsd:annotation>			<xsd:documentation>Static Elements specific to Network Objects.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="types" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Object Types.</xsd:documentation>				</xsd:annotation>				<xsd:complexType>					<xsd:sequence>						<xsd:element ref="DataSourceTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>						<xsd:group ref="NetworkTypeDefinitionsGroup"/>					</xsd:sequence>				</xsd:complexType>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="NetworkTypeDefinitionsGroup">		<xsd:annotation>			<xsd:documentation>Type definition Elements specific to Network Objects.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element ref="NetworkPathTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>			<xsd:element ref="NetworkZoneTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= --></xsd:schema>