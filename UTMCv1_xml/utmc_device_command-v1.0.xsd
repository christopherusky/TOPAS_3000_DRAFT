<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2005 rel. 3 U (http://www.altova.com) by Nick Knowles (Kizoom) --><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_device_command">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_data_source-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the  common properties of  commands associated with UTMC  Device Data  Objects,                    <ul>							<li>Device Object Commands</li>							<ul>								<li>Access Control Commands</li>								<li>Air Quality Commands</li>								<li>Car Park Commands</li>								<li>Cctv Commands</li>								<li>Detector Commands</li>								<li>Meteorological Commands</li>								<li>Traffic Signal Commands</li>								<li>Transport Route Commands</li>								<li>Transport Link Commands</li>								<li>Variable Message Sign Commands</li>							</ul>						</ul>					</p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_command-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation> 					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_data_source-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<ul>						<li>Derived from the UTMC specification and SIRI standards.<ul>								<li>ts004.003annexdapr07.xls</li>								<li>ts004-004a-annexd-sep08.pdf</li>							</ul>						</li>					</ul>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema describing common elements of Device Commands.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ====Command============================================================== -->	<xsd:simpleType name="CommandIdType">		<xsd:annotation>			<xsd:documentation>Type for  Identifier of an Command. Unique within Object Type.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:integer"/>	</xsd:simpleType>	<xsd:element name="CommandRef" type="CommandIdType">		<xsd:annotation>			<xsd:documentation>Reference to a Command, Unique within System and type</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="AbstractDeviceCommand" type="AbstractDeviceCommandStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Device Command.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDeviceCommandStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Device Command</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="DeviceCommandRequestGroup"/>			<xsd:group ref="DeviceCommandResponseGroup"/>			<xsd:element ref="Extensions" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:simpleType name="CommandResponseType">		<xsd:annotation>			<xsd:documentation>Enumeration of Commnad Response Types.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="xsd:string">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Command Invalid"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Command Invalid"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Command Invalid"/>			<xsd:enumeration value="4"/>			<xsd:enumeration value="Command Timed out"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:group name="DeviceCommandRequestGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Command Requests.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="RequestTime" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date/time at which request was made.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="CommandId" type="CommandIdType">				<xsd:annotation>					<xsd:documentation>Unique identifier for the command object.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Command" type="xsd:string">				<xsd:annotation>					<xsd:documentation>Actual command sent to equipment.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="CommandFormatTypeRef" minOccurs="0"/>			<xsd:element name="Parameters" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Delimited list of parameters to be sent with the command.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Priority" type="xsd:integer" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Level of priority associated with the request.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>		</xsd:sequence>	</xsd:group>	<xsd:group name="DeviceCommandResponseGroup">		<xsd:annotation>			<xsd:documentation>Elements Specific to Device Command Responses.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="AcknowledgementTime" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time at which the request was acknowledged.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ResponseTime" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time at which equipment responded.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ResponseResult" type="CommandResponseType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Indicates if the request was executed or denied. 1   = Command Invalid,2   = Command Valid,3   = Command Implemented,4   = Command Timed out.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ResponseComment" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Textual description of Reason for Failure.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Type=============================================================== -->	<xsd:element name="CommandFormatTypeRef" type="CommandFormatTypeIdType" substitutionGroup="OtherObjectTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Command format, Unique within System and type.  1 = Discrete command information,2 = Combined command information.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="CommandFormatTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Device  Command Format types. CommandFormat values are as follows: 1   = Discrete command information,2   = Combined command information.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="CommandFormatTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Enumeration of Device  Command Format allowed values.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Discrete command information"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Combined command information"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="CommandFormatTypeDefinition" substitutionGroup="OtherTypeDefinition">		<xsd:annotation>			<xsd:documentation>Command Format Type Definition. 1 = Discrete command information,2 = Combined command information.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="CommandFormatTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Access Control State type.  </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element></xsd:schema>