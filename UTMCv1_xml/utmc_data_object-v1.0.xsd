<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:D2="http://datex2.eu/schema/1_0/1_0" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_object-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_support_quality-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   common abstract properties of UTMC Data Object components. These may include a                     <ol>							<li>Definition, describing the fixed properties of an object and its location on the network</li>							<ul>								<li>Access Control Definition</li>								<li>Air Quality Definition</li>								<li>Car Park Definition</li>								<li>Cctv Definition</li>								<li>Detector Definition</li>								<li>Meteorological Definition</li>								<li>Traffic Signal Definition</li>								<li>Transport Route Definition</li>								<li>Transport Link Definition</li>								<li>Variable Message Sign Definition</li>							</ul>							<li>Configuration  Objects, describing configurable properties of objects, with a time of last change</li>							<ul>								<li>Access Control Configuration</li>								<li>Air Quality Configuration</li>								<li>Car Park Configuration</li>								<li>Cctv Configuration</li>								<li>Detector Configuration</li>								<li>Meteorological Configuration</li>								<li>Traffic Signal Configuration</li>								<li>Transport Route Configuration</li>								<li>Transport Link Configuration</li>								<li>Variable Message Sign Configuration</li>							</ul>							<li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change</li>							<ul>								<li>Access Control Dynamic</li>								<li>Air Quality Dynamic</li>								<li>Car Park Dynamic</li>								<li>Cctv Dynamic</li>								<li>Detector Dynamic</li>								<li>Meteorological Dynamic</li>								<li>Traffic Signal Dynamic</li>								<li>Transport Route Dynamic</li>								<li>Transport Link Dynamic</li>								<li>Variable Message Sign Dynamic</li>							</ul>						</ol>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_object-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_quality-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing common abstract components of UTMC Device Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:element name="AbstractDefinition" type="AbstractDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Object Definition  common to all Data Object types.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDefinitionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Utmc Object.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="ObjectTypeRef" type="TypeIdType">				<xsd:annotation>					<xsd:documentation>Type of Data Object.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="QualityRef" type="QualityIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Quality statement of Data Object.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="BaseDefinitionGroup"/>			<xsd:group ref="DefinitionDescriptionGroup">				<xsd:annotation>					<xsd:documentation>UTMC Object textual description elements.</xsd:documentation>				</xsd:annotation>			</xsd:group>			<xsd:group ref="PointOnPathGroup" minOccurs="0"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="BaseDefinitionGroup">		<xsd:annotation>			<xsd:documentation>Base Definition  elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CreationDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date and time  at which object was created  in originating participant UTMC system.  For systems that store historic definition values, and for traffic elements, this forms part of the unique identifier of the element. The most recent is deemed to be the current version, unless marked as deleted by a deletion date.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which object was last updated. Freefkow Extension</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and time  at which object was flagged as deleted  in UTMC. (Previosuly called Deletion date)  Definition record became historic. If blank element is current. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:element name="Reality" type="D2:InformationStatusEnum" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether situation is real or a test. Freeflow extnsion using Datex2 enum.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="DefinitionDescriptionGroup">		<xsd:annotation>			<xsd:documentation>Object textual description elements.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ShortDescription" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Short Description of the object.</xsd:documentation>				</xsd:annotation>				<xsd:simpleType>					<xsd:restriction base="xsd:string">						<xsd:maxLength value="32"/>						<xsd:minLength value="1"/>					</xsd:restriction>				</xsd:simpleType>			</xsd:element>			<xsd:element name="LongDescription" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Long description of object.</xsd:documentation>				</xsd:annotation>				<xsd:simpleType>					<xsd:restriction base="xsd:string">						<xsd:maxLength value="2000"/>						<xsd:minLength value="1"/>					</xsd:restriction>				</xsd:simpleType>			</xsd:element>			<xsd:group ref="GraphicPresentationGroup"/>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="AbstractConfiguration" type="AbstractConfigurationStructure">		<xsd:annotation>			<xsd:documentation>Abstract configuration object</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractConfigurationStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Data Object Configuration.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractConfigurationGroup"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="AbstractConfigurationGroup">		<xsd:annotation>			<xsd:documentation>Elements for abstract Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="ConfigurationDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date of last change of configuration.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time that Configuration record became historic. If blank element is current. Freeflow Extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Reality" type="D2:InformationStatusEnum" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether situation is real or a test. Freeflow extension using Datex2 enumerated values.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<xsd:element name="AbstractDynamic" type="AbstractDynamicStructure">		<xsd:annotation>			<xsd:documentation>Abstract Dynamic.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractDynamicStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Data Object dynamic properties.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ObjectIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="AbstractDynamicGroup"/>		</xsd:sequence>	</xsd:complexType>	<xsd:group name="AbstractDynamicGroup">		<xsd:annotation>			<xsd:documentation>Elements for abstract Dynamic.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="LastUpdated" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date and time of last change to data.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time that data record became historic. If blank element is current. Freeflow Extension.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="GraphicPresentationGroup"/>			<xsd:element name="Reality" type="D2:InformationStatusEnum" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Whether data is real or a test. Freeflow extension using Datex2 enum.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= --></xsd:schema>