<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:siri="http://www.siri.org.uk/siri" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_data_object_air_quality">    <!-- ===Dependencies ======================================= -->    <xsd:include schemaLocation="utmc_device-v1.0.xsd"/>    <!-- ===eGIF/GovTalk Documentation ======================================= -->    <xsd:annotation>        <xsd:appinfo>            <Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">                <Aggregation>main schema</Aggregation>                <Audience>e-service developers</Audience>                <Contributor>Freeflow Project and UTMC XML working Group. </Contributor>                <Contributor>UTMC and UML: Ian Cornwell, Ian.Cornwell at mottmac.com;</Contributor>                <Contributor>UTMC and UML: Tim Wright,  Tim.Wright  at ipl.com; </Contributor>                <Contributor>UtmcXml Nicholas Knowles, KIZOOM LTD., London EC4A 1LT</Contributor>                <Contributor>UTMC: mark.cartwright at centaurconsulting.co.uk;  </Contributor>                <Contributor>UTMC: mark.bodger at siemens.com; </Contributor>                <Contributor>UTMC: alison.h.jones at siemens.com; </Contributor>                <Contributor>UTMC: josef.kaltwasser at heuboe.de; </Contributor>                <Contributor>UTMC: brendan mason, tenet </Contributor>                <Contributor>UTMC: mandi patel at streetmanagement.org.uk; </Contributor>                <Contributor>UTMC:Matthew Shephard at tenettechnology.com</Contributor>                <Contributor>UTMC: ian.skeoch at peek-traffic.co.uk; </Contributor>                <Contributor>UTMC: martin.siczkowski at acis-cam.uk.com; </Contributor>                <Contributor>UTMC: richard thurbin, richard at cloudamber.com; </Contributor>                <Contributor>UTMC: ivan.wells at highways.gsi.gov.uk; </Contributor>                <Contributor>Freeflow: dan fitzgerald at Kizoom.com  </Contributor>                <Contributor>Freeflow: andy grove at whitewillow.biz</Contributor>                <Contributor>Freeflow: rajesh K; krishnamoorthy,   at imperial.ac.uk</Contributor>                <Contributor>Freeflow: rob shepherd at acis.com</Contributor>                <Contributor>Freeflow: ian routledge at acis.com</Contributor>                <Contributor>TO be COMPLETED  </Contributor>                <Coverage>United Kingdom</Coverage>                <Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>                <Date>                    <Created>2009-04-01</Created>                    <!-- Documentation headers added -->                </Date>                <Description>                    <p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   UTMC Air Quality device Data Object and its components. These may include:                    <ol>                            <li>Definition, describing the fixed properties of an object and its location on the network.</li>                            <ul>                                <li>Air Quality Definition</li>                            </ul>                            <li>Configuration  Objects, describing configurable properties of objects, with a time of last change.</li>                            <ul>                                <li>Air Quality Configuration</li>                            </ul>                            <li>Dynamic  Objects, describing volatile properties of Data Objects, with a time of last change.</li>                            <ul>                                <li>Air Quality Dynamic</li>                            </ul>                            <li>Device History, describing the device history which may be issued to the device.</li>                            <ul>                                <li>Air Quality Device History</li>                            </ul>                            <li>Fault, describing the device  faults,</li>                            <ul>                                <li>Air Quality Fault</li>                            </ul>                            <li>Command, describing the commands which may be issued to the device.</li>                            <ul>                                <li>Air Quality Command</li>                            </ul>                            <li>Types, describing the allowed values for types associated with Air Quality data object.</li>                            <ul>                                <li>Air Quality Quality Type Definition</li>                                <li>Air Quality Fault Type Definition</li>                            </ul>                        </ol>                    </p>                    <p>The </p>                </Description>                <Format>                    <MediaType>text/xml</MediaType>                    <Syntax>http://www.w3.org/2001/XMLSchema</Syntax>                    <Description>XML schema, W3C Recommendation 2001</Description>                </Format>                <Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_data_object_air_quality-v1.0.xsd</Identifier>                <Language>[ISO 639-2/B] ENG</Language>                <Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>                <Relation>                    <Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_device-v1.0.xsd</Requires>                </Relation>                <Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>                </Rights>                <Source>                    <p>Derived from the UTMC specification and SIRI standards.                            <ul>                            <li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>                            <li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>                        </ul>                    </p>                </Source>                <Status>Version 1.0 Draft for approval</Status>                <Subject>                    <Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>                    <Project>Freeflow UtmcXml Interface</Project>                </Subject>                <Title>UTMC XML schema.   Subschema  describing the UTMC Air Quality Device Object.</Title>                <Type>Standard</Type>            </Metadata>        </xsd:appinfo>    </xsd:annotation>    <!-- ===Object ID=============================================================== -->    <xsd:simpleType name="AirQualityIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Air Quality.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="ObjectIdType"/>    </xsd:simpleType>    <xsd:element name="AirQualityRef" type="AirQualityIdType" substitutionGroup="DeviceRef">        <xsd:annotation>            <xsd:documentation>Reference to an Air Quality. Unique within Participant system and type.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:complexType name="AirQualityFullRefStructure">        <xsd:annotation>            <xsd:documentation>Type for full reference to an Air Quality. </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="ObjectFullRefStructure">                <xsd:sequence>                    <xsd:element ref="AirQualityRef"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <!-- ===Data Object=========================================================== -->    <xsd:element name="AirQuality" substitutionGroup="AbstractDeviceObject">        <xsd:annotation>            <xsd:documentation>Air Quality Data Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AirQualityStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:sequence>                                <xsd:element ref="ParticipantRef" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Participant identifier should be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                            <xsd:sequence>                                <xsd:element name="SystemCodeNumber" type="AirQualityIdType">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                                <xsd:element name="OriginatingObjectRef" type="AirQualityIdType" minOccurs="0">                                    <xsd:annotation>                                        <xsd:documentation>Identifier of object on originating system. Unique within originating  system and object type.</xsd:documentation>                                    </xsd:annotation>                                </xsd:element>                            </xsd:sequence>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AirQualityGroup"/>                            <xsd:group ref="AirQualityDeviceGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AirQualityStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Air Quality Object.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceStructure">                <xsd:sequence>                    <xsd:group ref="AirQualityGroup"/>                    <xsd:group ref="AirQualityDeviceGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AirQualityGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="definitions" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Air Quality defiinition. Normally there will be only one, but there may be more if historic values are included.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityDefinition" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="configurations" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Air Quality configurations.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityConfiguration" maxOccurs="unbounded"/>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="dynamics" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Air Quality dynamic values.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityDynamic" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Object  Dynamic . </xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Definition=========================================================== -->    <xsd:element name="AirQualityDefinition" substitutionGroup="AbstractDeviceDefinition">        <xsd:annotation>            <xsd:documentation>Air Quality Data Object Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AirQualityDefinitionStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="ObjectTypeRef" type="AirQualityTypeIdType">                                <xsd:annotation>                                    <xsd:documentation>Type of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:element name="QualityRef" type="AirQualityQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Quality statement of Data Object.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="BaseDefinitionGroup"/>                            <xsd:group ref="DefinitionDescriptionGroup">                                <xsd:annotation>                                    <xsd:documentation>UTMC Object textual description elements.</xsd:documentation>                                </xsd:annotation>                            </xsd:group>                            <xsd:group ref="PointOnPathGroup" minOccurs="0"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="OffsetObjectGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AirQualityDefinitionGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AirQualityDefinitionStructure">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for Air Quality Definition.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDeviceDefinitionStructure">                <xsd:sequence>                    <xsd:group ref="AirQualityDefinitionGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AirQualityDefinitionGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality  Definition.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="BasicData">                <xsd:annotation>                    <xsd:documentation>Air Quality Basic Data.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element name="MeasurementUnits" type="xsd:string" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Description of units of measurement</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Configuration===================================================== -->    <xsd:element name="AirQualityConfiguration" abstract="false" substitutionGroup="AbstractConfiguration">        <xsd:annotation>            <xsd:documentation>Air Quality Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AirQualityConfigurationStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractConfigurationGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AirQualityConfigurationGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AirQualityConfigurationStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for  Air Quality Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractConfigurationStructure">                <xsd:sequence>                    <xsd:group ref="AirQualityConfigurationGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AirQualityConfigurationGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality  Configuration.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="Thresholds">                <xsd:annotation>                    <xsd:documentation>Threshold values for concentrations.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="AirQualityMonitorGroup">                            <xsd:annotation>                                <xsd:documentation>Gases monitoerd by Air Quality object. Units of concentration are specified on definition.</xsd:documentation>                            </xsd:annotation>                        </xsd:group>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Object Dynamic============================================================ -->    <xsd:element name="AirQualityDynamic" abstract="false" substitutionGroup="AbstractDynamic">        <xsd:annotation>            <xsd:documentation>Air Quality Object  Dynamic  </xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AirQualityDynamicStructure">                    <xsd:sequence>                        <xsd:sequence>                            <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                                <xsd:annotation>                                    <xsd:documentation>Identifier of parent Data Object. Only needed if not given by context.</xsd:documentation>                                </xsd:annotation>                            </xsd:element>                            <xsd:group ref="AbstractDynamicGroup"/>                        </xsd:sequence>                        <xsd:sequence>                            <xsd:group ref="AirQualityDynamicGroup"/>                            <xsd:element ref="Extensions" minOccurs="0"/>                        </xsd:sequence>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:complexType name="AirQualityDynamicStructure" abstract="false">        <xsd:annotation>            <xsd:documentation xml:lang="en">Type for   Air Quality   Dynamic.  </xsd:documentation>        </xsd:annotation>        <xsd:complexContent>            <xsd:extension base="AbstractDynamicStructure">                <xsd:sequence>                    <xsd:group ref="AirQualityDynamicGroup"/>                    <xsd:element ref="Extensions" minOccurs="0"/>                </xsd:sequence>            </xsd:extension>        </xsd:complexContent>    </xsd:complexType>    <xsd:group name="AirQualityDynamicGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality Dynamic.  </xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="Period" type="xsd:duration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Period in minutes over which the data has been collected.</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:group ref="AirQualityMonitorGroup"/>            <xsd:element name="QualityRef" type="AirQualityQualityIdType" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality reference for dynamic data.</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="AirQualityMonitorGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality Dynamic.. Units of concentration are specified on definition.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="CO" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NO" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NOX" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="NO2" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="OZONE" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="PAH" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="SO2" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="PM10" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ug/m3)</xsd:documentation>                </xsd:annotation>            </xsd:element>            <xsd:element name="BTX" type="Concentration" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>concentration (e.g. ppb).</xsd:documentation>                </xsd:annotation>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Device===================================================== -->    <xsd:group name="AirQualityDeviceGroup">        <xsd:annotation>            <xsd:documentation>Air Quality Device related elements.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="history" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device History</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityHistory" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Device History</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faults" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityFault" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Fault</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="commands" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device commands</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityCommand" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Command</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <!-- ===Fault===================================================== -->    <xsd:element name="AirQualityFault" substitutionGroup="AbstractDeviceFault">        <xsd:annotation>            <xsd:documentation>Air Quality Fault.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceFaultStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="FaultTypeRef" type="AirQualityFaultTypeIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Type of fault.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceFaultGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Command========================================================== -->    <xsd:element name="AirQualityCommand" substitutionGroup="AbstractDeviceCommand">        <xsd:annotation>            <xsd:documentation>Air Quality Command.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceCommandStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Unique  within System and type. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="DeviceCommandRequestGroup"/>                        <xsd:group ref="DeviceCommandResponseGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Device History===================================================== -->    <xsd:simpleType name="AirQualityLogIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Air Quality Device History.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="LogIdType"/>    </xsd:simpleType>    <xsd:element name="AirQualityHistory" substitutionGroup="AbstractDeviceHistory">        <xsd:annotation>            <xsd:documentation>Air Quality Device History.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:restriction base="AbstractDeviceHistoryStructure">                    <xsd:sequence>                        <xsd:element name="SystemCodeNumber" type="AirQualityIdType" minOccurs="0">                            <xsd:annotation>                                <xsd:documentation>Identifier of Data Object. Only needs to be specified if not given by context.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:element name="LogId" type="AirQualityLogIdType">                            <xsd:annotation>                                <xsd:documentation>Identifier of Log entry. Unique within Type.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                        <xsd:group ref="AbstractDeviceHistoryGroup"/>                        <xsd:element ref="Extensions" minOccurs="0"/>                    </xsd:sequence>                </xsd:restriction>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <!-- ====Static===================================================== -->    <xsd:element name="AirQualityStatic" substitutionGroup="AbstractStatic">        <xsd:annotation>            <xsd:documentation>Air Quality Data Object Static Data.</xsd:documentation>        </xsd:annotation>        <xsd:complexType>            <xsd:complexContent>                <xsd:extension base="AbstractSystemObjectStructure">                    <xsd:sequence>                        <xsd:group ref="AirQualityStaticGroup"/>                    </xsd:sequence>                </xsd:extension>            </xsd:complexContent>        </xsd:complexType>    </xsd:element>    <xsd:group name="AirQualityStaticGroup">        <xsd:annotation>            <xsd:documentation>Elements specific to Air Quality  Static Values.</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element name="types" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Types of Air Quality</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:group ref="DeviceTypeDefinitionsGroup"/>                        <xsd:group ref="AirQualityTypeDefinitionsGroup">                            <xsd:annotation>                                <xsd:documentation>Type definition Elements specific to Air Quality.</xsd:documentation>                            </xsd:annotation>                        </xsd:group>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="qualityStatements" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Quality Statements. </xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityQuality" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Quality Statements</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>            <xsd:element name="faultTypes" minOccurs="0">                <xsd:annotation>                    <xsd:documentation>Device Faults.</xsd:documentation>                </xsd:annotation>                <xsd:complexType>                    <xsd:sequence>                        <xsd:element ref="AirQualityFaultTypeDefinition" maxOccurs="unbounded">                            <xsd:annotation>                                <xsd:documentation>Air Quality Fault Type Definition.</xsd:documentation>                            </xsd:annotation>                        </xsd:element>                    </xsd:sequence>                </xsd:complexType>            </xsd:element>        </xsd:sequence>    </xsd:group>    <xsd:group name="AirQualityTypeDefinitionsGroup">        <xsd:annotation>            <xsd:documentation>Type definition Elements specific to Access Control .</xsd:documentation>        </xsd:annotation>        <xsd:sequence>            <xsd:element ref="AirQualityTypeDefinition" minOccurs="0" maxOccurs="unbounded"/>        </xsd:sequence>    </xsd:group>    <!-- ===Object Type=========================================================== -->    <xsd:element name="AirQualityTypeRef" type="AirQualityTypeIdType" substitutionGroup="DeviceTypeRef">        <xsd:annotation>            <xsd:documentation>Identifier of Air Quality type. 1 = AQ Reference Monitor,2 = AQ Indicative Monitor,3 = AQ\Met Reference Monitor,4 = AQ/MET Indicative Monitor.999 = Other.</xsd:documentation>        </xsd:annotation>    </xsd:element>    <xsd:simpleType name="AirQualityTypeIdType">        <xsd:annotation>            <xsd:documentation>Type for Identifier of Air Quality  Type Definition.</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdType"/>    </xsd:simpleType>    <xsd:simpleType name="AirQualityTypeIdEnum">        <xsd:annotation>            <xsd:documentation>Enumeration of allowed Air Quality  Types</xsd:documentation>        </xsd:annotation>        <xsd:restriction base="TypeIdEnum">            <xsd:enumeration value="1"/>            <xsd:enumeration value="AQ Reference Monitor"/>            <xsd:enumeration value="2"/>            <xsd:enumeration value="AQ Indicative Monitor"/>            <xsd:enumeration value="3"/>            <xsd:enumeration value="AQ/Met Reference Monitor"/>            <xsd:enumeration value="4"/>            <xsd:enumeration value="AQ/Met Indicative Monitor"/>            <xsd:enumeration value="999"/>     