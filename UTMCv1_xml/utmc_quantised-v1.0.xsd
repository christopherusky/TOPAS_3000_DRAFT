<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_quantised">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_object-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_support_day_type-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_utility_time-v1.0.xsd"/>	<xsd:include schemaLocation="utmc_support_quality-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the   common abstract properties of UTMC  Prediction and Profile  Objects. They are extended by specific concrete   objects, including the following                     <ol>							<li>Prediction Objects</li>							<ul>								<li>Access Control Prediction</li>								<li>Air Quality Prediction</li>								<li>Car Park Prediction</li>								<li>Cctv Prediction</li>								<li>Detector Prediction</li>								<li>Traffic Signal Prediction</li>								<li>Transport Route Prediction</li>								<li>Transport Link Prediction</li>							</ul>							<li>Profile Objects</li>							<ul>								<li>Access Control Profile</li>								<li>Air Quality Profile</li>								<li>Car Park Profile</li>								<li>Cctv Profile</li>								<li>Detector Profile</li>								<li>Traffic Signal Profile</li>								<li>Transport Route Profile</li>								<li>Transport Link Profile</li>							</ul>						</ol>					</p>					<p>Each Prediction object assesses a one or more Prediction data values that will be in effect at a specific date and time band.</p>					<p>Each Profile  object summarizes data values as one or more Profile  data values that summarize  a specific date and time band. </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_quantised-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_object-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_day_type-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_data_source-v1.0.xsd</Requires>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_utility-time-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specification: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema  describing common abstract properties of UTMC  Prediction Objects.</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ===Common Elements =============================================================== -->	<xsd:element name="QuantisedObjectRef" type="ObjectIdType" abstract="true" substitutionGroup="ObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a prediction or profile. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractQuantisedStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract prediction or profile object</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:extension base="AbstractDataObjectStructure">				<xsd:sequence>					<xsd:element name="QualityRef" type="QualityIdType">						<xsd:annotation>							<xsd:documentation>Quality of Data Object of  Predicition.</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:element name="StatusTypeRef" type="TypeIdType">						<xsd:annotation>							<xsd:documentation>Status of Prediction</xsd:documentation>						</xsd:annotation>					</xsd:element>					<xsd:group ref="QuantisedScopeGroup">						<xsd:annotation>							<xsd:documentation>Elements for a Prediction or profile .</xsd:documentation>						</xsd:annotation>					</xsd:group>				</xsd:sequence>			</xsd:extension>		</xsd:complexContent>	</xsd:complexType>	<xsd:group name="QuantisedScopeGroup">		<xsd:annotation>			<xsd:documentation>Elements for a Prediction or profile .</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="CreationDate" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date created.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="LastUpdated" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date data was last updated</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="HistoricDate" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date deleted.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Description" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Description of the prediction or profile.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="DayTypeScopeGroup">				<xsd:annotation>					<xsd:documentation>Time scope of prediction.</xsd:documentation>				</xsd:annotation>			</xsd:group>			<xsd:element ref="DataSourceTypeRef" minOccurs="0"/>			<xsd:element name="AlgorithmType" type="xsd:string" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Method used to calculate predictions or profiles.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<xsd:group name="QuantisedDataGroup">		<xsd:annotation>			<xsd:documentation>Elements for  abstract Prediction and Profile data</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="StartTime" type="xsd:dateTime">				<xsd:annotation>					<xsd:documentation>Date and time data was created.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="EndTime" type="xsd:dateTime" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Date and or time data ceases to be valid.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ======================================================================= -->	<!-- ======================================================================= -->	<xsd:complexType name="DayTypeStructure">		<xsd:annotation>			<xsd:documentation>Type for a UTMC Day Type.</xsd:documentation>		</xsd:annotation>		<xsd:group ref="DayTypeScopeGroup"/>	</xsd:complexType>	<xsd:group name="DayTypeScopeGroup">		<xsd:annotation>			<xsd:documentation>Elements for Day Type scope.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="DayTypeRef" type="DayTypeIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Day type  to which data applies, for example Monday to Friday, Bank Holidays, etc.</xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:element name="Valid" type="ClosedTimestampRangeStructure" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Time band within which object applies.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:group>	<!-- ===Prediction=============================================================== -->	<xsd:simpleType name="PredictionIdType">		<xsd:annotation>			<xsd:documentation>Unique Identifier of a  Prediction.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="PredictionRef" type="PredictionIdType" substitutionGroup="QuantisedObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a prediction. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:element name="AbstractPrediction" type="AbstractPredictionStructure" abstract="true" substitutionGroup="AbstractDataObject">		<xsd:annotation>			<xsd:documentation>Abstract Prediction.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractPredictionStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Prediction Object. Restricted</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:restriction base="AbstractQuantisedStructure">				<xsd:sequence>					<xsd:sequence>						<xsd:element ref="ParticipantRef" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Partcipant identifers shoudl be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="PredictionIdType">							<xsd:annotation>								<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="OriginatingObjectRef" type="PredictionIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifer of object on originating system. Unique within originating  system and object type.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>					<xsd:sequence>						<xsd:element name="QualityRef" type="PredictionQualityIdType">							<xsd:annotation>								<xsd:documentation>Quality of of  Predicition.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="StatusTypeRef" type="PredictionStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Status of Prediction.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="QuantisedScopeGroup">							<xsd:annotation>								<xsd:documentation>Elements for a Prediction or profile.</xsd:documentation>							</xsd:annotation>						</xsd:group>					</xsd:sequence>				</xsd:sequence>			</xsd:restriction>		</xsd:complexContent>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="AbstractPredictionData" type="AbstractPredictionDataStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Prediction.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractPredictionDataStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Prediction data.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="PredictionIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Unique Identifier of a Prediction. Normally given by context; only needs to be present in standalone use. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="QuantisedDataGroup"/>			<xsd:element name="DataObjectRef" type="ObjectIdType">				<xsd:annotation>					<xsd:documentation>Reference to a Data Object</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:complexType>	<!-- ====Prediction Status =============================================== -->	<xsd:element name="PredictionStatusTypeRef" type="PredictionStatusTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Prediction Status Type Definition.1  =  Valid  (using current value and profile), 2  =  Profile ( no current value available using profile value),    3  =  Unknown  ( no current or profile value available). </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="PredictionStatusTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Prediction Status Type definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="PredictionStatusTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Enumeration of allowed Prediction statuses.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="1"/>			<xsd:enumeration value="Valid"/>			<xsd:enumeration value="2"/>			<xsd:enumeration value="Profile"/>			<xsd:enumeration value="3"/>			<xsd:enumeration value="Unknown"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="PredictionStatusTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Prediction Status Type Definition. 1  =  Valid  (using current value and profile), 2  =  Profile ( no current value available using profile value),3  =  Unknown  ( no current or profile value available). </xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="PredictionStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= -->	<!-- ==Profile============================================================ -->	<xsd:simpleType name="ProfileIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier for Profile.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="ObjectIdType"/>	</xsd:simpleType>	<xsd:element name="ProfileRef" type="ProfileIdType" substitutionGroup="QuantisedObjectRef">		<xsd:annotation>			<xsd:documentation>Reference to a Profile. Unique within Participant system and type.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<!-- ======================================================================= -->	<xsd:element name="AbstractProfile" type="AbstractProfileStructure" abstract="true" substitutionGroup="AbstractDataObject">		<xsd:annotation>			<xsd:documentation>Abstract Profile.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractProfileStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract Profile Object.</xsd:documentation>		</xsd:annotation>		<xsd:complexContent>			<xsd:restriction base="AbstractQuantisedStructure">				<xsd:sequence>					<xsd:sequence>						<xsd:element ref="ParticipantRef" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Unique Identifier of a system providing data. If absent, given by context.  Partcipant identifers shoudl be chosen to be unique across all systems so that together with SystemCodeNumber there is   a unique reference to each UTMC data object.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>					<xsd:sequence>						<xsd:element name="SystemCodeNumber" type="ProfileIdType">							<xsd:annotation>								<xsd:documentation>Identifier of data object, unique within system and type.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="OriginatingParticipantRef" type="ParticipantIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Reference to the unique Identifier of  system from which object originated.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="OriginatingObjectRef" type="ProfileIdType" minOccurs="0">							<xsd:annotation>								<xsd:documentation>Identifer of object on originating system. Unique within originating  system and object type.</xsd:documentation>							</xsd:annotation>						</xsd:element>					</xsd:sequence>					<xsd:sequence>						<xsd:element name="QualityRef" type="ProfileQualityIdType">							<xsd:annotation>								<xsd:documentation>Quality of Profile.</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:element name="StatusTypeRef" type="ProfileStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Status of Prediction</xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="QuantisedScopeGroup">							<xsd:annotation>								<xsd:documentation>Elements for a Prediction or profile .</xsd:documentation>							</xsd:annotation>						</xsd:group>					</xsd:sequence>				</xsd:sequence>			</xsd:restriction>		</xsd:complexContent>	</xsd:complexType>	<!-- ====Profile Status==================================================== -->	<xsd:element name="AbstractProfileData" type="AbstractProfileDataStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Abstract Profile Data.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:complexType name="AbstractProfileDataStructure" abstract="true">		<xsd:annotation>			<xsd:documentation>Type for abstract  Profile data.</xsd:documentation>		</xsd:annotation>		<xsd:sequence>			<xsd:element name="SystemCodeNumber" type="ProfileIdType" minOccurs="0">				<xsd:annotation>					<xsd:documentation>Unique Identifier of a Profile. Normally given by context. only needs to be present in standalone use. </xsd:documentation>				</xsd:annotation>			</xsd:element>			<xsd:group ref="QuantisedDataGroup">				<xsd:annotation>					<xsd:documentation>Elements for Prediction and Profile data.</xsd:documentation>				</xsd:annotation>			</xsd:group>			<xsd:element name="DataObjectRef" type="ObjectIdType">				<xsd:annotation>					<xsd:documentation>Reference to a Data Object.</xsd:documentation>				</xsd:annotation>			</xsd:element>		</xsd:sequence>	</xsd:complexType>	<!-- ======================================================================= -->	<xsd:element name="ProfileStatusTypeRef" type="ProfileStatusTypeIdType" substitutionGroup="DataValueTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a Profile Status Type Definition.1  =  Valid  (using current value and profile), 2  =  Profile ( no current value available using profile value),    3  =  Unknown  ( no current or profile value available). </xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="ProfileStatusTypeIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of  Profile status Type  Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:simpleType name="ProfileStatusTypeIdEnum">		<xsd:annotation>			<xsd:documentation>Enumeration of allowed Profile statuses.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdEnum">			<xsd:enumeration value="0"/>			<xsd:enumeration value="Normal"/>			<xsd:enumeration value="1"/>			<xsd:enumeration value="Suspect"/>		</xsd:restriction>	</xsd:simpleType>	<xsd:element name="ProfileStatusTypeDefinition" substitutionGroup="ValueTypeDefinition">		<xsd:annotation>			<xsd:documentation>Profile Status  Type  Definition.1  =  Valid  (using current value and profile), 2  =  Profile ( no current value available using profile value),    3  =  Unknown  ( no current or profile value available).</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="ProfileStatusTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Object Type definition. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Quality==================================================== -->	<xsd:simpleType name="PredictionQualityIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Prediction Quality. </xsd:documentation>		</xsd:annotation>		<xsd:restriction base="QualityIdType"/>	</xsd:simpleType>	<xsd:element name="PredictionQuality" substitutionGroup="AbstractQuality">		<xsd:annotation>			<xsd:documentation>Prediction Quality Statement.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractQualityStructure">					<xsd:sequence>						<xsd:element name="QualityId" type="PredictionQualityIdType">							<xsd:annotation>								<xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractQualityGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ===Quality==================================================== -->	<xsd:simpleType name="ProfileQualityIdType">		<xsd:annotation>			<xsd:documentation>Type for Identifier of Prediction Quality. </xsd:documentation>		</xsd:annotation>		<xsd:restriction base="QualityIdType"/>	</xsd:simpleType>	<xsd:element name="ProfileQuality" substitutionGroup="AbstractQuality">		<xsd:annotation>			<xsd:documentation>Prediction Quality Statement.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="AbstractQualityStructure">					<xsd:sequence>						<xsd:element name="QualityId" type="ProfileQualityIdType">							<xsd:annotation>								<xsd:documentation>identifier of quality Statement. Unique within object type and system. </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="AbstractQualityGroup"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= --></xsd:schema>