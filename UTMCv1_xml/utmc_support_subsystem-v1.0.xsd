<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2005 rel. 3 U (http://www.altova.com) by Nick Knowles (Kizoom) --><xsd:schema xmlns="http://localhost/services/utmc/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://localhost/services/utmc/v1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" id="utmc_support_subsystem">	<!-- ===Dependencies ======================================= -->	<xsd:include schemaLocation="utmc_support_typeID-v1.0.xsd"/>	<!-- ===eGIF/GovTalk Documentation ======================================= -->	<xsd:annotation>		<xsd:appinfo>			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">				<Aggregation>main schema</Aggregation>				<Audience>e-service developers</Audience>				<Contributor>Freeflow Project. UTMC XML working Group. See main package headers </Contributor>				<Coverage>United Kingdom</Coverage>				<Creator>Drafted for version 1.0   FREEFLOW. Nick Knowles Kizoom mailto:schemer@/www.utmc.uk.com/</Creator>				<Date>					<Created>2009-04-01</Created>					<!-- Documentation headers added -->				</Date>				<Description>					<p>UtmcXml is an XML representation of the Urban Traffic Management Control model that can be used to exchange data objects between UTMC databases and other services.</p>.                     <p>This subschema describes the Abstract UTMC Subsystem  Type Definition Type ( UTMC "TypeID") used to specify allowed values of UTMCSubsystem values                                        The SubSystem_TypeID uniquely defines each of the subsytems can supply information to the system. A subsystem belongs to aDataSource.  Each DataSource can have zero , one or many subsystems that it supports.                     <ul>							<li>MOTTS   1000 - 1099</li>							<li>PEEK    1100 - 1199</li>							<li>TENET   1200 - 1299</li>							<li>THALES  1300 - 1399</li>							<li>SIEMENS 1400 - 1499</li>							<li>SERCO   1500 - 1599</li>							<li>SIEMENS 14000 - 14999</li>						</ul>					</p>					<p>The </p>				</Description>				<Format>					<MediaType>text/xml</MediaType>					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>					<Description>XML schema, W3C Recommendation 2001</Description>				</Format>				<Identifier>{http://www.utmc.uk.com/schemas/1.0/utmc/}utmc_utility-v1.0.xsd</Identifier>				<Language>[ISO 639-2/B] ENG</Language>				<Publisher>Kizoom, 109-123 Clifton Street, London EC4A 4LD </Publisher>				<Relation>					<Requires>http://www.utmc.uk.com/schemas/1.0/utmc/utmc_support_typeID-v1.0.xsd</Requires>				</Relation>				<Rights>Unclassified                            <Copyright>Freeflow, UTMC  2009</Copyright>				</Rights>				<Source>					<p>Derived from the UTMC specification and SIRI standards.                            <ul>							<li>UTMC Data Object specification: ts004.003annexdapr07.xls</li>							<li>UTMC UML specifcation: ts004-004a-annexd-sep08.pdf  - </li>						</ul>					</p>				</Source>				<Status>Version 1.0 Draft for approval</Status>				<Subject>					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,Public transport, Bus services, Coach services, Bus stops and stations,Business and industry, Transport, Roads and road transport</Category>					<Project>Freeflow UtmcXml Interface</Project>				</Subject>				<Title>UTMC XML schema.   Subschema of Subsystem Type Definition   used to specify allowed values of subsystem definitions</Title>				<Type>Standard</Type>			</Metadata>		</xsd:appinfo>	</xsd:annotation>	<!-- ======================================================================= -->	<xsd:element name="SubSystemTypeRef" type="SubSystemTypeIdType" substitutionGroup="OtherObjectTypeRef">		<xsd:annotation>			<xsd:documentation>Reference to a SubSystem Type. Unique within System and type. MOTTS = 1000 - 1099,PEEK = 1100 - 1199,TENET = 1200 - 1299,THALES  = 1300 - 1399,SIEMENS = 1400 - 1499,SERCO   = 1500 - 1599,SIEMENS = 14000 - 14999.</xsd:documentation>		</xsd:annotation>	</xsd:element>	<xsd:simpleType name="SubSystemTypeIdType">		<xsd:annotation>			<xsd:documentation>Identifier of Sub System type Definition.</xsd:documentation>		</xsd:annotation>		<xsd:restriction base="TypeIdType"/>	</xsd:simpleType>	<xsd:element name="SubSystemTypeDefinition" substitutionGroup="OtherTypeDefinition">		<xsd:annotation>			<xsd:documentation>SubSystem Type Definition. Can be used to partition Data Source into one or more subsystems. MOTTS = 1000 - 1099,PEEK = 1100 - 1199,TENET = 1200 - 1299,THALES  = 1300 - 1399,SIEMENS = 1400 - 1499,SERCO   = 1500 - 1599,SIEMENS = 14000 - 14999.</xsd:documentation>		</xsd:annotation>		<xsd:complexType>			<xsd:complexContent>				<xsd:restriction base="TypeDefinitionStructure">					<xsd:sequence>						<xsd:element name="TypeId" type="SubSystemTypeIdType">							<xsd:annotation>								<xsd:documentation>Identifier for Access Control State type.  </xsd:documentation>							</xsd:annotation>						</xsd:element>						<xsd:group ref="TypeDefinitionGroup"/>						<xsd:element ref="Extensions" minOccurs="0"/>					</xsd:sequence>				</xsd:restriction>			</xsd:complexContent>		</xsd:complexType>	</xsd:element>	<!-- ======================================================================= --></xsd:schema>